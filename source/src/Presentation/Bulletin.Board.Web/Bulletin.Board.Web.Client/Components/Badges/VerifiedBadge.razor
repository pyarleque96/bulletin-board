@*
    VerifiedBadge — Badge de proveedor verificado.
    Verde esmeralda — manage/index.html .tier-verified:
      background:#d1fae5; color:#065f46; border:1px solid #6ee7b7.
    Check SVG: path "M22 11.08V12a10 10 0 1 1-5.93-9.14" + polyline "22 4 12 14.01 9 11.01"

    Parámetros:
      IconOnly (bool, default false) — muestra solo el icono sin texto, padding circular.
*@

@inject IStringLocalizer<SharedResource> _localizer

<span class="@WrapperClass" aria-label="@_localizer["Badge_Verified"]" role="img">
    @* Check-circle SVG canónico de home-8.html (trust banner + "GM Approved" overlay) *@
    <svg class="@IconClass"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2.5"
         stroke-linecap="round"
         stroke-linejoin="round"
         aria-hidden="true">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
    </svg>
    @if (!IconOnly)
    {
        <span>@_localizer["Badge_Verified"]</span>
    }
</span>

@code {
    /// <summary>
    /// Cuando es true, muestra solo el icono (padding circular, sin texto).
    /// </summary>
    [Parameter] public bool IconOnly { get; set; } = false;

    private string WrapperClass => IconOnly
        ? "verified-badge verified-badge--icon-only inline-flex items-center justify-center"
        : "verified-badge inline-flex items-center gap-1";

    private string IconClass => IconOnly ? "w-3.5 h-3.5" : "w-2.5 h-2.5";
}
