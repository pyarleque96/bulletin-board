@* ────────────────────────────────────────────────────────────────────────────
   ManageDetailHeader — Banda sticky de header + tabs para las vistas de detalle
   de /manage/{listingId}. Matriz canónica (validada por designer):

   | Tab           | car-rental | housing | beauty | mechanic | transport | jobs |
   |---------------|:----------:|:-------:|:------:|:--------:|:---------:|:----:|
   | Overview      |     X      |    X    |   X    |    X     |     X     |   X  |
   | Vehicles      |     X      |    -    |   -    |    -     |     -     |   -  |
   | Properties    |     -      |    X    |   -    |    -     |     -     |   -  |
   | Services      |     -      |    -    |   X    |    X     |     -     |   -  |
   | Routes        |     -      |    -    |   -    |    -     |     X     |   -  |
   | Reservations  |     X      |    X    |   -    |    -     |     X     |   -  |
   | Appointments  |     -      |    -    |   X    |    -     |     -     |   -  |
   | Applications  |     -      |    -    |   -    |    -     |     -     |   X  |
   | Inquiries     |     -      |    X    |   X    |    X     |     X     |   -  |
   | Photos        |     X      |    X    |   X    |   opt    |    opt    |   -  |
   | Reviews       |     X      |    X    |   X    |    X     |     X     |   -  |
   | Analytics     |    VIP     |   VIP   |  VIP   |   VIP    |    VIP    |  VIP |
   | Settings      |     X      |    X    |   X    |    X     |     X     |   X  |

   - Slugs duales: `mechanic`/`mechanics`, `transport`/`transportation` se
     normalizan al mismo bloque interno.
   - Analytics solo si TierBadge == "VIP".
   ──────────────────────────────────────────────────────────────────────────── *@

@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> _localizer

<style>
    .manage-tablist-wrap { position: relative; }
    .tab-indicator {
        position: absolute; bottom: 0; height: 3px;
        border-radius: 3px 3px 0 0;
        background: linear-gradient(90deg, #f97316, #fb923c);
        box-shadow: 0 -1px 8px -1px rgba(249,115,22,0.35);
        transition: left 0.38s cubic-bezier(0.32,0.72,0,1),
                    width 0.38s cubic-bezier(0.32,0.72,0,1),
                    opacity 0.2s ease;
        pointer-events: none;
        will-change: left, width;
    }
    .tab-indicator::after {
        content: ''; position: absolute; inset: -1px; border-radius: inherit;
        background: inherit; opacity: 0.25; filter: blur(4px);
    }
    .manage-tab { position:relative; transition:color 0.18s cubic-bezier(0.32,0.72,0,1); caret-color:transparent; }
    .manage-tab[aria-selected="true"] { color:#0f172a; font-weight:600; }
    .manage-tab:hover { color:#0f172a; }

    .tier-regular { background:#f1f5f9; color:#475569; border:1px solid #cbd5e1; }

    [data-tooltip] { position:relative; }
    [data-tooltip]::after {
        content:attr(data-tooltip); position:absolute; bottom:calc(100% + 8px);
        left:50%; transform:translateX(-50%); white-space:nowrap;
        background:#1e293b; color:#fff; font-size:11px; padding:5px 9px;
        border-radius:8px; pointer-events:none; opacity:0;
        transition:opacity 0.15s ease; z-index:50;
    }
    [data-tooltip]:hover::after { opacity:1; }
</style>

<div class="bg-white border-b border-slate-100 px-4 pt-24 pb-0 sticky top-0 z-30">
    <div class="max-w-6xl mx-auto px-4">

        @* Breadcrumb *@
        <nav class="flex items-center gap-1.5 text-xs text-muted mb-3" aria-label="Breadcrumb">
            <a href="/manage" class="hover:text-ink transition-colors duration-150 cursor-pointer">@_localizer["Nav_Manage"]</a>
            <svg class="w-3 h-3 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            <span class="text-ink font-medium truncate max-w-[180px]" aria-current="page">@ListingTitle</span>
        </nav>

        @* Título del listing + meta + acciones *@
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-4">
            <div class="flex items-start gap-3 min-w-0">

                @* Icono según tipo de categoría *@
                <div class="w-10 h-10 rounded-xl bg-violet-100 flex items-center justify-center flex-shrink-0 mt-0.5" aria-hidden="true">
                    @if (NormalizedSlug == "car-rental")
                    {
                        <svg class="w-5 h-5 text-violet-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v9a2 2 0 0 1-2 2h-3"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
                    }
                    else if (NormalizedSlug == "housing")
                    {
                        <svg class="w-5 h-5 text-violet-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    }
                    else if (NormalizedSlug == "jobs")
                    {
                        <svg class="w-5 h-5 text-violet-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                    }
                    else
                    {
                        <svg class="w-5 h-5 text-violet-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                    }
                </div>

                <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                        <h1 class="text-lg font-bold text-ink leading-tight">@ListingTitle</h1>

                        <CategoryBadge Slug="@NormalizedSlug" />

                        @if (Status == "Approved")
                        {
                            <ApprovedBadge />
                        }
                        else if (Status == "Pending")
                        {
                            <PendingBadge />
                        }
                        else if (Status == "Rejected")
                        {
                            <RejectedBadge />
                        }
                        else if (Status == "NeedsChanges")
                        {
                            <NeedsChangesBadge />
                        }

                        @if (TierBadge == "VIP")
                        {
                            <VipBadge />
                        }
                    </div>
                    <p class="text-xs text-muted mt-0.5">
                        @CategoryLabel
                        @if (!string.IsNullOrEmpty(Since))
                        {
                            <span class="text-slate-300 mx-1">·</span>
                            @Since
                        }
                    </p>
                </div>
            </div>

            @* Header CTAs *@
            <div class="flex items-center gap-2 flex-shrink-0 flex-wrap">
                @if (Status == "Approved")
                {
                    <ManageLinkButton Href="@PublicUrl"
                                      Variant="Default"
                                      Size="Small"
                                      target="_blank"
                                      rel="noopener"
                                      aria-label="View public listing / Ver anuncio público">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                        Public view
                    </ManageLinkButton>
                }
                <ManageLinkButton Href="@($"/manage/{ListingId}/edit")"
                                  Variant="Primary"
                                  Size="Small"
                                  data-tooltip="@_localizer["Banner_EditingReturnsPending"]"
                                  aria-label="Edit listing info / Editar información del anuncio">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    Edit listing
                </ManageLinkButton>
            </div>
        </div>

        @* ── TABS — dependen de NormalizedSlug + TierBadge ── *@
        <div class="manage-tablist-wrap border-b border-slate-100 -mb-px">
            <div class="flex items-center gap-0 overflow-x-auto"
                 role="tablist"
                 id="manage-tablist"
                 aria-label="Listing management sections">

                @* Overview — siempre *@
                @{ var tabs = BuildTabs(); }
                @foreach (var t in tabs)
                {
                    <a href="@t.Href"
                       role="tab"
                       aria-selected="@(ActiveTab == t.Key ? "true" : "false")"
                       aria-controls="@($"panel-{t.Key}")"
                       id="@($"tab-{t.Key}")"
                       class="manage-tab flex-shrink-0 flex items-center gap-1.5 px-4 py-2.5 text-sm @(ActiveTab == t.Key ? "text-ink" : "text-muted") cursor-pointer no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-1 rounded-t-lg">
                        @t.Icon
                        @t.Label
                        @if (t.Badge is not null)
                        {
                            @t.Badge
                        }
                    </a>
                }

            </div>
            @* Water-drop indicator — posicionado por JS *@
            <div id="tab-indicator" class="tab-indicator" aria-hidden="true"></div>
        </div>
    </div>
</div>

@* Script: posiciona el pill indicator en el tab activo *@
<script>
    (function () {
        var tablist = document.getElementById('manage-tablist');
        var indicator = document.getElementById('tab-indicator');
        if (!tablist || !indicator) return;

        function positionIndicator(tab, animate) {
            if (!animate) indicator.style.transition = 'none';
            var lr = tablist.getBoundingClientRect();
            var tr = tab.getBoundingClientRect();
            indicator.style.left = (tr.left - lr.left + tablist.scrollLeft) + 'px';
            indicator.style.width = tr.width + 'px';
            if (!animate) requestAnimationFrame(function () { indicator.style.transition = ''; });
        }

        var active = tablist.querySelector('[aria-selected="true"]');
        if (active) positionIndicator(active, false);

        tablist.querySelectorAll('.manage-tab').forEach(function (tab) {
            tab.addEventListener('mouseenter', function () { positionIndicator(tab, true); });
            tab.addEventListener('mouseleave', function () {
                var sel = tablist.querySelector('[aria-selected="true"]');
                if (sel) positionIndicator(sel, true);
            });
        });
    })();
</script>

@code {
    [Parameter, EditorRequired] public string ListingId    { get; set; } = "";
    [Parameter, EditorRequired] public string ListingTitle { get; set; } = "";
    [Parameter, EditorRequired] public string CategorySlug { get; set; } = "car-rental";
    [Parameter, EditorRequired] public string ActiveTab    { get; set; } = "overview";
    [Parameter]                 public string Status       { get; set; } = "Approved";
    [Parameter]                 public string TierBadge    { get; set; } = "";
    [Parameter]                 public string CategoryLabel { get; set; } = "";
    [Parameter]                 public string Since         { get; set; } = "";
    [Parameter]                 public string PublicUrl     { get; set; } = "#";

    // Counters opcionales (badges en tabs)
    [Parameter] public int? VehicleCount         { get; set; }
    [Parameter] public int? PropertyCount        { get; set; }
    [Parameter] public int? ServiceCount         { get; set; }
    [Parameter] public int? RouteCount           { get; set; }
    [Parameter] public int? PendingReservations  { get; set; }
    [Parameter] public int? PendingAppointments  { get; set; }
    [Parameter] public int? PendingApplications  { get; set; }
    [Parameter] public int? UnreadInquiries      { get; set; }
    [Parameter] public int? PhotoCount           { get; set; }
    [Parameter] public int? PendingReviews       { get; set; }

    /// <summary>
    /// Mostrar Photos como tab opcional para mechanic/transport. Default false.
    /// </summary>
    [Parameter] public bool ShowPhotosOptional   { get; set; }

    private string NormalizedSlug => NormalizeSlug(CategorySlug);

    private static string NormalizeSlug(string slug) => slug switch
    {
        "mechanics"      => "mechanic",
        "transportation" => "transport",
        _ => slug,
    };

    private record TabDef(string Key, string Href, RenderFragment Label, RenderFragment Icon, RenderFragment? Badge);

    private List<TabDef> BuildTabs()
    {
        var slug = NormalizedSlug;
        var list = new List<TabDef>
        {
            new("overview", $"/manage/{ListingId}",
                @<text>@_localizer["Manage_Tab_Overview"]</text>,
                @<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>,
                null)
        };

        // Inventario por categoría
        if (slug == "car-rental")
            list.Add(new("vehicles", $"/manage/{ListingId}/vehicles",
                @<text>@_localizer["Manage_Tab_Vehicles"]</text>,
                @<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v9a2 2 0 0 1-2 2h-3"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>,
                CountBadge(VehicleCount)));

        if (slug == "housing")
            list.Add(new("properties", $"/manage/{ListingId}/properties",
                @<text>@_localizer["Manage_Tab_Properties"]</text>,
                @<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>,
                CountBadge(PropertyCount)));

        if (slug == "beauty" || slug == "mechanic")
            list.Add(new("services", $"/manage/{ListingId}/services",
                @<text>@_localizer["Manage_Tab_Services"]</text>,
                @<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>,
                CountBadge(ServiceCount)));

        if (slug == "transport")
            list.Add(new("routes", $"/manage/{ListingId}/routes",
                @<text>@_localizer["Manage_Tab_Routes"]</text>,
                @<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="19" r="3"/><circle cx="18" cy="5" r="3"/><path d="M9 19h6a3 3 0 0 0 3-3v-1M15 5H9a3 3 0 0 0-3 3v1"/></svg>,
                CountBadge(RouteCount)));

        // Transacciones por categoría
        if (slug == "car-rental" || slug == "housing" || slug == "transport")
            list.Add(new("reservations", $"/manage/{ListingId}/reservations",
                @<text>@_localizer["Manage_Tab_Reservations"]</text>,
                @<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>,
                AmberBadge(PendingReservations)));

        if (slug == "beauty")
            list.Add(new("appointments", $"/manage/{ListingId}/appointments",
                @<text>@_localizer["Manage_Tab_Appointments"]</text>,
                @<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>,
                AmberBadge(PendingAppointments)));

        if (slug == "jobs")
            list.Add(new("applications", $"/manage/{ListingId}/applications",
                @<text>@_localizer["Manage_Tab_Applications"]</text>,
                @<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>,
                AmberBadge(PendingApplications)));

        if (slug == "housing" || slug == "beauty" || slug == "mechanic" || slug == "transport")
            list.Add(new("inquiries", $"/manage/{ListingId}/inquiries",
                @<text>@_localizer["Manage_Tab_Inquiries"]</text>,
                @<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>,
                AmberBadge(UnreadInquiries)));

        // Photos: car-rental/housing/beauty siempre; mechanic/transport solo si flag opcional
        var photosVisible = slug == "car-rental" || slug == "housing" || slug == "beauty"
                            || ((slug == "mechanic" || slug == "transport") && ShowPhotosOptional);
        if (photosVisible)
            list.Add(new("photos", $"/manage/{ListingId}/photos",
                @<text>@_localizer["Manage_Tab_Photos"]</text>,
                @<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>,
                CountBadge(PhotoCount)));

        // Reviews: todos salvo jobs
        if (slug != "jobs")
            list.Add(new("reviews", $"/manage/{ListingId}/reviews",
                @<text>@_localizer["Manage_Tab_Reviews"]</text>,
                @<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>,
                AmberBadge(PendingReviews)));

        // Analytics: solo VIP, todas las categorías
        if (string.Equals(TierBadge, "VIP", StringComparison.OrdinalIgnoreCase))
            list.Add(new("analytics", $"/manage/{ListingId}/analytics",
                @<text>@_localizer["Manage_Tab_Analytics"]</text>,
                @<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>,
                null));

        // Settings — siempre
        list.Add(new("settings", $"/manage/{ListingId}/settings",
            @<text>@_localizer["Manage_Tab_Settings"]</text>,
            @<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>,
            null));

        return list;
    }

    private static RenderFragment? CountBadge(int? n) => n is null ? null :
        @<span class="ml-0.5 bg-slate-100 text-muted text-[10px] font-semibold px-1.5 py-0.5 rounded-full">@n</span>;

    private static RenderFragment? AmberBadge(int? n) =>
        (n is null || n <= 0) ? null :
        @<span class="ml-0.5 bg-amber-100 text-amber-800 text-[10px] font-semibold px-1.5 py-0.5 rounded-full" aria-label="@($"{n} pending")">@n</span>;
}
