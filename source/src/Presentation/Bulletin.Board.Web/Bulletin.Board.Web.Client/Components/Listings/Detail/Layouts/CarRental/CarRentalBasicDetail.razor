@* CarRentalBasicDetail — used for Verified / Regular tiers in the car-rental category.
   Per producto: NO vehicles section (eso es VIP), single image (no carousel), about + reviews. *@
@using Bulletin.Board.Web.Client.Models

<article class="max-w-6xl mx-auto px-4 pt-24 pb-16">

    <header class="mb-6">
        <div class="flex items-center gap-2 text-xs text-muted mb-2">
            <a href="/browse/car-rental" class="hover:text-ink transition-colors">Car Rental</a>
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="9 18 15 12 9 6" />
            </svg>
            <span class="text-ink font-medium truncate">@Listing.TitleEn</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-bold text-ink tracking-tight">@Listing.TitleEn</h1>
        @if (!string.IsNullOrWhiteSpace(Listing.Location))
        {
            <p class="text-muted text-sm mt-1 flex items-center gap-1.5">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="10" r="3" />
                </svg>
                @Listing.Location
            </p>
        }
        <div class="flex items-center gap-3 mt-3 text-sm">
            <span class="font-semibold text-ink">★ @Listing.Rating.ToString("0.0")</span>
            <a href="#reviews" class="text-muted hover:text-ink transition-colors">@Listing.ReviewCount reviews</a>
            <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 text-xs font-medium">@Listing.Tier</span>
        </div>
    </header>

    @* ── Single hero image (no carousel for non-VIP) ── *@
    <div class="rounded-3xl overflow-hidden h-72 md:h-96 mb-8 bg-slate-100">
        @if (Listing.Photos.Length > 0)
        {
            <img src="@Listing.Photos[0].Url" alt="@Listing.Photos[0].AltText"
                 class="w-full h-full object-cover" />
        }
        else
        {
            <div class="w-full h-full flex items-center justify-center text-muted text-sm">
                No image available
            </div>
        }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        @* Main column ─ About + Reviews *@
        <div class="lg:col-span-2 space-y-6">

            <section class="bg-white rounded-3xl border border-slate-100 shadow-soft p-6">
                <h2 class="text-base font-semibold text-ink mb-3">About this provider</h2>
                <p class="text-muted leading-relaxed text-sm whitespace-pre-line">@Listing.DescriptionEn</p>

                <div class="mt-5 pt-5 border-t border-slate-100 bg-amber-50 -mx-6 -mb-6 px-6 py-4 rounded-b-3xl flex items-start gap-3">
                    <svg class="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                        <line x1="12" y1="9" x2="12" y2="13" />
                        <line x1="12" y1="17" x2="12.01" y2="17" />
                    </svg>
                    <p class="text-xs text-amber-800 leading-relaxed">
                        <strong>Platform disclaimer:</strong> Bulletin Dells connects you with this provider but does
                        not guarantee, endorse, or provide any service. Always confirm terms directly with the provider before payment.
                    </p>
                </div>
            </section>

            <section id="reviews" class="bg-white rounded-3xl border border-slate-100 shadow-soft p-6">
                <div class="flex items-center justify-between mb-5 flex-wrap gap-3">
                    <h2 class="text-base font-semibold text-ink">Reviews (@Listing.ReviewCount)</h2>
                    <div class="text-right">
                        <p class="text-2xl font-bold text-ink leading-none">@Listing.Rating.ToString("0.0")</p>
                        <p class="text-[10px] text-muted mt-0.5">avg rating</p>
                    </div>
                </div>

                @if (Listing.Reviews.Length == 0)
                {
                    <p class="text-muted text-sm">No reviews yet.</p>
                }
                else
                {
                    <ul class="space-y-3">
                        @foreach (var r in Listing.Reviews)
                        {
                            <li class="border border-slate-100 rounded-2xl p-4">
                                <div class="flex items-center justify-between text-sm">
                                    <span class="font-semibold text-ink">@r.ReviewerName</span>
                                    <span class="text-amber-500 font-medium">★ @r.Rating.ToString("0.0")</span>
                                </div>
                                <p class="text-muted text-sm mt-2 leading-relaxed">@r.Text</p>
                                <p class="text-[11px] text-muted mt-2">@r.CreatedAt.ToString("MMM yyyy")</p>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        @* Sidebar ─ provider identity + similar *@
        <aside class="space-y-4">
            <div class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5">
                <div class="space-y-2 text-xs text-muted mb-4">
                    @if (Listing.PhoneVerified || Listing.IdVerified || Listing.SocialVerified)
                    {
                        <div class="text-sm font-semibold text-ink mb-2 flex items-center gap-2">
                            <svg class="w-4 h-4 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                            </svg>
                            Verified provider
                        </div>
                        @if (Listing.PhoneVerified) { <p>✓ Phone verified</p> }
                        @if (Listing.IdVerified)    { <p>✓ Government ID verified</p> }
                        @if (Listing.SocialVerified){ <p>✓ Social media verified</p> }
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Listing.WhatsAppNumber))
                {
                    <a href="@WaUrl()" target="_blank" rel="noopener noreferrer"
                       class="w-full flex items-center justify-center gap-2.5 bg-green-500 hover:bg-green-600 text-white font-semibold py-3 rounded-2xl text-sm transition-colors">
                        Contact via WhatsApp
                    </a>
                    <p class="text-center text-[10px] text-muted mt-2">
                        You'll see a quick disclaimer before connecting.
                    </p>
                }
            </div>

            @if (Listing.SimilarListings.Length > 0)
            {
                <div class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5">
                    <h3 class="text-sm font-semibold text-ink mb-4">Similar providers</h3>
                    <ul class="space-y-3">
                        @foreach (var s in Listing.SimilarListings)
                        {
                            <li>
                                <a href="/listing/detail/@s.Id" class="flex items-center gap-3 group">
                                    <div class="w-12 h-9 rounded-lg overflow-hidden flex-shrink-0 bg-slate-100">
                                        @if (!string.IsNullOrWhiteSpace(s.CoverPhotoUrl))
                                        {
                                            <img src="@s.CoverPhotoUrl" alt="" class="w-full h-full object-cover" />
                                        }
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-medium text-ink group-hover:text-brand-600 transition-colors truncate">@s.TitleEn</p>
                                        <p class="text-xs text-muted">★ @s.Rating.ToString("0.0") (@s.ReviewCount)</p>
                                    </div>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </aside>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public ListingDetailDto Listing { get; set; } = default!;

    private string WaUrl()
    {
        var msg = Uri.EscapeDataString($"Hi, I found your listing '{Listing.TitleEn}' on Bulletin Dells.");
        var phone = new string([..Listing.WhatsAppNumber.Where(char.IsDigit)]);
        return $"https://wa.me/{phone}?text={msg}";
    }
}
