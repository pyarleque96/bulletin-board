@* AdminActionMenu — botón con icono + caret que despliega un menú flotante con acciones.
   Las acciones se pasan como ChildContent (cada una invoca @onclick="HideMenu" si quiere cerrar). *@

<div class="relative inline-block text-left" @onclick:stopPropagation="true">
    <button type="button"
            class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md border border-slate-200 text-slate-600 hover:bg-slate-50 hover:border-slate-300 cursor-pointer transition-colors"
            aria-haspopup="true"
            aria-expanded="@_open"
            @onclick="ToggleMenu">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-2.4 2.6-2.6z"/>
        </svg>
        <svg class="w-2.5 h-2.5 transition-transform @(_open ? "rotate-180" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"/>
        </svg>
    </button>

    @if (_open)
    {
        <div class="fixed inset-0 z-30" @onclick="HideMenu" @onclick:stopPropagation="false"></div>
        <div class="absolute right-0 mt-1 w-52 z-40 bg-white border border-slate-200 rounded-lg shadow-lg py-1"
             role="menu">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _open;

    private void ToggleMenu() => _open = !_open;
    public void HideMenu() => _open = false;
}
