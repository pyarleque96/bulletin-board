@using Microsoft.AspNetCore.Components.Authorization
@using Bulletin.Board.Web.Client.Services
@using Bulletin.Board.Web.Client.Models
@using System.Security.Claims

@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider

<aside id="admin-sidebar" class="@(Collapsed ? "collapsed" : "") text-white flex flex-col" style="box-shadow: 0 8px 32px rgba(0,0,0,0.14);">

    <!-- Logo header -->
    <div class="logo-header flex items-center h-16 px-4 border-b border-white/10">
        <div class="sb-label flex items-center gap-2.5 flex-1 min-w-0">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 logo-icon-glow"
                 style="background:#F97316;">
                <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
                </svg>
            </div>
            <div class="min-w-0">
                <p class="text-sm font-semibold leading-tight text-white">Bulletin Dells</p>
                <p class="text-xs" style="color:#60a5fa;">Admin Panel</p>
            </div>
        </div>
        <button @onclick="HandleToggle"
                class="flex-shrink-0 w-7 h-7 flex items-center justify-center rounded-md cursor-pointer transition-colors"
                style="color:rgba(148,163,184,0.6);"
                aria-label="Toggle sidebar">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" /><path d="M9 3v18" />
            </svg>
        </button>
    </div>

    <!-- Nav -->
    <nav class="flex-1 py-4 px-3 space-y-0.5 overflow-y-auto overflow-x-hidden">

        <p class="sb-label text-[10px] uppercase tracking-widest px-3 py-2 font-semibold" style="color:#3b82f6;">Overview</p>

        <NavLink href="/admin"
                 Match="NavLinkMatch.All"
                 ActiveClass="active"
                 class="sb-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium cursor-pointer"
                 style="color:#93c5fd;">
            <span class="nav-icon flex-shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" />
                    <rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" />
                </svg>
            </span>
            <span class="sb-label">Dashboard</span>
        </NavLink>

        <p class="sb-label text-[10px] uppercase tracking-widest px-3 py-2 font-semibold mt-3" style="color:#3b82f6;">Moderation</p>

        <NavLink href="/admin/listings-queue"
                 Match="NavLinkMatch.Prefix"
                 ActiveClass="active"
                 class="sb-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium cursor-pointer"
                 style="color:#93c5fd;">
            <span class="nav-icon flex-shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
            </span>
            <span class="sb-label">Listings Queue</span>
            @if (StatsLoaded && (Stats?.PendingListings ?? 0) > 0)
            {
                <span class="sb-label ml-auto inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1 rounded-full bg-yellow-400 text-yellow-900 text-[10px] font-bold badge-pulse"
                      aria-label="@Stats!.PendingListings pending listings">
                    @Stats!.PendingListings
                </span>
            }
        </NavLink>

        <NavLink href="/admin/reviews-queue"
                 Match="NavLinkMatch.Prefix"
                 ActiveClass="active"
                 class="sb-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium cursor-pointer"
                 style="color:#93c5fd;">
            <span class="nav-icon flex-shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                </svg>
            </span>
            <span class="sb-label">Reviews Queue</span>
            @if (StatsLoaded && (Stats?.PendingReviews ?? 0) > 0)
            {
                <span class="sb-label ml-auto inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1 rounded-full bg-orange-400 text-orange-900 text-[10px] font-bold badge-pulse"
                      aria-label="@Stats!.PendingReviews pending reviews">
                    @Stats!.PendingReviews
                </span>
            }
        </NavLink>

        <p class="sb-label text-[10px] uppercase tracking-widest px-3 py-2 font-semibold mt-3" style="color:#3b82f6;">Management</p>

        <NavLink href="/admin/providers"
                 Match="NavLinkMatch.Prefix"
                 ActiveClass="active"
                 class="sb-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium cursor-pointer"
                 style="color:#93c5fd;">
            <span class="nav-icon flex-shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
            </span>
            <span class="sb-label">Providers</span>
        </NavLink>

        <NavLink href="/admin/listings"
                 Match="NavLinkMatch.All"
                 ActiveClass="active"
                 class="sb-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium cursor-pointer"
                 style="color:#93c5fd;">
            <span class="nav-icon flex-shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M3 12h18M3 18h18" />
                </svg>
            </span>
            <span class="sb-label">Listings</span>
        </NavLink>

        <NavLink href="/admin/categories"
                 Match="NavLinkMatch.Prefix"
                 ActiveClass="active"
                 class="sb-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium cursor-pointer"
                 style="color:#93c5fd;">
            <span class="nav-icon flex-shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-5 5a2 2 0 01-2.828 0l-7-7A2 2 0 013 9V4a1 1 0 011-1z" />
                </svg>
            </span>
            <span class="sb-label">Categories</span>
        </NavLink>
    </nav>

    <!-- Bottom user section -->
    <div class="px-4 py-4 border-t border-white/10">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-blue-700 flex items-center justify-center text-xs font-bold flex-shrink-0 text-white">@_initials</div>
            <div class="sb-label min-w-0 flex-1">
                <p class="text-sm font-medium truncate text-white">@(!string.IsNullOrEmpty(_displayName) ? _displayName : "General Manager")</p>
                <p class="text-xs truncate" style="color:#60a5fa;">@_userEmail</p>
            </div>
            <button type="button"
                    @onclick="HandleLogout"
                    class="sb-label transition-colors cursor-pointer"
                    style="color:rgba(148,163,184,0.6);"
                    aria-label="Sign out"
                    title="Sign out">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
            </button>
        </div>
    </div>
</aside>

@code {
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback<bool> CollapsedChanged { get; set; }
    [Parameter] public AdminStatsDto? Stats { get; set; }
    [Parameter] public bool StatsLoaded { get; set; }

    private string _userEmail   = string.Empty;
    private string _displayName = string.Empty;
    private string _initials    = "GM";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var email = user.FindFirst(ClaimTypes.Email)?.Value
                 ?? user.FindFirst("email")?.Value
                 ?? string.Empty;
        _userEmail = email;

        // Prefer the Name claim for the display label; fall back to email local-part.
        var fullName = user.FindFirst(ClaimTypes.Name)?.Value
                    ?? user.FindFirst("name")?.Value;

        if (!string.IsNullOrWhiteSpace(fullName))
        {
            _displayName = fullName.Trim();
            var parts = _displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            _initials = parts.Length >= 2
                ? $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}"
                : _displayName.Length >= 2
                    ? _displayName[..2].ToUpperInvariant()
                    : _displayName.ToUpperInvariant();
        }
        else if (!string.IsNullOrEmpty(email))
        {
            var localPart = email.Split('@')[0];
            _displayName = localPart;
            _initials = localPart.Length >= 2
                ? localPart[..2].ToUpperInvariant()
                : localPart.ToUpperInvariant();
        }
    }

    private async Task HandleToggle()
    {
        var newValue = !Collapsed;
        await CollapsedChanged.InvokeAsync(newValue);
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        ((BulletinAuthStateProvider)AuthStateProvider).NotifyUserLoggedOut();
        NavigationManager.NavigateTo("/login", forceLoad: false);
    }

}
