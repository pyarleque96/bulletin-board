@* VipStarToggle — checkbox cuadrado con shadow naranja.
   Al hacer click NO cambia estado local: emite OnToggleRequested
   con la nueva intención (true=grant, false=revoke) para que el padre
   abra el modal de confirmación con contraseña. *@

<button type="button"
        class="@ButtonClass"
        title="@Title"
        aria-label="@Title"
        aria-pressed="@IsVip.ToString().ToLower()"
        disabled="@Disabled"
        @onclick="HandleClick">
    @if (IsVip)
    {
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24"
             fill="none" stroke="currentColor"
             stroke-width="3" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
        </svg>
    }
</button>

@code {
    [Parameter] public bool IsVip { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<bool> OnToggleRequested { get; set; }

    private string Title => IsVip ? "Revoke VIP (requires password)" : "Grant VIP (requires password)";

    private string ButtonClass =>
        "inline-flex items-center justify-center w-6 h-6 rounded-md border-2 transition-all duration-150 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed " +
        (IsVip
            ? "border-orange-500 bg-orange-500 text-white shadow-[0_0_0_4px_rgba(249,115,22,0.25)] hover:shadow-[0_0_0_6px_rgba(249,115,22,0.35)]"
            : "border-slate-300 bg-white hover:border-orange-400 hover:shadow-[0_0_0_4px_rgba(249,115,22,0.15)]");

    private async Task HandleClick()
    {
        if (Disabled) return;
        await OnToggleRequested.InvokeAsync(!IsVip);
    }
}
