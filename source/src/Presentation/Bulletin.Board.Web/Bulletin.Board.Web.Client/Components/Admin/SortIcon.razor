@namespace Bulletin.Board.Web.Client.Components.Admin

@*
    SortIcon — renderiza el indicador de ordenación para columnas de tabla.
    Muestra flechas arriba/abajo resaltando la dirección activa.

    Parametros:
    - Column     : identificador de la columna (ej. "name-asc", "listings-desc")
    - CurrentSort: valor actual de _sortMode en el padre
*@

@if (_isActive)
{
    @if (_isAscending)
    {
        @* Flecha arriba — activa *@
        <svg class="w-3 h-3 text-blue-600" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
             stroke-linejoin="round" aria-hidden="true">
            <polyline points="18 15 12 9 6 15" />
        </svg>
    }
    else
    {
        @* Flecha abajo — activa *@
        <svg class="w-3 h-3 text-blue-600" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
             stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9" />
        </svg>
    }
}
else
{
    @* Ambas flechas — inactivo *@
    <svg class="w-3 h-3 opacity-40" fill="none" viewBox="0 0 24 24"
         stroke="currentColor" stroke-width="2" stroke-linecap="round"
         stroke-linejoin="round" aria-hidden="true">
        <path d="M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l4-4m-4 4l-4-4" />
    </svg>
}

@code {
    /// <summary>
    /// Base column identifier (e.g. "name-asc" for the name column).
    /// The component strips "-asc" / "-desc" suffixes before comparing.
    /// </summary>
    [Parameter, EditorRequired] public string Column { get; set; } = string.Empty;

    /// <summary>Current sort mode string from the parent (e.g. "name-desc").</summary>
    [Parameter, EditorRequired] public string CurrentSort { get; set; } = string.Empty;

    // Derive the base key by stripping any trailing -asc / -desc
    private string BaseKey =>
        Column.EndsWith("-asc",  StringComparison.Ordinal) ? Column[..^4] :
        Column.EndsWith("-desc", StringComparison.Ordinal) ? Column[..^5] :
        Column;

    private string CurrentBase =>
        CurrentSort.EndsWith("-asc",  StringComparison.Ordinal) ? CurrentSort[..^4] :
        CurrentSort.EndsWith("-desc", StringComparison.Ordinal) ? CurrentSort[..^5] :
        CurrentSort;

    private bool _isActive    => BaseKey == CurrentBase;
    private bool _isAscending => CurrentSort.EndsWith("-asc", StringComparison.Ordinal)
                                 || (!CurrentSort.Contains('-') && BaseKey == CurrentBase);
}
