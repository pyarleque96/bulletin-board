@namespace Bulletin.Board.Web.Client.Components.Forms

@*
    AppFileInput — input de archivo / imagen reutilizable.
    Soporta: accept MIME, multiple, drag-and-drop visual, estado de error.
    Estilo: área de drop con borde dashed sobre fondo oscuro auth-context.
    El archivo seleccionado se expone vía OnFileSelected para procesamiento externo.
*@

@using Microsoft.AspNetCore.Components.Forms

@inject IStringLocalizer<SharedResource> _localizer

<div class="@WrapperClass">

    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@InputId" class="@LabelClass">
            @Label
        </label>
    }

    <label for="@InputId"
           class="@DropZoneClass"
           @ondragover:preventDefault
           @ondrop:preventDefault>

        @* Icono de upload *@
        <span class="text-white/25 mb-2" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5">
                <polyline points="16 16 12 12 8 16" />
                <line x1="12" y1="12" x2="12" y2="21" />
                <path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3" />
            </svg>
        </span>

        @if (!string.IsNullOrEmpty(FileName))
        {
            <span class="text-white/70 text-sm font-medium">@FileName</span>
            <span class="text-white/30 text-xs mt-0.5">
                @_localizer["File_ClickToChange"]
            </span>
        }
        else
        {
            <span class="text-white/50 text-sm">
                @_localizer["File_ClickOrDrag"]
            </span>
            @if (!string.IsNullOrEmpty(AcceptHint))
            {
                <span class="text-white/25 text-xs mt-0.5">@AcceptHint</span>
            }
        }

        <InputFile id="@InputId"
                   accept="@Accept"
                   multiple="@Multiple"
                   OnChange="HandleFileChange"
                   class="sr-only"
                   disabled="@Disabled"
                   aria-label="@(!string.IsNullOrEmpty(Label) ? Label : "File upload")" />
    </label>

    @if (HasError && !string.IsNullOrEmpty(ErrorMessage))
    {
        <p id="@($"{InputId}-error")"
           class="text-red-400 text-xs mt-1"
           role="alert">
            @ErrorMessage
        </p>
    }

</div>

@code {
    [Parameter, EditorRequired] public string InputId { get; set; } = "";

    [Parameter] public string Label { get; set; } = "";

    /// <summary>MIME o extensión: "image/*", ".pdf,.docx", etc.</summary>
    [Parameter] public string Accept { get; set; } = "image/*";

    /// <summary>Texto descriptivo de los formatos aceptados.</summary>
    [Parameter] public string AcceptHint { get; set; } = "PNG, JPG, WEBP · max 5 MB";

    [Parameter] public bool Multiple { get; set; } = false;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool HasError { get; set; } = false;
    [Parameter] public string ErrorMessage { get; set; } = "";

    [Parameter] public string WrapperClass { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";

    [Parameter] public EventCallback<IBrowserFile> OnFileSelected { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<IBrowserFile>> OnFilesSelected { get; set; }

    [Parameter] public string LabelClass { get; set; } =
        "block text-white/60 text-xs font-medium mb-1.5 uppercase tracking-wider";

    private string FileName { get; set; } = "";

    private string DropZoneClass =>
        "flex flex-col items-center justify-center gap-1 " +
        "w-full min-h-[120px] px-4 py-6 rounded-2xl cursor-pointer " +
        "border-2 border-dashed transition-colors duration-200 " +
        (HasError
            ? "border-red-500/40 bg-red-500/5 hover:border-red-400/60 "
            : "border-white/15 bg-white/5 hover:border-white/30 hover:bg-white/8 ") +
        (Disabled ? "opacity-50 cursor-not-allowed " : "") +
        CssClass;

    private async Task HandleFileChange(InputFileChangeEventArgs e)
    {
        if (Multiple)
        {
            var files = e.GetMultipleFiles();
            FileName = files.Count > 1
                ? $"{files.Count} files selected"
                : files.FirstOrDefault()?.Name ?? "";
            await OnFilesSelected.InvokeAsync(files);
        }
        else
        {
            var file = e.File;
            FileName = file.Name;
            await OnFileSelected.InvokeAsync(file);
        }
    }
}
