@namespace Bulletin.Board.Web.Client.Components.Forms

@*
    AppRadio — radio button individual reutilizable.
    Para grupos: usar múltiples AppRadio con el mismo GroupName.
    Soporta: two-way binding por Value string, label, estado de error.
    Variante "card" para el selector visual tipo tarjeta (como account-type en Register).
    Variante "default" para radio estándar inline.
*@

<div class="@WrapperClass">

    @if (Variant == "card")
    {
        @* Tarjeta seleccionable — patrón account-type-card de Register *@
        <button type="button"
                class="@CardClass w-full"
                @onclick="SelectThis"
                aria-pressed="@IsSelected">
            @if (CardIcon is not null)
            {
                <div class="card-icon">
                    @CardIcon
                </div>
            }
            <span class="@CardLabelClass">@Label</span>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <span class="block text-white/25 text-[0.6875rem]">@Subtitle</span>
            }
        </button>
    }
    else
    {
        @* Radio estándar *@
        <label class="flex items-center gap-2.5 cursor-pointer select-none @LabelClass">
            <input type="radio"
                   name="@GroupName"
                   value="@OptionValue"
                   checked="@IsSelected"
                   @onchange="SelectThis"
                   disabled="@Disabled"
                   class="accent-brand-500 @CssClass" />
            @Label
        </label>
    }

</div>

@code {
    /// <summary>Valor actualmente seleccionado en el grupo (two-way binding).</summary>
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Valor que representa este radio/card.</summary>
    [Parameter, EditorRequired] public string OptionValue { get; set; } = "";

    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public string GroupName { get; set; } = "radio-group";

    /// <summary>"default" | "card"</summary>
    [Parameter] public string Variant { get; set; } = "default";

    [Parameter] public RenderFragment? CardIcon { get; set; }

    [Parameter] public bool Disabled { get; set; } = false;

    [Parameter] public string WrapperClass { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string LabelClass { get; set; } = "text-white/50 text-sm";

    private bool IsSelected => Value == OptionValue;

    private string CardClass =>
        IsSelected ? "account-type-card selected" : "account-type-card";

    private string CardLabelClass =>
        IsSelected
            ? "block text-xs font-semibold text-accent"
            : "block text-xs font-semibold text-white/50 mb-0.5";

    private async Task SelectThis()
    {
        if (!Disabled)
            await ValueChanged.InvokeAsync(OptionValue);
    }
}
