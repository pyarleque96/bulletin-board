@namespace Bulletin.Board.Web.Client.Components.Manage.Shared

@*
    KpiCard — tarjeta de métrica con label uppercase, valor tabular-nums y delta
    opcional (verde si positivo, rojo si negativo). Pensado para grids de KPIs
    en Overview, Analytics, Reservations.
*@

<div class="bg-white rounded-2xl border border-slate-200 p-4 sm:p-5 flex flex-col gap-2"
     role="group"
     aria-label="@Label">

    <div class="flex items-center justify-between gap-2">
        <span class="text-[10px] font-semibold uppercase tracking-wider text-muted">
            @Label
        </span>
        @if (Delta is not null)
        {
            <span class="text-[10px] font-semibold tabular-nums @DeltaColor inline-flex items-center gap-0.5">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    @if (Delta.Value >= 0)
                    {
                        <polyline points="6 15 12 9 18 15"/>
                    }
                    else
                    {
                        <polyline points="6 9 12 15 18 9"/>
                    }
                </svg>
                @FormatDelta()
            </span>
        }
    </div>

    <div class="text-2xl font-bold text-ink tabular-nums leading-none">
        @Value
    </div>

    @if (!string.IsNullOrEmpty(Hint))
    {
        <p class="text-[11px] text-muted leading-snug">@Hint</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? Hint  { get; set; }

    /// <summary>Cambio porcentual; positivo = verde, negativo = rojo, null = oculto.</summary>
    [Parameter] public double? Delta { get; set; }

    /// <summary>Sufijo del delta (default "%"). Útil para deltas absolutos.</summary>
    [Parameter] public string DeltaSuffix { get; set; } = "%";

    private string DeltaColor => Delta is null
        ? ""
        : Delta.Value >= 0 ? "text-green-600" : "text-red-600";

    private string FormatDelta()
    {
        if (Delta is null) return string.Empty;
        var sign = Delta.Value > 0 ? "+" : string.Empty;
        return $"{sign}{Delta.Value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}{DeltaSuffix}";
    }
}
