@namespace Bulletin.Board.Web.Client.Components.Manage.Shared
@inject IStringLocalizer<SharedResource> _localizer

@*  DangerZoneCard — red-bordered card with title, description and a destructive
    action button. Used at the bottom of every Settings sub-page.

    TODO: DELETE /api/v1/manage/listings/{id}  (soft delete; requires GM ack).
*@

<section class="bg-white rounded-3xl border border-red-200 shadow-soft p-5 mt-8">
    <h2 class="text-base font-semibold text-red-800 mb-1">
        @(_localizer["Manage_Settings_Danger_Title"])
    </h2>
    <p class="text-xs text-muted mb-4">
        @(string.IsNullOrEmpty(Subtitle) ? _localizer["Manage_Settings_Danger_Subtitle"] : Subtitle)
    </p>
    <button type="button"
            @onclick="OnDelete"
            class="px-3 py-2 rounded-xl border border-red-200 bg-red-50 text-red-700 hover:bg-red-100 text-xs font-semibold cursor-pointer">
        @_localizer["Manage_Settings_Danger_Delete"]
    </button>
</section>

@code {
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
}
