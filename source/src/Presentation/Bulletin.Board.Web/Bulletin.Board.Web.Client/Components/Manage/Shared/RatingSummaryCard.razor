@namespace Bulletin.Board.Web.Client.Components.Manage.Shared
@inject IStringLocalizer<SharedResource> _localizer

@*
    RatingSummaryCard — Promedio grande + total + distribución 5★…1★ con barras.
    El % se calcula contra el total. Si no se pasa distribución, los datos los
    completa el backend (resumen de reviews aprobadas por el GM — regla #7).
*@

<div class="bg-white rounded-2xl border border-slate-200 p-5 sm:p-6 flex flex-col sm:flex-row gap-6 sm:gap-8"
     role="region"
     aria-label="@_localizer["Rating_Summary_Title"]">

    @* ── Lado izquierdo: promedio + total ── *@
    <div class="flex flex-col items-start sm:items-center sm:justify-center sm:w-40 flex-shrink-0">
        <div class="text-5xl font-bold text-ink tabular-nums leading-none">
            @Average.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)
        </div>
        <div class="flex items-center gap-0.5 mt-2" aria-hidden="true">
            @for (int i = 1; i <= 5; i++)
            {
                <svg class="w-4 h-4 @(i <= (int)Math.Round(Average) ? "text-amber-400" : "text-slate-200")"
                     viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
            }
        </div>
        <p class="text-xs text-muted mt-2 tabular-nums">
            @string.Format(_localizer["Rating_Summary_TotalReviews"], TotalReviews)
        </p>
    </div>

    @* ── Lado derecho: distribución ── *@
    <div class="flex-1 flex flex-col gap-1.5 min-w-0">
        @for (int star = 5; star >= 1; star--)
        {
            var count = GetCount(star);
            var pct = TotalReviews > 0 ? (count * 100.0 / TotalReviews) : 0;
            <div class="flex items-center gap-2 text-xs">
                <span class="w-4 text-muted tabular-nums text-right">@star</span>
                <svg class="w-3 h-3 text-amber-400 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
                <div class="flex-1 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                    <div class="h-full bg-amber-400 rounded-full transition-all duration-500"
                         style="width:@(pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                </div>
                <span class="w-10 text-muted tabular-nums text-right">@count</span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public double Average { get; set; }
    [Parameter] public int TotalReviews { get; set; }

    /// <summary>Distribución 1★…5★. Key = estrella, Value = count.</summary>
    [Parameter] public IReadOnlyDictionary<int, int>? Distribution { get; set; }

    private int GetCount(int star) =>
        Distribution is not null && Distribution.TryGetValue(star, out var c) ? c : 0;
}
