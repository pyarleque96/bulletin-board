@namespace Bulletin.Board.Web.Client.Components.Manage.Shared
@inject IStringLocalizer<SharedResource> _localizer

@*
    VipUpsellBanner — banner naranja con gradient. Solo se renderiza si el tier
    actual NO es VIP. Acepta un slot opcional con bullets/CTA personalizados;
    si no, usa el contenido por defecto.

    Regla #3: nadie es VIP sin estar Verified primero.
*@

@if (!string.Equals(Tier, "VIP", StringComparison.OrdinalIgnoreCase))
{
    <div class="rounded-2xl p-5 sm:p-6 text-white relative overflow-hidden"
         style="background: linear-gradient(135deg, #fb923c 0%, #f97316 55%, #ea580c 100%);"
         role="complementary"
         aria-label="@_localizer["Manage_VipUpsell_Title"]">

        @* Glow decorativo *@
        <div class="absolute -top-12 -right-12 w-48 h-48 rounded-full bg-white/15 blur-2xl pointer-events-none" aria-hidden="true"></div>

        <div class="relative flex flex-col sm:flex-row sm:items-center gap-4">
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1.5">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                    <span class="text-[10px] uppercase tracking-[0.18em] font-bold opacity-90">
                        @_localizer["Manage_VipUpsell_Title"]
                    </span>
                </div>
                <h3 class="text-base sm:text-lg font-bold leading-snug">
                    @(string.IsNullOrEmpty(Title) ? (string)_localizer["VipUpsell_DefaultTitle"] : Title)
                </h3>
                @if (ChildContent is not null)
                {
                    <div class="mt-2 text-sm/relaxed text-white/90">@ChildContent</div>
                }
                else
                {
                    <p class="mt-1 text-sm/relaxed text-white/90 max-w-xl">
                        @_localizer["Manage_VipUpsell_Body"]
                    </p>
                }
            </div>

            <a href="@CtaHref"
               class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-white text-orange-700 hover:bg-orange-50 text-xs font-bold no-underline whitespace-nowrap transition-colors flex-shrink-0"
               aria-label="@_localizer["Manage_VipUpsell_GetVerified"]">
                @_localizer["Manage_VipUpsell_GetVerified"]
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                </svg>
            </a>
        </div>
    </div>
}

@code {
    /// <summary>Tier actual del proveedor; el banner se oculta si == "VIP".</summary>
    [Parameter] public string Tier { get; set; } = "Regular";

    /// <summary>Override del título (defecto: VipUpsell_DefaultTitle).</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>URL del CTA. Defecto: /provider/verification.</summary>
    [Parameter] public string CtaHref { get; set; } = "/provider/verification";

    /// <summary>Slot opcional para bullets/contenido personalizado.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
