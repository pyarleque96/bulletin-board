@namespace Bulletin.Board.Web.Client.Components.Manage.Shared

@*  ToggleSwitch — accessible pill toggle (h-5 w-9 rounded-full).
    Pure UI component; no API binding yet. TODO: PATCH /api/v1/manage/listings/{id}/preferences
    (safe flags only — Regla #5 does NOT apply, instant apply).
*@

<button type="button"
        role="switch"
        aria-checked="@Checked.ToString().ToLowerInvariant()"
        aria-label="@AriaLabel"
        disabled="@Disabled"
        @onclick="OnToggleAsync"
        class="@_buttonCss">
    <span class="@_thumbCss" aria-hidden="true"></span>
</button>

@code {
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? AriaLabel { get; set; }

    private string _buttonCss =>
        $"relative inline-flex h-5 w-9 flex-shrink-0 items-center rounded-full transition-colors duration-200 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 " +
        (Disabled ? "opacity-50 cursor-not-allowed " : "") +
        (Checked ? "bg-brand-500" : "bg-slate-300");

    private string _thumbCss =>
        $"inline-block h-4 w-4 transform rounded-full bg-white shadow transition-transform duration-200 " +
        (Checked ? "translate-x-4" : "translate-x-0.5");

    private async Task OnToggleAsync()
    {
        if (Disabled) return;
        var next = !Checked;
        Checked = next;
        if (CheckedChanged.HasDelegate)
        {
            await CheckedChanged.InvokeAsync(next);
        }
    }
}
