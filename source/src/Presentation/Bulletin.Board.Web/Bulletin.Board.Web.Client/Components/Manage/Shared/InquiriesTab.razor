@* ─────────────────────────────────────────────────────────────────────────────
   InquiriesTab — Tab Inquiries reutilizable (Regular + VIP) para:
     · Housing (Regular)
     · Mechanics (Regular + VIP)
     · Transportation (Regular + VIP)

   Mismo template; branchea con @if (IsVip) los bloques data-vip-only del mockup
   (KPI strip + footer note).

   Regla #8: el GM recibe copia email de toda interacción. Al abrir wa.me
   debemos POSTear mark-contacted ANTES (escribe ContactLog + dispara email).

   BACKEND PENDIENTE (BACKEND_AUDIT §1.3):
     · GET  /api/v1/manage/listings/{id}/inquiries
     · POST /api/v1/manage/listings/{id}/inquiries/{inquiryId}/mark-contacted
   Hasta que aterricen, la UI queda en empty-state con TODO claro. NO inventamos
   endpoints.
   ───────────────────────────────────────────────────────────────────────────── *@
@namespace Bulletin.Board.Web.Client.Components.Manage.Shared
@using Bulletin.Board.Web.Client.Models

@inject IStringLocalizer<SharedResource> _localizer

<style>
    .badge-vip { background: linear-gradient(135deg,#fb923c,#f97316); }
    .vip-glow  { box-shadow: 0 4px 24px -4px rgba(249,115,22,0.16); }
</style>

<main class="max-w-6xl mx-auto px-4 py-8 w-full"
      id="panel-inquiries"
      role="tabpanel"
      aria-labelledby="tab-inquiries"
      tabindex="0">

    @* ── Header ──────────────────────────────────────────────────────── *@
    <div class="flex items-start justify-between gap-4 flex-wrap mb-5">
        <div>
            <h2 class="text-base font-semibold text-ink">@_localizer["Manage_Inquiries_Title"]</h2>
            <p class="text-sm text-muted mt-0.5">@_localizer["Manage_Inquiries_Subtitle"]</p>
        </div>

        @* Filter pills — sin estado real hasta API. *@
        <div class="flex items-center gap-1.5 flex-wrap"
             role="group"
             aria-label="@_localizer["Manage_Inquiries_Filter_AriaLabel"]">
            <button type="button" class="px-3 py-1.5 rounded-full text-xs font-medium bg-ink text-white cursor-pointer" aria-pressed="true">
                @_localizer["Manage_Common_All"]
            </button>
            <button type="button" class="px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 hover:bg-slate-200 text-ink cursor-pointer" disabled>
                @_localizer["Manage_Inquiries_Filter_New"]
            </button>
            <button type="button" class="px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 hover:bg-slate-200 text-ink cursor-pointer" disabled>
                @_localizer["Manage_Inquiries_Filter_Contacted"]
            </button>
            <button type="button" class="px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 hover:bg-slate-200 text-ink cursor-pointer" disabled>
                @_localizer["Manage_Inquiries_Filter_Closed"]
            </button>
        </div>
    </div>

    @* ── KPI strip (VIP only) ────────────────────────────────────────── *@
    @if (IsVip)
    {
        <section aria-label="@_localizer["Manage_Inquiries_Kpis_AriaLabel"]"
                 class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
            <div class="bg-white rounded-2xl border border-slate-100 shadow-soft p-4 vip-glow">
                <p class="text-[11px] uppercase tracking-wider text-muted font-medium">@_localizer["Manage_Inquiries_Kpi_OpenCount"]</p>
                <p class="text-2xl font-bold text-ink mt-1 tabular-nums">—</p>
                <p class="text-[11px] text-amber-700 mt-1">@_localizer["Manage_Inquiries_Kpi_NeedReply"]</p>
            </div>
            <div class="bg-white rounded-2xl border border-slate-100 shadow-soft p-4 vip-glow">
                <p class="text-[11px] uppercase tracking-wider text-muted font-medium">@_localizer["Manage_Inquiries_Kpi_ResponseRate"]</p>
                <p class="text-2xl font-bold text-ink mt-1 tabular-nums">—</p>
                <p class="text-[11px] text-muted mt-1">@_localizer["Manage_Inquiries_Kpi_Last30Days"]</p>
            </div>
            <div class="bg-white rounded-2xl border border-slate-100 shadow-soft p-4 vip-glow">
                <p class="text-[11px] uppercase tracking-wider text-muted font-medium">@_localizer["Manage_Inquiries_Kpi_AvgFirstReply"]</p>
                <p class="text-2xl font-bold text-ink mt-1 tabular-nums">—</p>
                <p class="text-[11px] text-muted mt-1">@_localizer["Manage_Inquiries_Kpi_MedianTime"]</p>
            </div>
            <div class="bg-white rounded-2xl border border-slate-100 shadow-soft p-4 vip-glow">
                <p class="text-[11px] uppercase tracking-wider text-muted font-medium">@_localizer["Manage_Inquiries_Kpi_Conversion"]</p>
                <p class="text-2xl font-bold text-ink mt-1 tabular-nums">—</p>
                <p class="text-[11px] text-muted mt-1">@_localizer["Manage_Inquiries_Kpi_ContactToClose"]</p>
            </div>
        </section>
    }

    @* ── GM-copy notice (Regla #8) ───────────────────────────────────── *@
    <div class="mb-5">
        <GmCopyNotice Message="@_localizer["Manage_Inquiries_GmCopy"]" />
    </div>

    @*
        ── Lista de inquiries ────────────────────────────────────────────
        TODO: cuando aterrice GET /api/v1/manage/listings/{id}/inquiries
              (BACKEND_AUDIT §1.3), reemplazar ManageEmptyState por:
                1. <ul role="list" class="space-y-3"> de InquiryDto.
                2. <WhatsAppCtaButton> con OnClick que POSTea
                   /api/v1/manage/listings/{id}/inquiries/{inquiryId}/mark-contacted
                   ANTES de abrir wa.me (Regla #8).
        Hasta entonces, mostramos estado vacío con copy contextual. NO
        inventamos un endpoint POST que el backend aún no expone.
    *@
    <ManageEmptyState Title="@_localizer["Manage_Inquiries_Empty_Title"]"
                      Description="@_localizer["Manage_Inquiries_Empty_Description"]" />

    @if (IsVip)
    {
        <div class="mt-10 flex items-center justify-center gap-2 text-[11px] text-muted">
            <span class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded-full badge-vip text-white font-semibold">VIP</span>
            @_localizer["Manage_Inquiries_VipFooter"]
        </div>
    }
</main>

@code {
    [Parameter, EditorRequired] public ListingDetailDto Listing { get; set; } = default!;

    /// <summary>Branch del KPI strip (data-vip-only en el mockup) y footer.</summary>
    [Parameter] public bool IsVip { get; set; }
}
