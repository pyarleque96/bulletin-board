@namespace Bulletin.Board.Web.Client.Components.Manage.Shared
@inject IStringLocalizer<SharedResource> _localizer

@*  BilingualInput — renders two stacked inputs (EN + ES) sharing one label key.
    Regla #5 — these are content edits (Pending on save). Wrap save buttons in
    PendingReviewTooltip at the section/page level.

    TODO: PUT /api/v1/manage/listings/{id}/settings  (titles, descriptions, addresses…)
*@

<div class="space-y-3">
    <div>
        <label class="block text-xs font-semibold text-ink mb-1.5">
            @(LabelKey is null ? Label : _localizer[LabelKey]) (@_localizer["Manage_Settings_Lang_En"])
        </label>
        @if (Multiline)
        {
            <textarea rows="@Rows"
                      value="@ValueEn"
                      @oninput="@(async e => await OnEnChangedAsync((string?)e.Value ?? string.Empty))"
                      class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"></textarea>
        }
        else
        {
            <input type="text"
                   value="@ValueEn"
                   @oninput="@(async e => await OnEnChangedAsync((string?)e.Value ?? string.Empty))"
                   class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
        }
    </div>
    <div>
        <label class="block text-xs font-semibold text-ink mb-1.5">
            @(LabelKey is null ? Label : _localizer[LabelKey]) (@_localizer["Manage_Settings_Lang_Es"])
        </label>
        @if (Multiline)
        {
            <textarea rows="@Rows"
                      value="@ValueEs"
                      @oninput="@(async e => await OnEsChangedAsync((string?)e.Value ?? string.Empty))"
                      class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"></textarea>
        }
        else
        {
            <input type="text"
                   value="@ValueEs"
                   @oninput="@(async e => await OnEsChangedAsync((string?)e.Value ?? string.Empty))"
                   class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
        }
        @if (!string.IsNullOrEmpty(Helper))
        {
            <p class="text-[11px] text-muted mt-1">@Helper</p>
        }
    </div>
</div>

@code {
    [Parameter] public string? LabelKey { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? ValueEn { get; set; }
    [Parameter] public string? ValueEs { get; set; }
    [Parameter] public EventCallback<string> OnChangedEn { get; set; }
    [Parameter] public EventCallback<string> OnChangedEs { get; set; }
    [Parameter] public bool Multiline { get; set; }
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public string? Helper { get; set; }

    private async Task OnEnChangedAsync(string v)
    {
        ValueEn = v;
        if (OnChangedEn.HasDelegate) await OnChangedEn.InvokeAsync(v);
    }

    private async Task OnEsChangedAsync(string v)
    {
        ValueEs = v;
        if (OnChangedEs.HasDelegate) await OnChangedEs.InvokeAsync(v);
    }
}
