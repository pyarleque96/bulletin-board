@* ─────────────────────────────────────────────────────────────────────────────
   SingleListingPhotosTab — Photos tab para listings de listing único
   (mechanics / transportation, Regular + VIP).

   Diferencia vs Housing/PhotosRegular: no hay agrupación por property — un
   único listado de fotos del listing actual.

   Regla #4: el GM decide qué fotos son públicas. ListingDetailDto.Photos viene
   pre-filtrado a Public por el mapper. Mientras el endpoint GET de fotos
   completas (Pending/Rejected/Hidden) no aterrice, sólo mostramos las Public.

   Regla #5: cualquier upload/remove vuelve el listing a Pending (wrapped en
   PendingReviewTooltip).

   Backend usado:
     · POST   /api/v1/manage/listings/{id}/photos              (upload — pendiente)
     · DELETE /api/v1/manage/listings/{id}/photos/{photoId}    (pendiente)
     · PATCH  /api/v1/manage/listings/{id}/photos/{pid}/cover  (TODO designer)
   ───────────────────────────────────────────────────────────────────────────── *@
@namespace Bulletin.Board.Web.Client.Components.Manage.Shared
@using Bulletin.Board.Web.Client.Models

@inject IStringLocalizer<SharedResource> _localizer

<main class="max-w-6xl mx-auto px-4 py-8 w-full"
      id="panel-photos"
      role="tabpanel"
      aria-labelledby="tab-photos"
      tabindex="0">

    @* ── Header ──────────────────────────────────────────────────────── *@
    <div class="flex items-start justify-between gap-4 flex-wrap mb-5">
        <div>
            <h2 class="text-base font-semibold text-ink">@_localizer["Manage_Photos_Title"]</h2>
            <p class="text-sm text-muted mt-0.5">@_localizer["Manage_Photos_Subtitle"]</p>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
            <PendingReviewTooltip>
                <label class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-brand-500 hover:bg-brand-600 text-white text-xs font-semibold cursor-pointer transition-colors duration-150 min-h-[44px]">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    @_localizer["Manage_Photos_Upload"]
                    @* TODO: API POST /api/v1/manage/listings/{id}/photos (BACKEND_AUDIT §1.1). Status=Pending por defecto (Regla #4). *@
                    <input type="file" multiple accept="image/jpeg,image/png,image/webp" class="sr-only" disabled />
                </label>
            </PendingReviewTooltip>
        </div>
    </div>

    @* ── Regla #4 banner ─────────────────────────────────────────────── *@
    <div class="mb-5 flex items-start gap-3 px-4 py-3 rounded-2xl bg-amber-50 border border-amber-200" role="note">
        <svg class="w-4 h-4 text-amber-700 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <p class="text-xs text-ink leading-relaxed">@_localizer["Banner_GmDecidesPhotos"]</p>
    </div>

    @* ── Filter pills (read-only hasta API completa) ──────────────────── *@
    <div class="flex items-center justify-between gap-3 flex-wrap mb-5">
        <div class="flex items-center gap-1.5 flex-wrap"
             role="group"
             aria-label="@_localizer["Manage_Photos_Filter_AriaLabel"]">
            <button type="button" class="px-3 py-1.5 rounded-full text-xs font-medium bg-ink text-white cursor-pointer" aria-pressed="true">
                @_localizer["Manage_Common_All"]
                <span class="ml-1 bg-white/20 px-1.5 rounded-full tabular-nums">@_photos.Length</span>
            </button>
            <button type="button" class="px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 hover:bg-slate-200 text-ink cursor-pointer" disabled>
                @_localizer["Photo_Status_Public"]
                <span class="ml-1 bg-emerald-100 text-emerald-800 px-1.5 rounded-full tabular-nums">@_photos.Length</span>
            </button>
            <button type="button" class="px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 hover:bg-slate-200 text-ink cursor-pointer" disabled>
                @_localizer["Photo_Status_Pending"]
                <span class="ml-1 bg-amber-100 text-amber-800 px-1.5 rounded-full tabular-nums">—</span>
            </button>
            <button type="button" class="px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 hover:bg-slate-200 text-ink cursor-pointer" disabled>
                @_localizer["Photo_Status_Hidden"]
                <span class="ml-1 bg-slate-200 text-slate-700 px-1.5 rounded-full tabular-nums">—</span>
            </button>
        </div>
        <p class="text-[11px] text-muted tabular-nums">
            @string.Format(_localizer["Manage_Photos_SlotsUsedFormat"], _photos.Length, MaxSlots)
        </p>
    </div>

    @if (_photos.Length == 0)
    {
        <ManageEmptyState Title="@_localizer["Manage_Photos_Empty_Title"]"
                          Description="@_localizer["Manage_Photos_Empty_Description"]" />
    }
    else
    {
        <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" role="list">
            @foreach (var (photo, idx) in _photos.Select((p, i) => (p, i)))
            {
                var isCover = idx == 0;
                <li class="bg-white rounded-2xl border border-slate-100 shadow-soft overflow-hidden @(isCover ? "ring-2 ring-accent-500" : "")">
                    <div class="relative aspect-[4/3] bg-slate-200">
                        <img src="@photo.Url" alt="@photo.AltText" class="w-full h-full object-cover" loading="lazy" />
                        <div class="absolute top-2 left-2">
                            <PhotoStatusBadge Status="Public" />
                        </div>
                        @if (isCover)
                        {
                            <span class="absolute top-2 right-2 text-[10px] uppercase tracking-wider bg-accent-500 text-white px-2 py-0.5 rounded-full font-bold">
                                @_localizer["Manage_Photos_Cover"]
                            </span>
                        }
                        else
                        {
                            @* TODO: PATCH /api/v1/manage/listings/{id}/photos/{pid}/cover (designer suggestion) *@
                            <PendingReviewTooltip CssClass="absolute top-2 right-2">
                                <button type="button"
                                        class="inline-flex items-center gap-1 text-[10px] uppercase tracking-wider px-2 py-1 rounded-full bg-white/95 backdrop-blur text-ink border border-slate-200 font-medium hover:bg-white cursor-pointer"
                                        disabled>
                                    @_localizer["Manage_Photos_MakeCover"]
                                </button>
                            </PendingReviewTooltip>
                        }
                    </div>
                    <div class="p-3 flex items-center justify-between gap-2">
                        <span class="text-[11px] text-muted truncate">@(photo.AltText ?? "")</span>
                        <PendingReviewTooltip>
                            <button type="button"
                                    class="text-[11px] text-red-600 hover:text-red-700 cursor-pointer px-2 py-1 rounded-lg hover:bg-red-50 transition-colors"
                                    disabled>
                                @* TODO: DELETE /api/v1/manage/listings/{id}/photos/{photoId} (BACKEND_AUDIT §1.1) *@
                                @_localizer["Manage_Common_Remove"]
                            </button>
                        </PendingReviewTooltip>
                    </div>
                </li>
            }
        </ul>

        @* ── Format / size hints ──────────────────────────────────────── *@
        <div class="mt-6 flex flex-wrap items-center gap-4 text-[11px] text-muted">
            <span class="inline-flex items-center gap-1.5">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
                </svg>
                @_localizer["Manage_Photos_Format"]
            </span>
            <span class="inline-flex items-center gap-1.5">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
                </svg>
                @_localizer["Manage_Photos_RecommendedSize"]
            </span>
        </div>
    }
</main>

@code {
    [Parameter, EditorRequired] public ListingDetailDto Listing { get; set; } = default!;

    /// <summary>Single source of truth for the photo cap. VIP unlocks more once the backend ships per-tier limits.</summary>
    [Parameter] public int MaxSlots { get; set; } = 15;

    private ListingPhotoDto[] _photos = Array.Empty<ListingPhotoDto>();

    protected override void OnParametersSet()
    {
        // Photos in ListingDetailDto are filtered to Public-only by the mapper (Regla #4).
        // When the full status-aware endpoint lands (BACKEND_AUDIT §1.1), this becomes
        // a state-grouped collection (Public / Pending / Rejected / Hidden).
        _photos = Listing.Photos;
    }
}
