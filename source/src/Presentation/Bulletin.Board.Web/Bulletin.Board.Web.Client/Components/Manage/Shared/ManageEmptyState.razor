@namespace Bulletin.Board.Web.Client.Components.Manage.Shared

@*
    EmptyState — vacío amable con icono, título, descripción y slot opcional
    para CTA. Usable en cualquier tab que pueda quedar vacía (Reservations,
    Reviews, Inquiries, Photos, etc.).
*@

<div class="text-center py-16 sm:py-20 px-4" role="status" aria-live="polite">
    <div class="w-16 h-16 rounded-2xl bg-slate-100 flex items-center justify-center mx-auto mb-4" aria-hidden="true">
        @if (Icon is not null)
        {
            @Icon
        }
        else
        {
            <svg class="w-8 h-8 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <line x1="3" y1="9" x2="21" y2="9"/>
                <line x1="9" y1="21" x2="9" y2="9"/>
            </svg>
        }
    </div>
    <h3 class="text-base font-semibold text-ink mb-1">@Title</h3>
    @if (!string.IsNullOrEmpty(Description))
    {
        <p class="text-sm text-muted mb-4 max-w-md mx-auto">@Description</p>
    }
    @if (Cta is not null)
    {
        <div class="mt-2 flex items-center justify-center">@Cta</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public RenderFragment? Cta { get; set; }
}
