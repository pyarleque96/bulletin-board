@namespace Bulletin.Board.Web.Client.Components.Manage.Shared
@inject IStringLocalizer<SharedResource> _localizer

@*
    ReviewStatusBadge — estado de un rating en el flujo de moderación (regla #7:
    los ratings los aprueba el GM antes de aparecer en público).

    Status: "Published" | "PendingGm" | "Rejected"
*@

<span class="inline-flex items-center gap-1 text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full @ClassFor(Status)"
      aria-label="@LabelFor(Status)">
    <span class="w-1.5 h-1.5 rounded-full @DotFor(Status)" aria-hidden="true"></span>
    @LabelFor(Status)
</span>

@code {
    [Parameter, EditorRequired] public string Status { get; set; } = "PendingGm";

    private string ClassFor(string status) => status switch
    {
        "Published" => "bg-green-100 text-green-800 border border-green-200",
        "PendingGm" => "bg-amber-100 text-amber-800 border border-amber-200",
        "Rejected"  => "bg-red-100 text-red-800 border border-red-200",
        _           => "bg-slate-100 text-slate-700 border border-slate-200",
    };

    private string DotFor(string status) => status switch
    {
        "Published" => "bg-green-500",
        "PendingGm" => "bg-amber-500",
        "Rejected"  => "bg-red-500",
        _           => "bg-slate-400",
    };

    private string LabelFor(string status) => status switch
    {
        "Published" => _localizer["Review_Status_Published"],
        "PendingGm" => _localizer["Review_Status_PendingGm"],
        "Rejected"  => _localizer["Review_Status_Rejected"],
        _           => status,
    };
}
