@namespace Bulletin.Board.Web.Client.Components.Manage.Shared
@inject IStringLocalizer<SharedResource> _localizer

@*
    PhotoStatusBadge — indica el estado de moderación de una foto en el panel
    de proveedor (regla #4: el GM decide qué fotos son públicas).

    Status: "Public" | "Pending" | "Hidden" | "Rejected"
*@

<span class="inline-flex items-center gap-1 text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full @ClassFor(Status)"
      aria-label="@LabelFor(Status)">
    <span class="w-1.5 h-1.5 rounded-full @DotFor(Status)" aria-hidden="true"></span>
    @LabelFor(Status)
</span>

@code {
    [Parameter, EditorRequired] public string Status { get; set; } = "Pending";

    private string ClassFor(string status) => status switch
    {
        "Public"   => "bg-green-100 text-green-800 border border-green-200",
        "Pending"  => "bg-amber-100 text-amber-800 border border-amber-200",
        "Hidden"   => "bg-slate-100 text-slate-700 border border-slate-200",
        "Rejected" => "bg-red-100 text-red-800 border border-red-200",
        _          => "bg-slate-100 text-slate-700 border border-slate-200",
    };

    private string DotFor(string status) => status switch
    {
        "Public"   => "bg-green-500",
        "Pending"  => "bg-amber-500",
        "Hidden"   => "bg-slate-400",
        "Rejected" => "bg-red-500",
        _          => "bg-slate-400",
    };

    private string LabelFor(string status) => status switch
    {
        "Public"   => _localizer["Photo_Status_Public"],
        "Pending"  => _localizer["Photo_Status_Pending"],
        "Hidden"   => _localizer["Photo_Status_Hidden"],
        "Rejected" => _localizer["Photo_Status_Rejected"],
        _          => status,
    };
}
