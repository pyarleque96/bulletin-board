@namespace Bulletin.Board.Web.Client.Components.Manage.Shared

@*
    WhatsAppCtaButton — deep link a wa.me con mensaje preformateado.
    Pensado para las celdas/filas de Inquiries y Reservations donde el provider
    contacta directamente al cliente (regla #8 — el GM recibe copia por email,
    pero el canal real es WhatsApp).
*@

<a href="@BuildHref()"
   target="_blank"
   rel="noopener noreferrer"
   class="@ComputedClass"
   aria-label="@(string.IsNullOrEmpty(AriaLabel) ? "Contact via WhatsApp" : AriaLabel)">
    <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
    </svg>
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <span>WhatsApp</span>
    }
</a>

@code {
    /// <summary>Teléfono internacional (con o sin "+"). Se normaliza para wa.me.</summary>
    [Parameter, EditorRequired] public string Phone { get; set; } = "";

    /// <summary>Mensaje preformateado que se inyecta como query param.</summary>
    [Parameter] public string Message { get; set; } = "";

    /// <summary>Texto accesible si no hay ChildContent.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Clases extra para personalizar layout/spacing.</summary>
    [Parameter] public string? CssClass { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ComputedClass =>
        "inline-flex items-center justify-center gap-2 px-3 py-1.5 rounded-xl " +
        "text-xs font-semibold text-white no-underline " +
        "transition-[transform,box-shadow,background-color] duration-200 " +
        "[transition-timing-function:cubic-bezier(0.32,0.72,0,1)] " +
        "hover:-translate-y-0.5 hover:shadow-[0_8px_24px_-4px_rgba(37,211,102,0.35)] " +
        "active:scale-[0.98] active:translate-y-0 cursor-pointer " +
        "bg-[#25D366] hover:bg-[#1ebd5b] " +
        (CssClass ?? string.Empty);

    private string BuildHref()
    {
        var number = (Phone ?? string.Empty)
            .Replace("+", "")
            .Replace(" ", "")
            .Replace("-", "")
            .Replace("(", "")
            .Replace(")", "");
        if (string.IsNullOrEmpty(number))
            return "https://wa.me/";

        if (string.IsNullOrEmpty(Message))
            return $"https://wa.me/{number}";

        var msg = Uri.EscapeDataString(Message);
        return $"https://wa.me/{number}?text={msg}";
    }
}
