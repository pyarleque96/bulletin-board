@* ─────────────────────────────────────────────────────────────────────────────
   MechanicsManageVip — VIP mechanics panel: response time, specialties,
   coverage map (SVG placeholder), services. Active tab = Services.
   Dispatcher tabs vía DynamicComponent. Reviews reusa Tabs/ReviewsRegular.
   ───────────────────────────────────────────────────────────────────────────── *@
@using Bulletin.Board.Web.Client.Models
@using Bulletin.Board.Web.Client.Components.Shared
@using Bulletin.Board.Web.Client.Components.Manage.Shared
@using Bulletin.Board.Web.Client.Components.Manage.Layouts.Mechanics.Tabs

@inject IStringLocalizer<SharedResource> _localizer

<style>
    .badge-vip { background: linear-gradient(135deg,#fb923c,#f97316); }
    .card-hover { transition: transform 0.35s cubic-bezier(0.32,0.72,0,1), box-shadow 0.35s; }
    .card-hover:hover { transform:translateY(-2px); box-shadow:0 12px 40px -8px rgba(30,41,59,0.14); }
    @@media (prefers-reduced-motion: reduce) { *,*::before,*::after { animation-duration:0.01ms!important; transition-duration:0.01ms!important; } }
</style>

<ManageDetailHeader ListingId="@Listing.Id.ToString()"
                    ListingTitle="@Listing.TitleEn"
                    CategorySlug="@Listing.CategorySlug"
                    ActiveTab="@ResolvedActiveTab"
                    Status="@Listing.Status"
                    TierBadge="@Listing.Tier"
                    CategoryLabel="@(_localizer["Manage_Mechanics_CategoryLabel"])"
                    Since="@SinceLabel"
                    PublicUrl="@($"/listing/{Listing.Id}")"
                    ServiceCount="@Listing.Services.Length" />

@{
    var (tabType, tabParams) = ResolveTab(ResolvedActiveTab);
}
@if (tabType is not null)
{
    <DynamicComponent Type="tabType" Parameters="tabParams" />
}
else
{
    @* Default tab = Services (v2 VIP content kept inline). *@
    <main class="max-w-6xl mx-auto px-4 py-8 w-full"
          id="panel-services"
          role="tabpanel"
          aria-labelledby="tab-services"
          tabindex="0">

        @* VIP metrics row — TODO: API GET /api/v1/listings/{id}/mechanic-metrics *@
        <section aria-label="@_localizer["Manage_Mechanics_Metric_Specialties"]" class="mb-6 grid grid-cols-1 lg:grid-cols-3 gap-4">

            <div class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5">
                <div class="flex items-center gap-2 mb-1">
                    <p class="text-[11px] uppercase tracking-wider text-muted font-medium">@_localizer["Manage_Mechanics_Metric_AvgResponse"]</p>
                    <span class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded-full badge-vip text-white font-semibold">VIP</span>
                </div>
                <p class="text-3xl font-bold text-ink mt-1 tabular-nums">— <span class="text-base text-muted ml-1">min</span></p>
                <p class="text-[11px] text-muted mt-1">@_localizer["Manage_Mechanics_Metric_Last30d"]</p>
                <div class="mt-3 h-1.5 rounded-full bg-slate-100 overflow-hidden">
                    <div class="h-full bg-green-500 rounded-full" style="width:0%"></div>
                </div>
            </div>

            <div class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5">
                <div class="flex items-center gap-2 mb-3">
                    <p class="text-[11px] uppercase tracking-wider text-muted font-medium">@_localizer["Manage_Mechanics_Metric_Specialties"]</p>
                    <span class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded-full badge-vip text-white font-semibold">VIP</span>
                </div>
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var group in Listing.Services.Select(s => s.GroupEn).Where(g => !string.IsNullOrWhiteSpace(g)).Distinct())
                    {
                        <span class="text-xs bg-blue-50 text-blue-700 border border-blue-200 px-2.5 py-1 rounded-full">@group</span>
                    }
                    <PendingReviewTooltip>
                        <button type="button" class="text-xs text-brand-500 hover:text-brand-700 border border-dashed border-slate-300 hover:border-brand-400 px-2.5 py-1 rounded-full cursor-pointer">+ @_localizer["Manage_Common_Add"]</button>
                    </PendingReviewTooltip>
                </div>
            </div>

            <div class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5">
                <p class="text-[11px] uppercase tracking-wider text-muted font-medium">@_localizer["Manage_Mechanics_Metric_Requests30d"]</p>
                <p class="text-3xl font-bold text-ink mt-1 tabular-nums">—</p>
                <p class="text-[11px] text-muted mt-1">@_localizer["Manage_Mechanics_Metric_RequestsBreakdown"]</p>
            </div>

        </section>

        @* Coverage map placeholder — SVG illustrative *@
        <section aria-label="@_localizer["Manage_Mechanics_Coverage_AriaLabel"]" class="mb-6 bg-white rounded-3xl border border-slate-100 shadow-soft p-5">
            <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
                <div>
                    <h2 class="text-sm font-semibold text-ink inline-flex items-center gap-2">
                        @_localizer["Manage_Mechanics_Coverage_Title"]
                        <span class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded-full badge-vip text-white font-semibold">VIP</span>
                    </h2>
                    <p class="text-xs text-muted mt-0.5">@_localizer["Manage_Mechanics_Coverage_Subtitle"]</p>
                </div>
                <PendingReviewTooltip>
                    <button type="button" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-ink text-xs font-medium cursor-pointer">
                        @_localizer["Manage_Mechanics_Coverage_EditPerimeter"]
                    </button>
                </PendingReviewTooltip>
            </div>

            <div class="aspect-[16/7] rounded-2xl bg-slate-50 border border-slate-100 overflow-hidden relative">
                <svg viewBox="0 0 800 350" class="w-full h-full" role="img" aria-label="@_localizer["Manage_Mechanics_Coverage_MapAlt"]">
                    <defs>
                        <pattern id="mech-grid" width="40" height="40" patternUnits="userSpaceOnUse">
                            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#e2e8f0" stroke-width="0.5"/>
                        </pattern>
                        <radialGradient id="mech-cov" cx="50%" cy="50%" r="50%">
                            <stop offset="0%" stop-color="#f97316" stop-opacity="0.35"/>
                            <stop offset="60%" stop-color="#f97316" stop-opacity="0.15"/>
                            <stop offset="100%" stop-color="#f97316" stop-opacity="0.02"/>
                        </radialGradient>
                    </defs>
                    <rect width="800" height="350" fill="url(#mech-grid)"/>
                    <ellipse cx="400" cy="175" rx="240" ry="130" fill="url(#mech-cov)" stroke="#f97316" stroke-width="2" stroke-dasharray="6 4"/>
                    <circle cx="400" cy="175" r="10" fill="#f97316"/>
                    <circle cx="400" cy="175" r="20" fill="none" stroke="#f97316" stroke-width="2" opacity="0.5"/>
                    <text x="416" y="180" font-family="DM Sans, sans-serif" font-size="13" font-weight="600" fill="#0f172a">Wisconsin Dells (HQ)</text>
                </svg>
            </div>
            <p class="text-[11px] text-muted mt-2">@_localizer["Manage_Mechanics_Coverage_RadiusPlaceholder"]</p>
        </section>

        @* Services list *@
        <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
            <div>
                <h2 class="text-base font-semibold text-ink">@_localizer["Manage_Mechanics_Services_Title"]</h2>
                <p class="text-sm text-muted mt-0.5">@_localizer["Manage_Mechanics_Services_Subtitle_Vip"]</p>
            </div>
            <PendingReviewTooltip>
                <button type="button" class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-2xl bg-brand-500 hover:bg-brand-600 active:scale-[0.98] text-white text-sm font-semibold cursor-pointer">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    @_localizer["Manage_Mechanics_AddService"]
                </button>
            </PendingReviewTooltip>
        </div>

        <ul class="space-y-3" role="list" aria-label="@_localizer["Manage_Mechanics_Services_AriaLabel"]">
            @if (Listing.Services.Length == 0)
            {
                <li class="p-8 text-center bg-white rounded-3xl border border-dashed border-slate-200">
                    <p class="text-sm text-muted">@_localizer["Manage_Mechanics_Services_Empty"]</p>
                </li>
            }
            else
            {
                @foreach (var s in Listing.Services)
                {
                    <li class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5 card-hover">
                        <div class="flex items-start justify-between gap-4 flex-wrap">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <h3 class="font-semibold text-ink">@s.NameEn</h3>
                                    @if (!string.IsNullOrWhiteSpace(s.GroupEn))
                                    {
                                        <span class="text-[10px] uppercase tracking-wider bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full">@s.GroupEn</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(s.DescriptionEn))
                                {
                                    <p class="text-muted text-xs mt-0.5">@s.DescriptionEn</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(s.Price))
                                {
                                    <p class="text-ink text-sm mt-1 font-medium">@_localizer["Manage_Mechanics_From"] @s.Price</p>
                                }
                            </div>
                            <div class="flex items-center gap-1 flex-wrap">
                                <PendingReviewTooltip>
                                    <button type="button" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-ink text-xs font-medium cursor-pointer">@_localizer["Manage_Common_Edit"]</button>
                                </PendingReviewTooltip>
                            </div>
                        </div>
                    </li>
                }
            }
        </ul>

        <div class="mt-10 flex items-center justify-center gap-2 text-[11px] text-muted">
            <span class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded-full badge-vip text-white font-semibold">VIP</span>
            @_localizer["Manage_Mechanics_VipFooter"]
        </div>
    </main>
}

@code {
    [Parameter, EditorRequired] public ListingDetailDto Listing { get; set; } = default!;
    [Parameter] public string? ActiveTab { get; set; }

    /// <summary>
    /// Default mechanics VIP = "overview" (contrato canónico). El contenido
    /// inline (services + analytics) actúa como vista overview hasta que el
    /// UI/UX entregue un OverviewVip dedicado.
    /// </summary>
    private string ResolvedActiveTab => string.IsNullOrEmpty(ActiveTab) ? "overview" : ActiveTab;

    private string SinceLabel => Listing.ApprovedAt is DateTimeOffset dt ? $"Since {dt:MMM yyyy}" : "";

    private (Type? Type, IDictionary<string, object>? Params) ResolveTab(string tab)
    {
        var p = new Dictionary<string, object> { ["Listing"] = Listing };

        return tab switch
        {
            "reviews"   => (typeof(ReviewsRegular), p), // Reviews shared between VIP & Regular
            "settings"  => (typeof(SettingsVip),    p),
            "inquiries" => (typeof(InquiriesVip),   p),
            "photos"    => (typeof(Photos),         p),
            "analytics" => (typeof(AnalyticsTab),   p),

            _           => (null, null),                // default → Services inline
        };
    }
}
