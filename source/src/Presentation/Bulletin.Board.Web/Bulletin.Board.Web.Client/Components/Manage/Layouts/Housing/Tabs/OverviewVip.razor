@* ─────────────────────────────────────────────────────────────────────────────
   OverviewVip (Housing) — Tab Overview para housing VIP.
   KPIs (views, conversion, response, occupancy) + properties at a glance +
   recent activity. Todos los valores reales aterrizan cuando el endpoint
   `GET /api/v1/manage/listings/{id}/overview` exponga `HousingOverviewDto`
   (BACKEND_AUDIT §1.3). Placeholder "—" hasta entonces.
   ───────────────────────────────────────────────────────────────────────────── *@
@namespace Bulletin.Board.Web.Client.Components.Manage.Layouts.Housing.Tabs
@using Bulletin.Board.Web.Client.Models
@using Bulletin.Board.Web.Client.Components.Manage.Shared

@inject IStringLocalizer<SharedResource> _localizer

<style>
    .badge-vip { background: linear-gradient(135deg,#fb923c,#f97316); }
    .vip-glow  { box-shadow: 0 0 0 1px rgba(249,115,22,0.15), 0 8px 24px -8px rgba(249,115,22,0.25); }
</style>

<main class="max-w-6xl mx-auto px-4 py-8 w-full"
      id="panel-overview"
      role="tabpanel"
      aria-labelledby="tab-overview"
      tabindex="0">

    @* KPIs — TODO: API GET /api/v1/manage/listings/{id}/overview (BACKEND_AUDIT §1.3 HousingOverviewDto). *@
    <section aria-label="@_localizer["Manage_Housing_Overview_KpisAria"]"
             class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
        <div class="bg-white rounded-2xl border border-slate-100 shadow-soft p-4 vip-glow">
            <p class="text-[11px] uppercase tracking-wider text-muted font-medium">@_localizer["Manage_Housing_Stat_Views30d"]</p>
            <p class="text-2xl font-bold text-ink mt-1 tabular-nums">—</p>
            <p class="text-[11px] text-muted mt-1">vs prev</p>
        </div>
        <div class="bg-white rounded-2xl border border-slate-100 shadow-soft p-4 vip-glow">
            <p class="text-[11px] uppercase tracking-wider text-muted font-medium">@_localizer["Manage_Housing_Stat_Conversion"]</p>
            <p class="text-2xl font-bold text-ink mt-1 tabular-nums">—</p>
            <p class="text-[11px] text-muted mt-1">@_localizer["Manage_Housing_Overview_ConversionHint"]</p>
        </div>
        <div class="bg-white rounded-2xl border border-slate-100 shadow-soft p-4 vip-glow">
            <p class="text-[11px] uppercase tracking-wider text-muted font-medium">@_localizer["Manage_Housing_Stat_AvgResponse"]</p>
            <p class="text-2xl font-bold text-ink mt-1 tabular-nums">—</p>
            <p class="text-[11px] text-muted mt-1">@_localizer["Manage_Housing_Overview_AutoReplyOn"]</p>
        </div>
        <div class="bg-white rounded-2xl border border-slate-100 shadow-soft p-4 vip-glow">
            <p class="text-[11px] uppercase tracking-wider text-muted font-medium">@_localizer["Manage_Housing_Stat_Occupancy"]</p>
            <p class="text-2xl font-bold text-ink mt-1 tabular-nums">—</p>
            <p class="text-[11px] text-muted mt-1">@_monthLabel</p>
        </div>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">

        @* Properties at a glance — TODO: API GET /api/v1/manage/listings/{id}/properties (BACKEND_AUDIT §1.3 Properties). *@
        <section class="lg:col-span-2 bg-white rounded-3xl border border-slate-100 shadow-soft p-5">
            <h2 class="text-base font-semibold text-ink mb-4">@_localizer["Manage_Housing_Overview_Properties_Title"]</h2>
            <ManageEmptyState Title="@_localizer["Manage_Housing_Overview_Properties_Empty_Title"]"
                              Description="@_localizer["Manage_Housing_Overview_Properties_Empty_Description"]" />
        </section>

        @* Recent activity — TODO: API GET /api/v1/manage/listings/{id}/activity (BACKEND_AUDIT §1.1, vía overview KPIs + inquiries summary). *@
        <aside class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5">
            <h2 class="text-base font-semibold text-ink mb-4">@_localizer["Manage_Housing_Overview_Activity_Title"]</h2>
            <ul class="space-y-3 text-sm" role="list">
                <li class="flex items-start gap-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-300 mt-2" aria-hidden="true"></span>
                    <div>
                        <p class="text-muted">@_localizer["Manage_Housing_Overview_Activity_Empty"]</p>
                    </div>
                </li>
            </ul>
        </aside>
    </div>

    <div class="flex items-center justify-center gap-2 text-[11px] text-muted">
        <span class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded-full badge-vip text-white font-semibold">VIP</span>
        @_localizer["Manage_Housing_VipFooter"]
    </div>
</main>

@code {
    [Parameter, EditorRequired] public ListingDetailDto Listing { get; set; } = default!;

    private string _monthLabel = "";

    protected override void OnInitialized()
    {
        _monthLabel = DateTime.Today.ToString("MMM yyyy");
    }
}
