@* ─────────────────────────────────────────────────────────────────────────────
   HousingManageRegular — Container Regular/Verified para housing.
   Dispatcher de tabs vía DynamicComponent. Tab por defecto = Properties
   (Properties es la "Overview" de housing: lo que el provider gestiona).

   Tabs soportados:
     - properties (default)
     - photos      → Tabs/PhotosRegular
     - reviews     → Tabs/ReviewsRegular
     - inquiries   → (UI vacía — endpoints pendientes, BACKEND_AUDIT §1.3)

   Reglas embebidas:
     #4 (Photos) — PhotoStatusBadge + banner GM-decides en PhotosRegular.
     #5 (Edición → Pending) — PendingReviewTooltip en cada botón mutador.
     #7 (Reviews) — ReviewStatusBadge + reply moderation en ReviewsRegular.
     #8 (Inquiries) — GmCopyNotice (cuando se materialice la tab Inquiries).
   ───────────────────────────────────────────────────────────────────────────── *@
@using Bulletin.Board.Web.Client.Models
@using Bulletin.Board.Web.Client.Components.Shared
@using Bulletin.Board.Web.Client.Components.Buttons
@using Bulletin.Board.Web.Client.Components.Manage.Layouts.Housing.Tabs

@inject IStringLocalizer<SharedResource> _localizer

<style>
    .badge-vip { background: linear-gradient(135deg,#fb923c,#f97316); }
    .card-hover { transition: transform 0.35s cubic-bezier(0.32,0.72,0,1), box-shadow 0.35s; }
    .card-hover:hover { transform:translateY(-2px); box-shadow:0 12px 40px -8px rgba(30,41,59,0.14); }
    @@media (prefers-reduced-motion: reduce) { *,*::before,*::after { animation-duration:0.01ms!important; transition-duration:0.01ms!important; } }
</style>

<ManageDetailHeader ListingId="@Listing.Id.ToString()"
                    ListingTitle="@Listing.TitleEn"
                    CategorySlug="@Listing.CategorySlug"
                    ActiveTab="@ResolvedActiveTab"
                    Status="@Listing.Status"
                    TierBadge="@Listing.Tier"
                    CategoryLabel="@(_localizer["Manage_Housing_CategoryLabel"])"
                    Since="@SinceLabel"
                    PublicUrl="@($"/listing/{Listing.Id}")"
                    PhotoCount="@Listing.Photos.Length" />

@{
    var (tabType, tabParams) = ResolveTab(ResolvedActiveTab);
}
@if (tabType is not null)
{
    <DynamicComponent Type="tabType" Parameters="tabParams" />
}
else
{
    @* Tab por defecto: Properties (contenido v2 conservado) *@
    <main class="max-w-6xl mx-auto px-4 py-8 w-full"
          id="panel-properties"
          role="tabpanel"
          aria-labelledby="tab-properties"
          tabindex="0">

        <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
            <div>
                <h2 class="text-base font-semibold text-ink">@_localizer["Manage_Housing_Properties_Title"]</h2>
                <p class="text-sm text-muted mt-0.5">@_localizer["Manage_Housing_Properties_Subtitle"]</p>
            </div>
            <ManageLinkButton Href="@($"/manage/{Listing.Id}/properties/new")"
                              Variant="Primary"
                              Size="Small"
                              aria-label="@_localizer["Manage_Housing_AddProperty"]">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                @_localizer["Manage_Housing_AddProperty"]
            </ManageLinkButton>
        </div>

        @* Properties list — TODO: API GET /api/v1/manage/listings/{id}/properties (BACKEND_AUDIT §1.3). *@
        <ul class="space-y-4" role="list" aria-label="@_localizer["Manage_Housing_Properties_AriaLabel"]">

            <li class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5 card-hover">
                <div class="flex items-start justify-between gap-4 flex-wrap">
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h3 class="font-semibold text-ink">@Listing.TitleEn</h3>
                            @if (Listing.Status == "Approved")
                            {
                                <span class="text-[10px] uppercase tracking-wider bg-green-100 text-green-700 px-2 py-0.5 rounded-full">@_localizer["Manage_Housing_Status_Approved"]</span>
                            }
                        </div>
                        <p class="text-muted text-xs mt-0.5">@Listing.Location</p>
                        @if (Listing.DailyRate.HasValue)
                        {
                            <p class="text-ink text-sm mt-1 font-medium">@Listing.DailyRate.Value.ToString("C0")/@_localizer["Manage_Housing_PerNight"]</p>
                        }
                        <p class="text-sm text-ink mt-2 leading-relaxed line-clamp-2">@Listing.DescriptionEn</p>
                    </div>
                    <div class="flex items-center gap-1 flex-wrap">
                        @* Regla #5: edición vuelve a Pending. *@
                        <ManageLinkButton Href="@($"/manage/{Listing.Id}/edit")"
                                          Variant="Default"
                                          Size="Compact"
                                          data-tooltip="@_localizer["Banner_EditingReturnsPending"]">
                            @_localizer["Manage_Common_Edit"]
                        </ManageLinkButton>
                    </div>
                </div>

                @if (Listing.Photos.Length > 0)
                {
                    <div class="mt-4 grid grid-cols-3 sm:grid-cols-5 gap-2">
                        @foreach (var p in Listing.Photos.Take(5))
                        {
                            <div class="aspect-[4/3] rounded-xl overflow-hidden bg-slate-100">
                                <img src="@p.Url" alt="@p.AltText" class="w-full h-full object-cover" loading="lazy" />
                            </div>
                        }
                    </div>
                }
            </li>

            @* VIP upsell *@
            <li>
                <VipUpsellBanner Tier="@Listing.Tier"
                                 Title="@_localizer["Manage_Housing_VipUpsell_Title"]">
                    @_localizer["Manage_Housing_VipUpsell_Body"]
                </VipUpsellBanner>
            </li>
        </ul>
    </main>
}

@code {
    [Parameter, EditorRequired] public ListingDetailDto Listing { get; set; } = default!;

    /// <summary>
    /// Tab activo según ManageDetailHeader (keys canónicas — ver matriz en ese componente).
    /// Si es null/empty se cae a "properties" (default housing).
    /// </summary>
    [Parameter] public string? ActiveTab { get; set; }

    /// <summary>
    /// Default housing Regular = "overview" (contrato de matriz canónica:
    /// Overview siempre es el tab por defecto). El contenido inline del
    /// container actúa como "vista overview" — properties listing — hasta
    /// que se materialice un OverviewRegular dedicado.
    /// </summary>
    private string ResolvedActiveTab => string.IsNullOrEmpty(ActiveTab) ? "overview" : ActiveTab;

    private string SinceLabel => Listing.ApprovedAt is DateTimeOffset dt ? $"Since {dt:MMM yyyy}" : "";

    /// <summary>
    /// Dispatcher tab → componente. Devolver (null, null) significa "renderizar el tab por defecto
    /// inline en este container". Mantiene las hrefs del header funcionales mediante segunda capa
    /// de routing en /Pages/Manage/ManageDetailOverview.razor.
    /// </summary>
    private (Type? Type, IDictionary<string, object>? Params) ResolveTab(string tab)
    {
        var p = new Dictionary<string, object> { ["Listing"] = Listing };

        return tab switch
        {
            "photos"    => (typeof(PhotosRegular),    p),
            "reviews"   => (typeof(ReviewsRegular),   p),
            "settings"  => (typeof(SettingsRegular),  p),
            "inquiries" => (typeof(InquiriesRegular), p),

            _           => (null, null), // default → render inline (overview / properties)
        };
    }
}
