@* ─────────────────────────────────────────────────────────────────────────────
   PhotosRegular (Housing) — Tab Photos para housing Regular/Verified.
   Regla #4: el GM decide qué fotos son públicas. Cada upload nuevo vuelve la
   foto a estado Pending; cualquier edición vuelve el listing a Pending (#5).

   Datos: placeholder ("—") hasta que aterricen los endpoints. Ver
   design/mockups/manage/v3/_BACKEND_AUDIT.md §1.1 Tab Photos.
   ───────────────────────────────────────────────────────────────────────────── *@
@namespace Bulletin.Board.Web.Client.Components.Manage.Layouts.Housing.Tabs
@using Bulletin.Board.Web.Client.Models
@using Bulletin.Board.Web.Client.Components.Manage.Shared

@inject IStringLocalizer<SharedResource> _localizer

<main class="max-w-6xl mx-auto px-4 py-8 w-full"
      id="panel-photos"
      role="tabpanel"
      aria-labelledby="tab-photos"
      tabindex="0">

    <div class="flex items-start justify-between gap-4 flex-wrap mb-5">
        <div>
            <h2 class="text-base font-semibold text-ink">@_localizer["Manage_Housing_Photos_Title"]</h2>
            <p class="text-sm text-muted mt-0.5">@_localizer["Manage_Housing_Photos_Subtitle_Regular"]</p>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
            <select class="px-3 py-1.5 rounded-xl border border-slate-200 text-xs text-ink bg-white"
                    aria-label="@_localizer["Manage_Housing_Photos_FilterByProperty"]"
                    disabled>
                @* TODO: API GET /api/v1/manage/listings/{id}/properties (BACKEND_AUDIT §1.3 Properties). *@
                <option>@_localizer["Manage_Housing_Photos_AllProperties"]</option>
            </select>
            <PendingReviewTooltip>
                <label class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-brand-500 hover:bg-brand-600 text-white text-xs font-semibold cursor-pointer transition-colors duration-150">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    @_localizer["Manage_Housing_Photos_Upload"]
                    @* TODO: API POST /api/v1/manage/listings/{id}/photos (BACKEND_AUDIT §1.1). Status=Pending por defecto. *@
                    <input type="file" multiple accept="image/jpeg,image/png,image/webp" class="sr-only" />
                </label>
            </PendingReviewTooltip>
        </div>
    </div>

    @* Regla #4 banner *@
    <div class="mb-6 flex items-start gap-3 px-4 py-3 rounded-2xl bg-amber-50 border border-amber-200" role="note">
        <svg class="w-4 h-4 text-amber-700 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <p class="text-xs text-ink leading-relaxed">@_localizer["Banner_GmDecidesPhotos"]</p>
    </div>

    @* Filter pills por status — counts placeholder hasta API. *@
    <div class="flex items-center gap-1.5 flex-wrap mb-5" role="group" aria-label="@_localizer["Manage_Photos_Filter_AriaLabel"]">
        <button type="button" class="px-3 py-1.5 rounded-full text-xs font-medium bg-ink text-white cursor-pointer" aria-pressed="true">
            @_localizer["Manage_Common_All"]
            <span class="ml-1 bg-white/20 px-1.5 rounded-full tabular-nums">@(_photos.Length)</span>
        </button>
        <button type="button" class="px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 hover:bg-slate-200 text-ink cursor-pointer">
            @_localizer["Photo_Status_Public"]
            <span class="ml-1 bg-green-100 text-green-800 px-1.5 rounded-full tabular-nums">@(_publicCount)</span>
        </button>
        <button type="button" class="px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 hover:bg-slate-200 text-ink cursor-pointer">
            @_localizer["Photo_Status_Pending"]
            <span class="ml-1 bg-amber-100 text-amber-800 px-1.5 rounded-full tabular-nums">—</span>
        </button>
        <button type="button" class="px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 hover:bg-slate-200 text-ink cursor-pointer">
            @_localizer["Photo_Status_Hidden"]
            <span class="ml-1 bg-slate-200 text-slate-700 px-1.5 rounded-full tabular-nums">—</span>
        </button>
    </div>

    @if (_photos.Length == 0)
    {
        <ManageEmptyState Title="@_localizer["Manage_Housing_Photos_Empty_Title"]"
                          Description="@_localizer["Manage_Housing_Photos_Empty_Description"]" />
    }
    else
    {
        @* Por ahora una sola sección con todas las fotos públicas. Cuando aterrice
           `GET /properties` se agrupará por propiedad (mockup multi-property). *@
        <section class="mb-8">
            <h3 class="text-sm font-semibold text-ink mb-3">
                @Listing.TitleEn
                <span class="text-muted font-normal">· @string.Format(_localizer["Manage_Housing_Photos_SlotsUsed"], _photos.Length, 10)</span>
            </h3>
            <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" role="list">
                @foreach (var (photo, idx) in _photos.Select((p, i) => (p, i)))
                {
                    <li class="bg-white rounded-2xl border border-slate-100 shadow-soft overflow-hidden">
                        <div class="relative aspect-[4/3] bg-slate-200">
                            <img src="@photo.Url" alt="@photo.AltText" class="w-full h-full object-cover" loading="lazy" />
                            <div class="absolute top-2 left-2">
                                @* ListingDetailDto.Photos ya viene filtrado a públicas (Regla #4 / mapper). *@
                                <PhotoStatusBadge Status="Public" />
                            </div>
                            @if (idx == 0)
                            {
                                <span class="absolute top-2 right-2 text-[10px] uppercase tracking-wider bg-brand-500 text-white px-2 py-0.5 rounded-full font-semibold">
                                    @_localizer["Manage_Housing_Photos_Cover"]
                                </span>
                            }
                        </div>
                        <div class="p-3 flex items-center justify-between gap-2">
                            <span class="text-[11px] text-muted truncate">@(photo.AltText ?? "")</span>
                            <PendingReviewTooltip>
                                <button type="button"
                                        class="text-[11px] text-red-600 hover:text-red-700 cursor-pointer">
                                    @* TODO: API DELETE /api/v1/manage/listings/{id}/photos/{photoId} (BACKEND_AUDIT §1.1). *@
                                    @_localizer["Manage_Common_Remove"]
                                </button>
                            </PendingReviewTooltip>
                        </div>
                    </li>
                }
            </ul>
        </section>
    }

    @* VIP upsell — solo aparece si tier != VIP. *@
    <VipUpsellBanner Tier="@Listing.Tier"
                     Title="@_localizer["Manage_Housing_Photos_Vip_Title"]">
        @_localizer["Manage_Housing_Photos_Vip_Body"]
    </VipUpsellBanner>
</main>

@code {
    [Parameter, EditorRequired] public ListingDetailDto Listing { get; set; } = default!;

    // Las fotos en ListingDetailDto vienen pre-filtradas a Public por el mapper (Regla #4).
    // Cuando aterrice GET /api/v1/manage/listings/{id}/photos (BACKEND_AUDIT §1.1) el provider
    // verá también Pending/Hidden/Rejected con sus respectivos badges via PhotoStatusBadge.
    private ListingPhotoDto[] _photos = Array.Empty<ListingPhotoDto>();
    private int _publicCount;

    protected override void OnParametersSet()
    {
        _photos = Listing.Photos;
        _publicCount = _photos.Length;
    }
}
