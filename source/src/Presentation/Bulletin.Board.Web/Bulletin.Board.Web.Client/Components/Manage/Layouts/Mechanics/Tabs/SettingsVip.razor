@* SettingsVip (Mechanics) — Regular + VIP additions:
   Auto-reply templates, Quiet hours, Reply SLA, Promotion windows, Analytics export,
   Coverage radius (content), Free-quote badge visibility (safe),
   Emergency surcharge disclaimer (content). *@
@namespace Bulletin.Board.Web.Client.Components.Manage.Layouts.Mechanics.Tabs
@using Bulletin.Board.Web.Client.Models
@using Bulletin.Board.Web.Client.Components.Manage.Shared
@inject IStringLocalizer<SharedResource> _localizer

<main class="max-w-3xl mx-auto px-4 py-8 w-full" id="panel-settings" role="tabpanel" aria-labelledby="tab-settings" tabindex="0">

    <div class="mb-6 flex items-start gap-3 px-4 py-3 rounded-2xl bg-amber-50 border border-amber-200" role="alert">
        <svg class="w-4 h-4 text-amber-700 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
        <p class="text-xs text-ink leading-relaxed">@_localizer["Manage_Settings_Banner_Mixed"]</p>
    </div>

    <section class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5 mb-6">
        <SettingsSectionHeader Title="@(_localizer["Manage_Settings_Visibility_Title"])" PillType="safe" />
        <label class="flex items-start justify-between gap-3"><span><span class="text-sm text-ink font-medium block">@_localizer["Manage_Settings_Visibility_Pause"]</span></span><ToggleSwitch /></label>
    </section>

    <section class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5 mb-6">
        <SettingsSectionHeader Title="@(_localizer["Manage_Settings_Details_Title"])" PillType="content" />
        <BilingualInput LabelKey="Manage_Settings_Field_Title" ValueEn="@Listing.TitleEn" ValueEs="@Listing.TitleEs" />
        <div class="mt-4"><BilingualInput LabelKey="Manage_Settings_Field_Description" Multiline="true" Rows="3" ValueEn="@Listing.DescriptionEn" ValueEs="@Listing.DescriptionEs" /></div>
    </section>

    <section class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5 mb-6">
        <SettingsSectionHeader Title="@(_localizer["Manage_Settings_Contact_Title"])" PillType="content" />
        <div class="space-y-4">
            <div><label class="block text-xs font-semibold text-ink mb-1.5">@_localizer["Manage_Settings_Contact_Whatsapp"]</label><input type="tel" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" /></div>
            <div><label class="block text-xs font-semibold text-ink mb-1.5">@_localizer["Manage_Settings_Contact_Email"]</label><input type="email" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" /></div>
        </div>
    </section>

    <section class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5 mb-6">
        <SettingsSectionHeader Title="@(_localizer["Manage_Settings_Notifications_Title"])" PillType="safe" />
        <div class="space-y-3">
            <label class="flex items-center justify-between gap-3"><span class="text-sm text-ink">@_localizer["Manage_Settings_Mechanics_Notif_QuoteRequests"]</span><ToggleSwitch Checked="true" /></label>
            <label class="flex items-center justify-between gap-3"><span class="text-sm text-ink">@_localizer["Manage_Settings_Notif_Email_NewReview"]</span><ToggleSwitch Checked="true" /></label>
            <div class="mt-2"><GmCopyNotice /></div>
        </div>
    </section>

    <section class="bg-white rounded-3xl border border-vip-100 shadow-soft p-5 mb-6">
        <SettingsSectionHeader Title="@(_localizer["Manage_Settings_VipAutoReply_Title"])" PillType="content" IsVipSection="true" />
        <p class="text-xs text-muted">@_localizer["Manage_Common_NotConfigured"]</p>
    </section>

    <section class="bg-white rounded-3xl border border-vip-100 shadow-soft p-5 mb-6">
        <SettingsSectionHeader Title="@(_localizer["Manage_Settings_VipQuietHours_Title"])" PillType="safe" IsVipSection="true" />
        <div class="grid grid-cols-2 gap-3 max-w-sm">
            <div><label class="block text-[11px] font-semibold text-ink mb-1">@_localizer["Manage_Settings_VipQuietHours_From"]</label><input type="time" value="19:00" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-ink mb-1">@_localizer["Manage_Settings_VipQuietHours_To"]</label><input type="time" value="07:00" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" /></div>
        </div>
    </section>

    <section class="bg-white rounded-3xl border border-vip-100 shadow-soft p-5 mb-6">
        <SettingsSectionHeader Title="@(_localizer["Manage_Settings_VipSla_Title"])" PillType="safe" IsVipSection="true" />
        <div class="flex items-center gap-3 flex-wrap">
            <input type="number" value="45" class="w-24 rounded-xl border border-slate-200 px-3 py-2 text-sm" />
            <span class="text-sm text-muted">@_localizer["Manage_Settings_VipSla_Minutes"]</span>
        </div>
    </section>

    <section class="bg-white rounded-3xl border border-vip-100 shadow-soft p-5 mb-6">
        <SettingsSectionHeader Title="@(_localizer["Manage_Settings_VipPromotion_Title"])" PillType="content" IsVipSection="true" />
        <p class="text-xs text-muted">@_localizer["Manage_Common_NotConfigured"]</p>
    </section>

    <section class="bg-white rounded-3xl border border-vip-100 shadow-soft p-5 mb-6">
        <SettingsSectionHeader Title="@(_localizer["Manage_Settings_VipAnalytics_Title"])" PillType="safe" IsVipSection="true" />
        <label class="flex items-center justify-between gap-3"><span class="text-sm text-ink">@_localizer["Manage_Settings_VipAnalytics_Weekly"]</span><ToggleSwitch Checked="true" /></label>
    </section>

    @* Mechanics-specific VIP: Coverage radius *@
    <section class="bg-white rounded-3xl border border-vip-100 shadow-soft p-5 mb-6">
        <SettingsSectionHeader Title="@(_localizer["Manage_Settings_Mechanics_Vip_Coverage_Title"])"
                               Subtitle="@(_localizer["Manage_Settings_Mechanics_Vip_Coverage_Subtitle"])"
                               PillType="content" IsVipSection="true" />
        <div class="flex items-center gap-3 flex-wrap">
            <input type="number" value="40" min="0" max="200" class="w-24 rounded-xl border border-slate-200 px-3 py-2 text-sm" />
            <span class="text-sm text-muted">@_localizer["Manage_Settings_Mechanics_Vip_Coverage_Suffix"]</span>
        </div>
    </section>

    @* Mechanics-specific VIP: Free-quote badge *@
    <section class="bg-white rounded-3xl border border-vip-100 shadow-soft p-5 mb-6">
        <SettingsSectionHeader Title="@(_localizer["Manage_Settings_Mechanics_Vip_FreeQuote_Title"])"
                               Subtitle="@(_localizer["Manage_Settings_Mechanics_Vip_FreeQuote_Subtitle"])"
                               PillType="safe" IsVipSection="true" />
        <label class="flex items-center justify-between gap-3"><span class="text-sm text-ink">@_localizer["Manage_Settings_Mechanics_Vip_FreeQuote_Toggle"]</span><ToggleSwitch Checked="true" /></label>
    </section>

    @* Mechanics-specific VIP: Emergency surcharge *@
    <section class="bg-white rounded-3xl border border-vip-100 shadow-soft p-5 mb-6">
        <SettingsSectionHeader Title="@(_localizer["Manage_Settings_Mechanics_Vip_Emergency_Title"])"
                               Subtitle="@(_localizer["Manage_Settings_Mechanics_Vip_Emergency_Subtitle"])"
                               PillType="content" IsVipSection="true" />
        <BilingualInput LabelKey="Manage_Settings_Mechanics_Vip_Emergency_Text" Multiline="true" Rows="2" />
    </section>

    <div class="sticky bottom-4 z-10 bg-white rounded-3xl border border-slate-200 shadow-soft p-4 flex items-center justify-between gap-3 flex-wrap">
        <p class="text-[11px] text-muted leading-relaxed flex-1 min-w-[200px]"><strong class="text-ink">@_localizer["Manage_Settings_Save_Content_Title"]</strong> @_localizer["Manage_Settings_Save_Mixed_Body"]</p>
        <div class="flex items-center gap-2">
            <button type="button" class="text-xs px-3 py-2 rounded-xl border border-slate-200 hover:border-slate-300 text-ink cursor-pointer">@_localizer["Manage_Common_Cancel"]</button>
            <PendingReviewTooltip><button type="button" class="text-xs px-4 py-2 rounded-xl bg-brand-500 hover:bg-brand-600 text-white font-semibold cursor-pointer">@_localizer["Manage_Common_SaveChanges"]</button></PendingReviewTooltip>
        </div>
    </div>

    <DangerZoneCard Subtitle="@(_localizer["Manage_Settings_Mechanics_Danger_Subtitle"])" />
</main>

@code {
    [Parameter, EditorRequired] public ListingDetailDto Listing { get; set; } = default!;
}
