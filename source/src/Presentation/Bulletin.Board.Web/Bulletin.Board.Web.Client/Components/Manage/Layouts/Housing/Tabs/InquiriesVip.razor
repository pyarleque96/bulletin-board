@* ─────────────────────────────────────────────────────────────────────────────
   InquiriesVip (Housing) — Tab Inquiries para housing VIP.
   Diferencia vs Regular: KPIs (response rate, avg first reply, conversion),
   auto-reply toggle, filtros adicionales por property y reply templates.

   Regla #8: el GM recibe copia email de toda interacción cliente↔provider.
   Cualquier WhatsApp se loguea en ContactLog vía POST /inquiries/{id}/mark-contacted.

   Datos placeholder hasta que aterricen los endpoints. Ver BACKEND_AUDIT §1.3
   Tab Inquiries.
   ───────────────────────────────────────────────────────────────────────────── *@
@namespace Bulletin.Board.Web.Client.Components.Manage.Layouts.Housing.Tabs
@using Bulletin.Board.Web.Client.Models
@using Bulletin.Board.Web.Client.Components.Manage.Shared

@inject IStringLocalizer<SharedResource> _localizer

<style>
    .badge-vip { background: linear-gradient(135deg,#fb923c,#f97316); }
</style>

<main class="max-w-6xl mx-auto px-4 py-8 w-full"
      id="panel-inquiries"
      role="tabpanel"
      aria-labelledby="tab-inquiries"
      tabindex="0">

    @* KPIs — TODO: API GET /api/v1/manage/listings/{id}/inquiries/summary (BACKEND_AUDIT §1.3). *@
    <section aria-label="@_localizer["Manage_Housing_Inquiries_KpisAria"]"
             class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
        <KpiCard Label="@_localizer["Manage_Housing_Inquiries_OpenCount"]" Value="—" />
        <KpiCard Label="@_localizer["Manage_Housing_Inquiries_ResponseRate"]" Value="—" />
        <KpiCard Label="@_localizer["Manage_Housing_Inquiries_AvgFirstReply"]" Value="—" />
        <KpiCard Label="@_localizer["Manage_Housing_Inquiries_BookingConversion"]" Value="—" />
    </section>

    @* Auto-reply card (VIP feature) — TODO: API GET/PATCH /api/v1/manage/listings/{id}/auto-reply (BACKEND_AUDIT §1.3 — endpoint VIP). *@
    <div class="mb-5 bg-white rounded-3xl border border-slate-100 shadow-soft p-5">
        <div class="flex items-start justify-between gap-3 flex-wrap">
            <div class="flex-1 min-w-[240px]">
                <h3 class="text-sm font-semibold text-ink inline-flex items-center gap-2">
                    @_localizer["Manage_Housing_Inquiries_AutoReply_Title"]
                    <span class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded-full badge-vip text-white font-semibold">VIP</span>
                </h3>
                <p class="text-xs text-muted mt-0.5">@_localizer["Manage_Housing_Inquiries_AutoReply_Subtitle"]</p>
                <p class="text-[11px] text-ink mt-2 bg-slate-50 rounded-xl px-3 py-2 border border-slate-100">
                    <em>@_localizer["Manage_Housing_Inquiries_AutoReply_Placeholder"]</em>
                </p>
            </div>
            <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="sr-only peer" disabled />
                <span class="w-10 h-6 bg-slate-200 peer-checked:bg-brand-500 rounded-full relative transition-colors">
                    <span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full transition-transform peer-checked:translate-x-4"></span>
                </span>
                <span class="text-xs font-medium text-ink">@_localizer["Manage_Common_Disabled"]</span>
            </label>
        </div>
    </div>

    @* GM-copy notice (Regla #8) *@
    <div class="mb-5">
        <GmCopyNotice />
    </div>

    @* Filtros — UI estática hasta tener data real. *@
    <div class="flex items-center gap-1.5 flex-wrap mb-5" role="group" aria-label="@_localizer["Manage_Inquiries_Filter_AriaLabel"]">
        <button type="button" class="px-3 py-1.5 rounded-full text-xs font-medium bg-ink text-white cursor-pointer" aria-pressed="true">
            @_localizer["Manage_Common_All"]
        </button>
        <button type="button" class="px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 hover:bg-slate-200 text-ink cursor-pointer">
            @_localizer["Manage_Housing_Inquiries_Filter_New"]
        </button>
        <button type="button" class="px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 hover:bg-slate-200 text-ink cursor-pointer">
            @_localizer["Manage_Housing_Inquiries_Filter_AutoReplied"]
        </button>
        <button type="button" class="px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 hover:bg-slate-200 text-ink cursor-pointer">
            @_localizer["Manage_Housing_Inquiries_Filter_Replied"]
        </button>
        <select class="px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 text-ink border-0"
                aria-label="@_localizer["Manage_Housing_Photos_FilterByProperty"]"
                disabled>
            @* TODO: API GET /api/v1/manage/listings/{id}/properties (BACKEND_AUDIT §1.3). *@
            <option>@_localizer["Manage_Housing_Photos_AllProperties"]</option>
        </select>
    </div>

    @* Lista de inquiries — TODO: API GET /api/v1/manage/listings/{id}/inquiries (BACKEND_AUDIT §1.3). *@
    <ManageEmptyState Title="@_localizer["Manage_Housing_Inquiries_Empty_Title"]"
                      Description="@_localizer["Manage_Housing_Inquiries_Empty_Description"]" />

    <div class="mt-10 flex items-center justify-center gap-2 text-[11px] text-muted">
        <span class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded-full badge-vip text-white font-semibold">VIP</span>
        @_localizer["Manage_Housing_Inquiries_VipFooter"]
    </div>
</main>

@code {
    [Parameter, EditorRequired] public ListingDetailDto Listing { get; set; } = default!;
}
