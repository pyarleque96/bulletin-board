@* ─────────────────────────────────────────────────────────────────────────────
   TransportationManageRegular — Container Regular/Verified para transport.
   Dispatcher tabs vía DynamicComponent. Default tab = "routes" (single active
   route + pricing breakdown). Multi-route llega en VIP.

   Tabs:
     - routes (default — inline v2 content).
     - reservations → Tabs/ReservationsRegular
     - reviews      → Tabs/ReviewsRegular

   Note: ManageDetailHeader normaliza "transportation" → "transport" y por eso el
   header espera ese slug para mostrar los tabs. Mantenemos `HeaderCategorySlug`.

   Reglas embebidas: #5 (PendingReviewTooltip en mutadores), #7 (Reviews tab),
   #8 (GmCopyNotice + WhatsAppCtaButton en Reservations tab).
   ───────────────────────────────────────────────────────────────────────────── *@
@using Bulletin.Board.Web.Client.Models
@using Bulletin.Board.Web.Client.Components.Shared
@using Bulletin.Board.Web.Client.Components.Manage.Shared
@using Bulletin.Board.Web.Client.Components.Manage.Layouts.Transportation.Tabs

@inject IStringLocalizer<SharedResource> _localizer

<style>
    .badge-vip { background: linear-gradient(135deg,#fb923c,#f97316); }
    .card-hover { transition: transform 0.35s cubic-bezier(0.32,0.72,0,1), box-shadow 0.35s; }
    .card-hover:hover { transform:translateY(-2px); box-shadow:0 12px 40px -8px rgba(30,41,59,0.14); }
    @@media (prefers-reduced-motion: reduce) { *,*::before,*::after { animation-duration:0.01ms!important; transition-duration:0.01ms!important; } }
</style>

<ManageDetailHeader ListingId="@Listing.Id.ToString()"
                    ListingTitle="@Listing.TitleEn"
                    CategorySlug="@HeaderCategorySlug"
                    ActiveTab="@ResolvedActiveTab"
                    Status="@Listing.Status"
                    TierBadge="@Listing.Tier"
                    CategoryLabel="@(_localizer["Manage_Transportation_CategoryLabel"])"
                    Since="@SinceLabel"
                    PublicUrl="@($"/listing/{Listing.Id}")" />

@{
    var (tabType, tabParams) = ResolveTab(ResolvedActiveTab);
}
@if (tabType is not null)
{
    <DynamicComponent Type="tabType" Parameters="tabParams" />
}
else
{
    @* Default tab = Routes (v2 single-route content kept inline). *@
    <main class="max-w-6xl mx-auto px-4 py-8 w-full"
          id="panel-routes"
          role="tabpanel"
          aria-labelledby="tab-routes"
          tabindex="0">

        <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
            <div>
                <h2 class="text-base font-semibold text-ink">@_localizer["Manage_Transportation_Routes_Title"]</h2>
                <p class="text-sm text-muted mt-0.5">@_localizer["Manage_Transportation_Routes_Subtitle_Regular"]</p>
            </div>
        </div>

        <ul class="space-y-4" role="list" aria-label="@_localizer["Manage_Transportation_Routes_AriaLabel"]">

            @* Single active route — built from listing data; multi-route arrives at VIP *@
            <li class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5 card-hover">
                <div class="flex items-start justify-between gap-4 flex-wrap">
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h3 class="font-semibold text-ink inline-flex items-center gap-2">
                                <span>@Listing.TitleEn</span>
                            </h3>
                            @if (Listing.Status == "Approved")
                            {
                                <span class="text-[10px] uppercase tracking-wider bg-green-100 text-green-700 px-2 py-0.5 rounded-full">active</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Listing.Location))
                        {
                            <p class="text-muted text-xs mt-0.5">@Listing.Location</p>
                        }
                        @if (Listing.DailyRate.HasValue)
                        {
                            <p class="text-ink text-sm mt-1 font-medium">@Listing.DailyRate.Value.ToString("C0") @_localizer["Manage_Transportation_PerRide"]</p>
                        }
                    </div>
                    <div class="flex items-center gap-1 flex-wrap">
                        <PendingReviewTooltip>
                            <button type="button" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-ink text-xs font-medium transition-colors duration-150 cursor-pointer">@_localizer["Manage_Common_Edit"]</button>
                        </PendingReviewTooltip>
                        <PendingReviewTooltip>
                            <button type="button" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-ink text-xs font-medium transition-colors duration-150 cursor-pointer">@_localizer["Manage_Transportation_Deactivate"]</button>
                        </PendingReviewTooltip>
                    </div>
                </div>

                @* Pricing breakdown *@
                <div class="mt-5 border-t border-slate-100 pt-4">
                    <h4 class="text-sm font-semibold text-ink mb-3">@_localizer["Manage_Transportation_Pricing"]</h4>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                        <div class="rounded-2xl border border-slate-100 px-4 py-3">
                            <p class="text-[11px] uppercase tracking-wider text-muted">@_localizer["Manage_Transportation_BaseFare"]</p>
                            <p class="text-lg font-bold text-ink mt-0.5 tabular-nums">@(Listing.DailyRate?.ToString("C0") ?? "—")</p>
                        </div>
                        <div class="rounded-2xl border border-slate-100 px-4 py-3">
                            <p class="text-[11px] uppercase tracking-wider text-muted">@_localizer["Manage_Transportation_ExtraPassenger"]</p>
                            <p class="text-lg font-bold text-ink mt-0.5 tabular-nums">—</p>
                        </div>
                        <div class="rounded-2xl border border-slate-100 px-4 py-3">
                            <p class="text-[11px] uppercase tracking-wider text-muted">@_localizer["Manage_Transportation_LuggageXl"]</p>
                            <p class="text-lg font-bold text-ink mt-0.5 tabular-nums">—</p>
                        </div>
                    </div>
                </div>
            </li>

            @* TierGate *@
            <li class="rounded-3xl border border-amber-200 bg-gradient-to-r from-amber-50 to-orange-50 p-6">
                <div class="flex items-start gap-4 flex-wrap">
                    <div class="flex-shrink-0 w-11 h-11 rounded-2xl bg-white border border-amber-200 flex items-center justify-center shadow-soft">
                        <svg class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h3 class="text-sm font-semibold text-ink">@_localizer["Manage_Transportation_VipUpsell_Title"]</h3>
                            <span class="text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-full badge-vip text-white font-semibold">VIP</span>
                        </div>
                        <p class="text-sm text-amber-900 mt-1 leading-relaxed max-w-2xl">@_localizer["Manage_Transportation_VipUpsell_Body"]</p>
                        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1 mt-3 text-xs text-amber-900">
                            @foreach (var bullet in new[] {
                                        _localizer["Manage_Transportation_VipUpsell_Bullet_Unlimited"].Value,
                                        _localizer["Manage_Transportation_VipUpsell_Bullet_Dynamic"].Value,
                                        _localizer["Manage_Transportation_VipUpsell_Bullet_Analytics"].Value,
                                        _localizer["Manage_Transportation_VipUpsell_Bullet_Badge"].Value })
                            {
                                <li class="flex items-center gap-1.5">
                                    <svg class="w-3.5 h-3.5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <polyline points="20 6 9 17 4 12"/>
                                    </svg>
                                    @bullet
                                </li>
                            }
                        </ul>
                        <div class="flex items-center gap-2 mt-4 flex-wrap">
                            <a href="/verification" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-2xl bg-ink hover:bg-slate-800 text-white text-xs font-semibold transition-colors duration-150 cursor-pointer no-underline">
                                @_localizer["Manage_VipUpsell_GetVerified"]
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                            </a>
                            <a href="/about/vip" class="text-xs text-amber-900 hover:text-ink font-medium underline-offset-2 hover:underline">@_localizer["Manage_VipUpsell_LearnMore"]</a>
                        </div>
                    </div>
                </div>
            </li>
        </ul>
    </main>
}

@code {
    [Parameter, EditorRequired] public ListingDetailDto Listing { get; set; } = default!;
    [Parameter] public string? ActiveTab { get; set; }

    /// <summary>
    /// Default transport Regular = "overview" (contrato canónico). El contenido
    /// inline (routes list) actúa como vista overview hasta que el UI/UX entregue
    /// un OverviewRegular dedicado.
    /// </summary>
    private string ResolvedActiveTab => string.IsNullOrEmpty(ActiveTab) ? "overview" : ActiveTab;

    private string SinceLabel => Listing.ApprovedAt is DateTimeOffset dt ? $"Since {dt:MMM yyyy}" : "";

    // The existing ManageDetailHeader keys its tabs on "transport" (legacy slug).
    private string HeaderCategorySlug =>
        string.Equals(Listing.CategorySlug, "transportation", StringComparison.OrdinalIgnoreCase)
            ? "transport"
            : Listing.CategorySlug;

    private (Type? Type, IDictionary<string, object>? Params) ResolveTab(string tab)
    {
        var p = new Dictionary<string, object> { ["Listing"] = Listing };

        return tab switch
        {
            "reservations" => (typeof(ReservationsRegular), p),
            "reviews"      => (typeof(ReviewsRegular),      p),
            "settings"     => (typeof(SettingsRegular),     p),
            "inquiries"    => (typeof(InquiriesRegular),    p),
            "photos"       => (typeof(Photos),              p),

            _              => (null, null), // default → Routes inline (overview)
        };
    }
}
