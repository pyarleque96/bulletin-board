@* ─────────────────────────────────────────────────────────────────────────────
   MechanicsManageRegular — Container Regular/Verified para mechanics. Dispatcher
   tabs vía DynamicComponent. Default tab = "services" (Services es el catálogo
   principal para mechanics).

   Tabs:
     - services (default — inline v2: lista flat de servicios + VIP upsell).
                  La variante mejorada con grouping vive en Tabs/ServicesRegular.
     - reviews → Tabs/ReviewsRegular

   Reglas embebidas:
     #5 — PendingReviewTooltip en CTAs mutadores.
     #7 — ReviewStatusBadge + RatingSummaryCard en reviews (Tab).
   ───────────────────────────────────────────────────────────────────────────── *@
@using Bulletin.Board.Web.Client.Models
@using Bulletin.Board.Web.Client.Components.Shared
@using Bulletin.Board.Web.Client.Components.Manage.Shared
@using Bulletin.Board.Web.Client.Components.Manage.Layouts.Mechanics.Tabs

@inject IStringLocalizer<SharedResource> _localizer

<style>
    .badge-vip { background: linear-gradient(135deg,#fb923c,#f97316); }
    .card-hover { transition: transform 0.35s cubic-bezier(0.32,0.72,0,1), box-shadow 0.35s; }
    .card-hover:hover { transform:translateY(-2px); box-shadow:0 12px 40px -8px rgba(30,41,59,0.14); }
    @@media (prefers-reduced-motion: reduce) { *,*::before,*::after { animation-duration:0.01ms!important; transition-duration:0.01ms!important; } }
</style>

<ManageDetailHeader ListingId="@Listing.Id.ToString()"
                    ListingTitle="@Listing.TitleEn"
                    CategorySlug="@Listing.CategorySlug"
                    ActiveTab="@ResolvedActiveTab"
                    Status="@Listing.Status"
                    TierBadge="@Listing.Tier"
                    CategoryLabel="@(_localizer["Manage_Mechanics_CategoryLabel"])"
                    Since="@SinceLabel"
                    PublicUrl="@($"/listing/{Listing.Id}")"
                    ServiceCount="@Listing.Services.Length" />

@{
    var (tabType, tabParams) = ResolveTab(ResolvedActiveTab);
}
@if (tabType is not null)
{
    <DynamicComponent Type="tabType" Parameters="tabParams" />
}
else
{
    @* Default tab = Services (v2 content kept inline) *@
    <main class="max-w-6xl mx-auto px-4 py-8 w-full"
          id="panel-services"
          role="tabpanel"
          aria-labelledby="tab-services"
          tabindex="0">

        <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
            <div>
                <h2 class="text-base font-semibold text-ink">@_localizer["Manage_Mechanics_Services_Title"]</h2>
                <p class="text-sm text-muted mt-0.5">@_localizer["Manage_Mechanics_Services_Subtitle"]</p>
            </div>
            <PendingReviewTooltip>
                <button type="button"
                        class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-2xl bg-brand-500 hover:bg-brand-600 active:scale-[0.98] text-white text-sm font-semibold cursor-pointer transition-colors duration-150">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    @_localizer["Manage_Mechanics_AddService"]
                </button>
            </PendingReviewTooltip>
        </div>

        <ul class="space-y-3" role="list" aria-label="@_localizer["Manage_Mechanics_Services_AriaLabel"]">
            @if (Listing.Services.Length == 0)
            {
                <li class="p-8 text-center bg-white rounded-3xl border border-dashed border-slate-200">
                    <p class="text-sm text-muted">@_localizer["Manage_Mechanics_Services_Empty"]</p>
                </li>
            }
            else
            {
                @foreach (var s in Listing.Services)
                {
                    <li class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5 card-hover">
                        <div class="flex items-start justify-between gap-4 flex-wrap">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <h3 class="font-semibold text-ink">@s.NameEn</h3>
                                    @if (!string.IsNullOrWhiteSpace(s.GroupEn))
                                    {
                                        <span class="text-[10px] uppercase tracking-wider bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full">@s.GroupEn</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(s.DescriptionEn))
                                {
                                    <p class="text-muted text-xs mt-0.5">@s.DescriptionEn</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(s.Price))
                                {
                                    <p class="text-ink text-sm mt-1 font-medium">@_localizer["Manage_Mechanics_From"] @s.Price</p>
                                }
                            </div>
                            <div class="flex items-center gap-1 flex-wrap">
                                <PendingReviewTooltip>
                                    <button type="button" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-ink text-xs font-medium cursor-pointer">@_localizer["Manage_Common_Edit"]</button>
                                </PendingReviewTooltip>
                                <PendingReviewTooltip>
                                    <button type="button" class="px-3 py-1.5 rounded-xl bg-red-50 hover:bg-red-100 text-red-700 text-xs font-medium cursor-pointer">@_localizer["Manage_Common_Remove"]</button>
                                </PendingReviewTooltip>
                            </div>
                        </div>
                    </li>
                }
            }
        </ul>

        @* TierGate: emergency 24/7 + coverage map + response time *@
        <div class="mt-8 rounded-3xl border border-amber-200 bg-gradient-to-r from-amber-50 to-orange-50 p-6">
            <div class="flex items-start gap-4 flex-wrap">
                <div class="flex-shrink-0 w-11 h-11 rounded-2xl bg-white border border-amber-200 flex items-center justify-center shadow-soft">
                    <svg class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                        <h3 class="text-sm font-semibold text-ink">@_localizer["Manage_Mechanics_VipUpsell_Title"]</h3>
                        <span class="text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-full badge-vip text-white font-semibold">VIP</span>
                    </div>
                    <p class="text-sm text-amber-900 mt-1 leading-relaxed max-w-2xl">
                        @_localizer["Manage_Mechanics_VipUpsell_Body"]
                    </p>
                    <div class="flex items-center gap-2 mt-4 flex-wrap">
                        <a href="/verification" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-2xl bg-ink hover:bg-slate-800 text-white text-xs font-semibold cursor-pointer no-underline">
                            @_localizer["Manage_VipUpsell_GetVerified"]
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                        </a>
                        <a href="/about/vip" class="text-xs text-amber-900 hover:text-ink font-medium underline-offset-2 hover:underline">@_localizer["Manage_VipUpsell_LearnMore"]</a>
                    </div>
                </div>
            </div>
        </div>
    </main>
}

@code {
    [Parameter, EditorRequired] public ListingDetailDto Listing { get; set; } = default!;
    [Parameter] public string? ActiveTab { get; set; }

    /// <summary>
    /// Default mechanics Regular = "overview" (contrato canónico). El contenido
    /// inline (services list) actúa como vista overview hasta que el UI/UX
    /// entregue un OverviewRegular dedicado.
    /// </summary>
    private string ResolvedActiveTab => string.IsNullOrEmpty(ActiveTab) ? "overview" : ActiveTab;

    private string SinceLabel => Listing.ApprovedAt is DateTimeOffset dt ? $"Since {dt:MMM yyyy}" : "";

    private (Type? Type, IDictionary<string, object>? Params) ResolveTab(string tab)
    {
        var p = new Dictionary<string, object> { ["Listing"] = Listing };

        return tab switch
        {
            "reviews"   => (typeof(ReviewsRegular),    p),
            "settings"  => (typeof(SettingsRegular),   p),
            "inquiries" => (typeof(InquiriesRegular),  p),
            "photos"    => (typeof(Photos),            p),

            // "overview" / "services" → null (renders inline default below)
            _           => (null, null),
        };
    }
}
