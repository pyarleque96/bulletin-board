@* ─────────────────────────────────────────────────────────────────────────────
   JobsManageRegular — Container Regular/Verified para jobs. Dispatcher tabs vía
   DynamicComponent. Default tab = "overview" (v3 content inline: posting card +
   VIP upsell). El tab refinado /overview con KPIs + recent applications vive en
   Tabs/OverviewRegular y se utiliza cuando se navega explícitamente a esa key.

   Tabs disponibles:
     - overview     (default — inline v2: single active posting + VIP upsell)
     - applications → Tabs/OverviewRegular (Regular = lista simple, sin pipeline)
     - settings     (TODO Fase E: page placeholder)

   Reglas embebidas:
     #5 — PendingReviewTooltip en CTAs mutadores (Edit listing, Close posting).
     #8 — GmCopyNotice en panel de applications (vive en Tabs/OverviewRegular).
   ───────────────────────────────────────────────────────────────────────────── *@
@using Bulletin.Board.Web.Client.Models
@using Bulletin.Board.Web.Client.Components.Shared
@using Bulletin.Board.Web.Client.Components.Buttons
@using Bulletin.Board.Web.Client.Components.Manage.Layouts.Jobs.Tabs

@inject IStringLocalizer<SharedResource> _localizer

<style>
    .badge-vip { background: linear-gradient(135deg,#fb923c,#f97316); }
    .card-hover { transition: transform 0.35s cubic-bezier(0.32,0.72,0,1), box-shadow 0.35s; }
    .card-hover:hover { transform:translateY(-2px); box-shadow:0 12px 40px -8px rgba(30,41,59,0.14); }
    @@media (prefers-reduced-motion: reduce) { *,*::before,*::after { animation-duration:0.01ms!important; transition-duration:0.01ms!important; } }
</style>

<ManageDetailHeader ListingId="@Listing.Id.ToString()"
                    ListingTitle="@Listing.TitleEn"
                    CategorySlug="@Listing.CategorySlug"
                    ActiveTab="@ResolvedActiveTab"
                    Status="@Listing.Status"
                    TierBadge="@Listing.Tier"
                    CategoryLabel="@(_localizer["Manage_Jobs_CategoryLabel"])"
                    Since="@SinceLabel"
                    PublicUrl="@($"/listing/{Listing.Id}")" />

@{
    var (tabType, tabParams) = ResolveTab(ResolvedActiveTab);
}
@if (tabType is not null)
{
    <DynamicComponent Type="tabType" Parameters="tabParams" />
}
else
{
    @* Default tab = Overview (v2 content kept inline: single active posting + VIP upsell). *@
    <main class="max-w-6xl mx-auto px-4 py-8 w-full"
          id="panel-overview"
          role="tabpanel"
          aria-labelledby="tab-overview"
          tabindex="0">

        <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
            <div>
                <h2 class="text-base font-semibold text-ink">@_localizer["Manage_Jobs_Postings_Title"]</h2>
                <p class="text-sm text-muted mt-0.5">@_localizer["Manage_Jobs_Postings_Subtitle_Regular"]</p>
            </div>
        </div>

        <ul class="space-y-4" role="list" aria-label="@_localizer["Manage_Jobs_Postings_AriaLabel"]">

            @* Active posting — built from the listing's own data *@
            <li class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5 card-hover">
                <div class="flex items-start justify-between gap-4 flex-wrap">
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h3 class="font-semibold text-ink">@Listing.TitleEn</h3>
                            @if (Listing.Status == "Approved")
                            {
                                <span class="text-[10px] uppercase tracking-wider bg-green-100 text-green-700 px-2 py-0.5 rounded-full">active</span>
                            }
                            @if (Listing.Languages.Length > 1)
                            {
                                <span class="text-[10px] uppercase tracking-wider bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full">@_localizer["Manage_Jobs_J1Friendly"]</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Listing.Location))
                        {
                            <p class="text-muted text-xs mt-0.5">@Listing.Location · @string.Join(" / ", Listing.Languages)</p>
                        }
                        <p class="text-ink text-sm mt-2 leading-relaxed line-clamp-3">@Listing.DescriptionEn</p>
                        <div class="flex items-center gap-3 mt-3 flex-wrap text-[11px] text-muted">
                            <span class="inline-flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                                </svg>
                                @* TODO: API GET /api/v1/listings/{id}/applications/count *@
                                — @_localizer["Manage_Jobs_Applications_Lower"]
                            </span>
                            @if (Listing.ApprovedAt is DateTimeOffset approved)
                            {
                                <span>·</span>
                                <span>@_localizer["Manage_Jobs_Posted"] @approved.ToString("MMM d, yyyy")</span>
                            }
                        </div>
                    </div>
                    <div class="flex items-center gap-1 flex-wrap">
                        <ManageLinkButton Href="@($"/manage/{Listing.Id}/edit")"
                                          Variant="Default"
                                          Size="Compact"
                                          data-tooltip="@_localizer["Manage_EditWarning"]">
                            @_localizer["Manage_Common_Edit"]
                        </ManageLinkButton>
                        <button type="button"
                                class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-ink text-xs font-medium transition-colors duration-150 cursor-pointer">
                            @_localizer["Manage_Jobs_ClosePosting"]
                        </button>
                    </div>
                </div>
            </li>

            @* TierGate: multiple postings + funnel analytics + CSV export *@
            <li class="rounded-3xl border border-amber-200 bg-gradient-to-r from-amber-50 to-orange-50 p-6">
                <div class="flex items-start gap-4 flex-wrap">
                    <div class="flex-shrink-0 w-11 h-11 rounded-2xl bg-white border border-amber-200 flex items-center justify-center shadow-soft">
                        <svg class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h3 class="text-sm font-semibold text-ink">@_localizer["Manage_Jobs_VipUpsell_Title"]</h3>
                            <span class="text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-full badge-vip text-white font-semibold">VIP</span>
                        </div>
                        <p class="text-sm text-amber-900 mt-1 leading-relaxed max-w-2xl">
                            @_localizer["Manage_Jobs_VipUpsell_Body"]
                        </p>
                        <div class="flex items-center gap-2 mt-4 flex-wrap">
                            <a href="/verification"
                               class="inline-flex items-center gap-1.5 px-4 py-2 rounded-2xl bg-ink hover:bg-slate-800 text-white text-xs font-semibold cursor-pointer no-underline">
                                @_localizer["Manage_VipUpsell_GetVerified"]
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                            </a>
                            <a href="/about/vip" class="text-xs text-amber-900 hover:text-ink font-medium underline-offset-2 hover:underline">@_localizer["Manage_VipUpsell_LearnMore"]</a>
                        </div>
                    </div>
                </div>
            </li>

        </ul>
    </main>
}

@code {
    [Parameter, EditorRequired] public ListingDetailDto Listing { get; set; } = default!;
    [Parameter] public string? ActiveTab { get; set; }

    /// <summary>Default jobs Regular = "overview" (inline single-posting card + VIP upsell).</summary>
    private string ResolvedActiveTab => string.IsNullOrEmpty(ActiveTab) ? "overview" : ActiveTab;

    private string SinceLabel => Listing.ApprovedAt is DateTimeOffset dt ? $"Since {dt:MMM yyyy}" : "";

    private (Type? Type, IDictionary<string, object>? Params) ResolveTab(string tab)
    {
        var p = new Dictionary<string, object> { ["Listing"] = Listing };

        return tab switch
        {
            "applications" => (typeof(OverviewRegular), p),
            "settings"     => (typeof(SettingsRegular), p),
            // "overview" → null (renders inline default below — single posting card + VIP upsell).
            _              => (null, null),
        };
    }
}
