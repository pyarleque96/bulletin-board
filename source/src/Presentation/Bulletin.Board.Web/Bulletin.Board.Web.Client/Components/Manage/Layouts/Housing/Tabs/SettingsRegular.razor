@* ─────────────────────────────────────────────────────────────────────────────
   SettingsRegular (Housing) — Settings tab for Regular/Verified housing tier.
   Sections: Visibility (safe), Listing details (content), Address & check-in (content),
             Contact (content), Notifications (safe), Language (safe), VIP upsell,
             Save bar, Danger zone.
   Regla #5 — content sections trigger Pending on save (PendingReviewTooltip).
   Regla #8 — GmCopyNotice anchored in Notifications.

   TODO: GET/PUT /api/v1/manage/listings/{id}/settings (content edits → Pending)
   TODO: PATCH    /api/v1/manage/listings/{id}/preferences (safe flags — instant)
   ───────────────────────────────────────────────────────────────────────────── *@
@namespace Bulletin.Board.Web.Client.Components.Manage.Layouts.Housing.Tabs
@using Bulletin.Board.Web.Client.Models
@using Bulletin.Board.Web.Client.Components.Manage.Shared

@inject IStringLocalizer<SharedResource> _localizer

<main class="max-w-3xl mx-auto px-4 py-8 w-full"
      id="panel-settings"
      role="tabpanel"
      aria-labelledby="tab-settings"
      tabindex="0">

    @* Banner Pending warning (mixed safe / content) *@
    <div class="mb-6 flex items-start gap-3 px-4 py-3 rounded-2xl bg-amber-50 border border-amber-200" role="alert">
        <svg class="w-4 h-4 text-amber-700 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
        <p class="text-xs text-ink leading-relaxed">@_localizer["Manage_Settings_Banner_Mixed"]</p>
    </div>

    @* Visibility — safe *@
    <section class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5 mb-6">
        <SettingsSectionHeader Title="@(_localizer["Manage_Settings_Visibility_Title"])"
                               Subtitle="@(_localizer["Manage_Settings_Visibility_Subtitle"])"
                               PillType="safe" />
        <div class="space-y-3">
            <label class="flex items-start justify-between gap-3 py-1">
                <span>
                    <span class="text-sm text-ink font-medium block">@_localizer["Manage_Settings_Visibility_Pause"]</span>
                    <span class="text-[11px] text-muted">@_localizer["Manage_Settings_Visibility_Pause_Help"]</span>
                </span>
                <ToggleSwitch Checked="false" AriaLabel="@(_localizer["Manage_Settings_Visibility_Pause"])" />
            </label>
            <label class="flex items-start justify-between gap-3 py-1">
                <span>
                    <span class="text-sm text-ink font-medium block">@_localizer["Manage_Settings_Visibility_HidePhone"]</span>
                    <span class="text-[11px] text-muted">@_localizer["Manage_Settings_Visibility_HidePhone_Help"]</span>
                </span>
                <ToggleSwitch Checked="true" AriaLabel="@(_localizer["Manage_Settings_Visibility_HidePhone"])" />
            </label>
        </div>
    </section>

    @* Listing details — content (Regla #5) *@
    <section class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5 mb-6">
        <SettingsSectionHeader Title="@(_localizer["Manage_Settings_Details_Title"])"
                               Subtitle="@(_localizer["Manage_Settings_Details_Subtitle"])"
                               PillType="content" />
        <BilingualInput LabelKey="Manage_Settings_Field_Title" ValueEn="@Listing.TitleEn" ValueEs="@Listing.TitleEs" />
        <div class="mt-4">
            <BilingualInput LabelKey="Manage_Settings_Field_Description" Multiline="true" Rows="3"
                            ValueEn="@Listing.DescriptionEn" ValueEs="@Listing.DescriptionEs" />
        </div>
    </section>

    @* Address & check-in — content *@
    <section class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5 mb-6">
        <SettingsSectionHeader Title="@(_localizer["Manage_Settings_Housing_Address_Title"])"
                               Subtitle="@(_localizer["Manage_Settings_Housing_Address_Subtitle"])"
                               PillType="content" />
        <div class="space-y-3">
            <input type="text" value="@(Listing.Location ?? string.Empty)"
                   class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-[11px] font-semibold text-ink mb-1">@_localizer["Manage_Settings_Housing_CheckIn"]</label>
                    <input type="time" value="15:00" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" />
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink mb-1">@_localizer["Manage_Settings_Housing_CheckOut"]</label>
                    <input type="time" value="11:00" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" />
                </div>
            </div>
        </div>
    </section>

    @* Contact — content *@
    <section class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5 mb-6">
        <SettingsSectionHeader Title="@(_localizer["Manage_Settings_Contact_Title"])"
                               Subtitle="@(_localizer["Manage_Settings_Contact_Subtitle"])"
                               PillType="content" />
        <div class="space-y-4">
            <div>
                <label class="block text-xs font-semibold text-ink mb-1.5">@_localizer["Manage_Settings_Contact_Whatsapp"]</label>
                <input type="tel" placeholder="+1 ..." class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-ink mb-1.5">@_localizer["Manage_Settings_Contact_Email"]</label>
                <input type="email" placeholder="hello@example.com" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-ink mb-1.5">@_localizer["Manage_Settings_Contact_TimeZone"]</label>
                <select class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm bg-white">
                    <option>America/Chicago (CST)</option>
                    <option>America/New_York (EST)</option>
                    <option>America/Denver (MST)</option>
                </select>
            </div>
        </div>
    </section>

    @* Notifications — safe *@
    <section class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5 mb-6">
        <SettingsSectionHeader Title="@(_localizer["Manage_Settings_Notifications_Title"])"
                               Subtitle="@(_localizer["Manage_Settings_Notifications_Subtitle"])"
                               PillType="safe" />
        <div class="space-y-3">
            <label class="flex items-center justify-between gap-3">
                <span class="text-sm text-ink">@_localizer["Manage_Settings_Notif_Email_Inquiries"]</span>
                <ToggleSwitch Checked="true" />
            </label>
            <label class="flex items-center justify-between gap-3">
                <span class="text-sm text-ink">@_localizer["Manage_Settings_Notif_Email_NewReview"]</span>
                <ToggleSwitch Checked="true" />
            </label>
            <label class="flex items-center justify-between gap-3">
                <span class="text-sm text-ink">@_localizer["Manage_Settings_Notif_Wa_Bookings"]</span>
                <ToggleSwitch Checked="true" />
            </label>
            <div class="mt-2">
                <GmCopyNotice />
            </div>
        </div>
    </section>

    @* Language — safe *@
    <section class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5 mb-6">
        <SettingsSectionHeader Title="@(_localizer["Manage_Settings_Language_Title"])"
                               Subtitle="@(_localizer["Manage_Settings_Language_Subtitle"])"
                               PillType="safe" />
        <select class="w-full max-w-xs rounded-xl border border-slate-200 px-3 py-2 text-sm bg-white">
            <option>@_localizer["Manage_Settings_Language_Auto"]</option>
            <option>@_localizer["Manage_Settings_Language_English"]</option>
            <option>@_localizer["Manage_Settings_Language_Spanish"]</option>
            <option>@_localizer["Manage_Settings_Language_Both"]</option>
        </select>
    </section>

    @* VIP upsell *@
    <div class="mb-6">
        <VipUpsellBanner Tier="@Listing.Tier" Title="@(_localizer["Manage_Settings_VipUpsell_Title"])">
            @_localizer["Manage_Settings_VipUpsell_Housing"]
        </VipUpsellBanner>
    </div>

    @* Sticky save bar — Regla #5 (tooltip on Save) *@
    <div class="sticky bottom-4 z-10 bg-white rounded-3xl border border-slate-200 shadow-soft p-4 flex items-center justify-between gap-3 flex-wrap">
        <p class="text-[11px] text-muted leading-relaxed flex-1 min-w-[200px]">
            <strong class="text-ink">@_localizer["Manage_Settings_Save_Content_Title"]</strong>
            @_localizer["Manage_Settings_Save_Mixed_Body"]
        </p>
        <div class="flex items-center gap-2">
            <button type="button" class="text-xs px-3 py-2 rounded-xl border border-slate-200 hover:border-slate-300 text-ink cursor-pointer">
                @_localizer["Manage_Common_Cancel"]
            </button>
            <PendingReviewTooltip>
                <button type="button" class="text-xs px-4 py-2 rounded-xl bg-brand-500 hover:bg-brand-600 text-white font-semibold cursor-pointer">
                    @_localizer["Manage_Common_SaveChanges"]
                </button>
            </PendingReviewTooltip>
        </div>
    </div>

    <DangerZoneCard Subtitle="@(_localizer["Manage_Settings_Housing_Danger_Subtitle"])" />
</main>

@code {
    [Parameter, EditorRequired] public ListingDetailDto Listing { get; set; } = default!;
}
