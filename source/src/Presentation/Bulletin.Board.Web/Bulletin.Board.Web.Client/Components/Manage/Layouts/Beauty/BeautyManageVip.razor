@* ─────────────────────────────────────────────────────────────────────────────
   BeautyManageVip — Container VIP para beauty. Dispatcher tabs vía DynamicComponent.

   Tabs:
     - services (default — promociones + analytics + week calendar, contenido v2
                          conservado inline)
     - appointments → Tabs/AppointmentsRegular (mismo UI base; VIP añade
                                                booking online cuando aterrice API)
     - inquiries    → Tabs/InquiriesRegular (Beauty no tiene InquiriesVip v3 —
                                             usa Regular hasta refinar)
     - photos       → Tabs/PhotosVip (Portfolio VIP: unlimited + pairs)
     - reviews      → Tabs/ReviewsRegular (Beauty no tiene ReviewsVip v3)

   Reglas: ver header de HousingManageRegular.
   ───────────────────────────────────────────────────────────────────────────── *@
@using Bulletin.Board.Web.Client.Models
@using Bulletin.Board.Web.Client.Components.Shared
@using Bulletin.Board.Web.Client.Components.Manage.Layouts.Beauty.Tabs
@using Bulletin.Board.Web.Client.Components.Manage.Shared

@inject IStringLocalizer<SharedResource> _localizer

<style>
    .badge-vip { background: linear-gradient(135deg,#fb923c,#f97316); }
    @@media (prefers-reduced-motion: reduce) { *,*::before,*::after { animation-duration:0.01ms!important; transition-duration:0.01ms!important; } }
</style>

<ManageDetailHeader ListingId="@Listing.Id.ToString()"
                    ListingTitle="@Listing.TitleEn"
                    CategorySlug="@Listing.CategorySlug"
                    ActiveTab="@ResolvedActiveTab"
                    Status="@Listing.Status"
                    TierBadge="@Listing.Tier"
                    CategoryLabel="@(_localizer["Manage_Beauty_CategoryLabel"])"
                    Since="@SinceLabel"
                    PublicUrl="@($"/listing/{Listing.Id}")"
                    PhotoCount="@Listing.Photos.Length" />

@{
    var (tabType, tabParams) = ResolveTab(ResolvedActiveTab);
}
@if (tabType is not null)
{
    <DynamicComponent Type="tabType" Parameters="tabParams" />
}
else
{
    @* Default: Services + Promotions + Online booking (preservado de v2). *@
    <main class="max-w-6xl mx-auto px-4 py-8 w-full"
          id="panel-services"
          role="tabpanel"
          aria-labelledby="tab-services"
          tabindex="0">

        @* Promotions banner — TODO: API GET /api/v1/manage/listings/{id}/promotions (BACKEND_AUDIT — extensión VIP). *@
        <section class="mb-6 rounded-3xl border border-brand-200 bg-gradient-to-br from-brand-50 to-amber-50 p-5">
            <div class="flex items-start justify-between gap-4 flex-wrap">
                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <h2 class="text-sm font-semibold text-ink">@_localizer["Manage_Beauty_Promo_ActiveTitle"]</h2>
                        <span class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded-full badge-vip text-white font-semibold">VIP</span>
                    </div>
                    <p class="text-sm text-ink mt-1">@_localizer["Manage_Beauty_Promo_Placeholder"]</p>
                    <p class="text-[11px] text-muted mt-1">@_localizer["Manage_Beauty_Promo_NoActive"]</p>
                </div>
                <div class="flex items-center gap-1.5 flex-wrap">
                    <PendingReviewTooltip>
                        <button type="button" class="px-3 py-1.5 rounded-xl bg-brand-500 hover:bg-brand-600 text-white text-xs font-semibold cursor-pointer">
                            + @_localizer["Manage_Beauty_NewPromotion"]
                        </button>
                    </PendingReviewTooltip>
                </div>
            </div>
        </section>

        @* Per-service analytics — TODO: API GET /api/v1/manage/listings/{id}/analytics (BACKEND_AUDIT §1.4 ServicePopularity, VIP only). *@
        <section aria-label="@_localizer["Manage_Beauty_Analytics_Title"]" class="mb-8">
            <h2 class="text-sm font-semibold text-ink mb-3 inline-flex items-center gap-2">
                @_localizer["Manage_Beauty_Analytics_Title"]
                <span class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded-full badge-vip text-white font-semibold">VIP</span>
            </h2>
            <div class="bg-white rounded-3xl border border-slate-100 shadow-soft overflow-hidden">
                <table class="w-full text-sm">
                    <thead class="bg-slate-50 text-[11px] uppercase tracking-wider text-muted">
                        <tr>
                            <th scope="col" class="text-left px-4 py-3 font-medium">@_localizer["Manage_Beauty_Analytics_Service"]</th>
                            <th scope="col" class="text-right px-4 py-3 font-medium">@_localizer["Manage_Beauty_Analytics_Bookings"]</th>
                            <th scope="col" class="text-right px-4 py-3 font-medium">@_localizer["Manage_Beauty_Analytics_Revenue"]</th>
                            <th scope="col" class="text-right px-4 py-3 font-medium">@_localizer["Manage_Beauty_Analytics_AvgRating"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @if (Listing.Services.Length == 0)
                        {
                            <tr><td colspan="4" class="px-4 py-6 text-center text-muted text-xs">@_localizer["Manage_Beauty_Analytics_Empty"]</td></tr>
                        }
                        else
                        {
                            @foreach (var s in Listing.Services)
                            {
                                <tr>
                                    <td class="px-4 py-3 text-ink font-medium">@s.NameEn</td>
                                    <td class="px-4 py-3 text-right tabular-nums text-muted">—</td>
                                    <td class="px-4 py-3 text-right tabular-nums text-ink font-semibold">@(s.Price ?? "—")</td>
                                    <td class="px-4 py-3 text-right tabular-nums text-muted">—</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @* Online booking calendar — TODO: API GET /api/v1/manage/listings/{id}/appointments?from=&to= (BACKEND_AUDIT §1.4). *@
        <section aria-label="@_localizer["Manage_Beauty_Calendar_Title"]" class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5">
            <div class="flex items-start justify-between flex-wrap gap-3 mb-4">
                <div>
                    <h2 class="text-sm font-semibold text-ink inline-flex items-center gap-2">
                        @_localizer["Manage_Beauty_Calendar_Title"]
                        <span class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded-full badge-vip text-white font-semibold">VIP</span>
                    </h2>
                    <p class="text-xs text-muted mt-0.5">@_localizer["Manage_Beauty_Calendar_Subtitle"]</p>
                </div>
                <div class="flex items-center gap-1">
                    <button type="button" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 flex items-center justify-center cursor-pointer" aria-label="@_localizer["Manage_Beauty_Calendar_PrevWeek"]">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                    </button>
                    <span class="text-sm font-semibold text-ink px-2">@_weekLabel</span>
                    <button type="button" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 flex items-center justify-center cursor-pointer" aria-label="@_localizer["Manage_Beauty_Calendar_NextWeek"]">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-7 gap-2">
                @foreach (var day in _days)
                {
                    <div class="rounded-2xl border @(day.IsToday ? "border-brand-300 bg-brand-50" : "border-slate-100") p-2"
                         aria-current="@(day.IsToday ? "date" : null)">
                        <p class="text-[11px] uppercase tracking-wider @(day.IsToday ? "text-brand-700 font-semibold" : "text-muted font-medium") mb-2">
                            @day.Label@(day.IsToday ? " · Today" : "")
                        </p>
                        <p class="text-[11px] text-slate-400">—</p>
                    </div>
                }
            </div>

            <div class="flex items-center gap-3 flex-wrap mt-4 text-[11px] text-muted">
                <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-green-200 border border-green-300"></span> @_localizer["Manage_Beauty_Calendar_Confirmed"]</span>
                <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-amber-200 border border-amber-300"></span> @_localizer["Manage_Beauty_Calendar_Pending"]</span>
            </div>
        </section>

        <div class="mt-10 flex items-center justify-center gap-2 text-[11px] text-muted">
            <span class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded-full badge-vip text-white font-semibold">VIP</span>
            @_localizer["Manage_Beauty_VipFooter"]
        </div>
    </main>
}

@code {
    [Parameter, EditorRequired] public ListingDetailDto Listing { get; set; } = default!;
    [Parameter] public string? ActiveTab { get; set; }

    /// <summary>
    /// Default beauty VIP = "overview" (contrato canónico). El contenido inline
    /// (services + promos + week calendar) actúa como vista overview hasta que el
    /// UI/UX entregue un OverviewVip dedicado para beauty.
    /// </summary>
    private string ResolvedActiveTab => string.IsNullOrEmpty(ActiveTab) ? "overview" : ActiveTab;

    private string SinceLabel => Listing.ApprovedAt is DateTimeOffset dt ? $"Since {dt:MMM yyyy}" : "";

    private (Type? Type, IDictionary<string, object>? Params) ResolveTab(string tab)
    {
        var p = new Dictionary<string, object> { ["Listing"] = Listing };

        return tab switch
        {
            "photos"       => (typeof(PhotosVip),           p),
            "appointments" => (typeof(AppointmentsRegular), p),
            "inquiries"    => (typeof(InquiriesRegular),    p),
            "reviews"      => (typeof(ReviewsRegular),      p),
            "settings"     => (typeof(SettingsVip),         p),
            "analytics"    => (typeof(AnalyticsTab),        p),

            _              => (null, null), // default → services inline (overview)
        };
    }

    private string _weekLabel = "";
    private readonly List<DayCell> _days = new();

    protected override void OnInitialized()
    {
        var today  = DateTime.Today;
        var monday = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
        var sunday = monday.AddDays(6);
        _weekLabel = $"{monday:MMM d}–{sunday:MMM d}";

        var dayNames = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
        for (var i = 0; i < 7; i++)
        {
            var date = monday.AddDays(i);
            _days.Add(new DayCell(
                Label: $"{dayNames[i]} {date.Day}",
                IsToday: date == today));
        }
    }

    private readonly record struct DayCell(string Label, bool IsToday);
}
