@* ─────────────────────────────────────────────────────────────────────────────
   HousingManageVip — Container VIP para housing. Dispatcher tabs vía
   DynamicComponent. Tab por defecto = Overview (KPIs + properties at a glance +
   recent activity, en Tabs/OverviewVip).

   Tabs:
     - overview (default)  → Tabs/OverviewVip
     - inquiries           → Tabs/InquiriesVip
     - photos              → Tabs/PhotosRegular (mismo UI; VIP ya viene con
                                                 unlimited cuando aterrice API)
     - reviews             → Tabs/ReviewsRegular
     - availability        → contenido inline (calendar) — preservado de v2

   Reglas: ver header de HousingManageRegular.
   ───────────────────────────────────────────────────────────────────────────── *@
@using Bulletin.Board.Web.Client.Models
@using Bulletin.Board.Web.Client.Components.Shared
@using Bulletin.Board.Web.Client.Components.Manage.Layouts.Housing.Tabs
@using Bulletin.Board.Web.Client.Components.Manage.Shared

@inject IStringLocalizer<SharedResource> _localizer

<style>
    .badge-vip { background: linear-gradient(135deg,#fb923c,#f97316); }
    @@media (prefers-reduced-motion: reduce) { *,*::before,*::after { animation-duration:0.01ms!important; transition-duration:0.01ms!important; } }
</style>

<ManageDetailHeader ListingId="@Listing.Id.ToString()"
                    ListingTitle="@Listing.TitleEn"
                    CategorySlug="@Listing.CategorySlug"
                    ActiveTab="@ResolvedActiveTab"
                    Status="@Listing.Status"
                    TierBadge="@Listing.Tier"
                    CategoryLabel="@(_localizer["Manage_Housing_CategoryLabel"])"
                    Since="@SinceLabel"
                    PublicUrl="@($"/listing/{Listing.Id}")"
                    PhotoCount="@Listing.Photos.Length" />

@{
    var (tabType, tabParams) = ResolveTab(ResolvedActiveTab);
}
@if (tabType is not null)
{
    <DynamicComponent Type="tabType" Parameters="tabParams" />
}
else
{
    @* Default VIP housing tab = Availability/Calendar (preservado de v2). *@
    <main class="max-w-6xl mx-auto px-4 py-8 w-full"
          id="panel-availability"
          role="tabpanel"
          aria-labelledby="tab-availability"
          tabindex="0">

        @* Analytics highlights — TODO: API GET /api/v1/manage/listings/{id}/analytics (BACKEND_AUDIT §1.1 — VIP only). *@
        <section aria-label="@_localizer["Manage_Housing_Analytics_HighlightsAria"]" class="mb-8 grid grid-cols-2 lg:grid-cols-4 gap-3">
            <div class="bg-white rounded-2xl border border-slate-100 shadow-soft p-4">
                <p class="text-[11px] uppercase tracking-wider text-muted font-medium">@_localizer["Manage_Housing_Stat_Views30d"]</p>
                <p class="text-2xl font-bold text-ink mt-1 tabular-nums">—</p>
                <p class="text-[11px] text-muted mt-1">vs prev</p>
            </div>
            <div class="bg-white rounded-2xl border border-slate-100 shadow-soft p-4">
                <p class="text-[11px] uppercase tracking-wider text-muted font-medium">@_localizer["Manage_Housing_Stat_Conversion"]</p>
                <p class="text-2xl font-bold text-ink mt-1 tabular-nums">—</p>
                <p class="text-[11px] text-muted mt-1">View → Inquiry</p>
            </div>
            <div class="bg-white rounded-2xl border border-slate-100 shadow-soft p-4">
                <p class="text-[11px] uppercase tracking-wider text-muted font-medium">@_localizer["Manage_Housing_Stat_AvgResponse"]</p>
                <p class="text-2xl font-bold text-ink mt-1 tabular-nums">—</p>
                <p class="text-[11px] text-muted mt-1">Auto-reply</p>
            </div>
            <div class="bg-white rounded-2xl border border-slate-100 shadow-soft p-4">
                <p class="text-[11px] uppercase tracking-wider text-muted font-medium">@_localizer["Manage_Housing_Stat_Occupancy"]</p>
                <p class="text-2xl font-bold text-ink mt-1 tabular-nums">—</p>
                <p class="text-[11px] text-muted mt-1">@_monthLabel</p>
            </div>
        </section>

        @* Calendar panel — TODO: API GET /api/v1/manage/listings/{id}/bookings?month=YYYY-MM (BACKEND_AUDIT §1.3 — extensión calendar). *@
        <section id="panel-calendar" role="tabpanel" tabindex="0">
            <div class="flex items-start justify-between flex-wrap gap-3 mb-6">
                <div>
                    <h2 class="text-base font-semibold text-ink">@_localizer["Manage_Housing_Calendar_Title"] · @_monthLabel</h2>
                    <p class="text-sm text-muted mt-0.5">@_localizer["Manage_Housing_Calendar_Subtitle"]</p>
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="inline-flex items-center gap-1.5 text-xs font-medium text-green-700 bg-green-50 border border-green-200 px-3 py-1.5 rounded-full">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                        @_localizer["Manage_Housing_Calendar_GoogleConnected"]
                    </span>
                    <button type="button" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-ink text-xs font-medium cursor-pointer">
                        @_localizer["Manage_Housing_Calendar_ExportIcal"]
                    </button>
                </div>
            </div>

            <div class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5">
                <div role="grid" aria-label="@_monthLabel @_localizer["Manage_Housing_Calendar_GridLabel"]">
                    <div class="grid grid-cols-7 gap-1.5 text-[11px] uppercase tracking-wider text-muted font-medium mb-2">
                        @foreach (var d in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
                        {
                            <div class="text-center py-1">@d</div>
                        }
                    </div>
                    <div class="grid grid-cols-7 gap-1.5">
                        @foreach (var cell in _cells)
                        {
                            <div class="aspect-square rounded-xl border @cell.BorderClass @cell.BgClass p-1.5 text-[11px] @cell.TextClass">
                                @cell.DayNumber
                            </div>
                        }
                    </div>
                </div>

                <div class="flex items-center gap-3 flex-wrap mt-4 text-[11px] text-muted">
                    <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-green-200 border border-green-300"></span> @_localizer["Manage_Housing_Calendar_Booked"]</span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-amber-200 border border-amber-300"></span> @_localizer["Manage_Housing_Calendar_Pending"]</span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-blue-200 border border-blue-300"></span> @_localizer["Manage_Housing_Calendar_External"]</span>
                </div>
            </div>
        </section>

        <div class="mt-10 flex items-center justify-center gap-2 text-[11px] text-muted">
            <span class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded-full badge-vip text-white font-semibold">VIP</span>
            @_localizer["Manage_Housing_VipFooter"]
        </div>
    </main>
}

@code {
    [Parameter, EditorRequired] public ListingDetailDto Listing { get; set; } = default!;
    [Parameter] public string? ActiveTab { get; set; }

    private string ResolvedActiveTab => string.IsNullOrEmpty(ActiveTab) ? "overview" : ActiveTab;

    private string SinceLabel => Listing.ApprovedAt is DateTimeOffset dt ? $"Since {dt:MMM yyyy}" : "";

    private (Type? Type, IDictionary<string, object>? Params) ResolveTab(string tab)
    {
        var p = new Dictionary<string, object> { ["Listing"] = Listing };

        return tab switch
        {
            "overview"   => (typeof(OverviewVip),    p),
            "inquiries"  => (typeof(InquiriesVip),   p),
            "photos"     => (typeof(PhotosRegular),  p), // mismo UI; VIP unlimited cuando aterrice API
            "reviews"    => (typeof(ReviewsRegular), p),
            "settings"   => (typeof(SettingsVip),    p),
            "analytics"  => (typeof(AnalyticsTab),   p),

            _            => (null, null), // default → render inline (availability/calendar)
        };
    }

    private string _monthLabel = "";
    private List<CalendarCell> _cells = new();

    protected override void OnInitialized()
    {
        var today        = DateTime.Today;
        _monthLabel      = today.ToString("MMM yyyy");
        var firstOfMonth = new DateTime(today.Year, today.Month, 1);
        var startOffset  = (int)firstOfMonth.DayOfWeek;
        var daysInMonth  = DateTime.DaysInMonth(today.Year, today.Month);

        for (var i = startOffset; i > 0; i--)
        {
            var d = firstOfMonth.AddDays(-i);
            _cells.Add(new CalendarCell(d.Day, IsCurrentMonth: false, IsToday: false));
        }
        for (var i = 1; i <= daysInMonth; i++)
        {
            var d = new DateTime(today.Year, today.Month, i);
            _cells.Add(new CalendarCell(i, IsCurrentMonth: true, IsToday: d == today));
        }
        while (_cells.Count % 7 != 0)
        {
            _cells.Add(new CalendarCell(0, IsCurrentMonth: false, IsToday: false));
        }
    }

    private sealed record CalendarCell(int DayNumber, bool IsCurrentMonth, bool IsToday)
    {
        public string BorderClass => IsToday
            ? "border-2 border-brand-500"
            : (IsCurrentMonth ? "border-slate-100" : "border-slate-100");

        public string BgClass => IsToday
            ? "bg-brand-50"
            : (IsCurrentMonth ? "" : "bg-slate-50");

        public string TextClass => IsToday
            ? "text-brand-700 font-semibold"
            : (IsCurrentMonth ? "text-ink" : "text-slate-400");
    }
}
