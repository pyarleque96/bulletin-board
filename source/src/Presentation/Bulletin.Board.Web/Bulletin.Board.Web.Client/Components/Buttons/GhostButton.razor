@namespace Bulletin.Board.Web.Client.Components.Buttons

@*
    Transparent button with text-only appearance.
    Used for: "View all listings", "Go back", "Forgot password?", "Reset filters", footer links.
    Variant controls color scheme: "brand" (blue), "muted" (gray), "white" (on dark backgrounds).
*@

<button
    type="@Type"
    class="@ComputedClass"
    @onclick="HandleClick"
    disabled="@(Disabled || IsLoading)"
    aria-disabled="@(Disabled || IsLoading)"
    aria-busy="@IsLoading">
    @if (IsLoading)
    {
        <svg class="w-3.5 h-3.5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
        </svg>
    }
    @if (!string.IsNullOrEmpty(Text))
    {
        <span>@Text</span>
    }
    @ChildContent
    @if (ShowArrow && !IsLoading)
    {
        <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
        </svg>
    }
</button>

@code {
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool IsLoading { get; set; } = false;
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool ShowArrow { get; set; } = false;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Color variant: "brand" | "muted" | "white" | "danger"</summary>
    [Parameter] public string Variant { get; set; } = "brand";

    private string ColorClass => Variant switch
    {
        "muted"  => "text-muted hover:text-ink",
        "white"  => "text-white/40 hover:text-white/70",
        "danger" => "text-red-500 hover:text-red-700",
        _        => "text-brand-500 hover:text-brand-700"
    };

    private string ComputedClass =>
        $"group inline-flex items-center gap-1.5 {ColorClass} text-sm font-medium " +
        "transition-colors duration-200 " +
        "disabled:opacity-50 disabled:cursor-not-allowed " +
        "cursor-pointer " +
        (CssClass ?? string.Empty);

    private async Task HandleClick()
    {
        if (Disabled || IsLoading) return;
        await OnClick.InvokeAsync();
    }
}
