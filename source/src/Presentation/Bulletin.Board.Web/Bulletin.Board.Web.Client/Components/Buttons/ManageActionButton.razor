@namespace Bulletin.Board.Web.Client.Components.Buttons

@*
    Wrapper <button> para acciones en el panel Manage.
    Mismos estilos por Variant que ManageLinkButton — consistencia visual
    garantizada entre <a> y <button> en las barras de acción.

    Variantes (Variant):
      Primary     — bg-brand-500, acción principal (Save, Add vehicle, New).
      Secondary   — borde brand, acción complementaria (Back-with-border, Edit).
      Default     — borde slate, acción neutra (Pause, Mark returned, Sort).
      Danger      — hover rojo outline, destructiva secundaria (Delete en lista, Reject).
      DangerSolid — bg-red-600, confirmación destructiva irreversible en modal.
      Cancel      — sin borde, slate, salir de modal.
      Ghost       — solo texto brand, links textuales.

    Tamaños (Size):
      Medium  — px-4 py-2.5 text-sm  (~40px alto — cumple WCAG táctil)
      Small   — px-3 py-2   text-xs  (8px 12px — header CTA en /manage)
      Compact — px-3 py-1.5 text-xs  (6px 12px — acciones dentro de cards)
*@

<button
    type="@Type"
    @onclick="HandleClick"
    disabled="@(Disabled || Loading)"
    aria-disabled="@(Disabled || Loading)"
    aria-busy="@Loading"
    @attributes="MergedAttributes">
    @if (Loading)
    {
        <svg class="w-4 h-4 animate-spin flex-shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
        </svg>
    }
    @ChildContent
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>Primary | Secondary | Default | Danger | DangerSolid | Cancel | Ghost</summary>
    [Parameter] public string Variant { get; set; } = "Default";

    /// <summary>Medium | Small</summary>
    [Parameter] public string Size { get; set; } = "Medium";

    /// <summary>button | submit | reset</summary>
    [Parameter] public string Type { get; set; } = "button";

    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool Loading { get; set; } = false;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string SizeClass => Size switch
    {
        "Compact" => "px-3 py-1.5 text-xs",
        "Small"   => "px-3 py-2 text-xs",
        _         => "px-4 py-2.5 text-sm"
    };

    private string VariantClass => Variant switch
    {
        "Primary" =>
            "bg-[#f97316] text-white font-semibold " +
            "hover:bg-[#ea580c] hover:-translate-y-0.5 hover:shadow-[0_8px_20px_-4px_rgba(249,115,22,0.40)] " +
            "active:translate-y-0 active:scale-[0.98] " +
            "disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none disabled:shadow-none " +
            "focus-visible:ring-[#f97316]",

        "Secondary" =>
            "text-[#1E293B] border border-slate-300 font-medium bg-transparent " +
            "hover:bg-slate-100 hover:border-[#1E293B] hover:text-[#0f172a] hover:-translate-y-px " +
            "active:translate-y-0 active:scale-[0.98] " +
            "disabled:opacity-50 disabled:cursor-not-allowed " +
            "focus-visible:ring-[#1E293B]",

        "Danger" =>
            "text-muted border border-slate-200 font-medium bg-white " +
            "hover:bg-red-50 hover:border-red-200 hover:text-red-600 " +
            "active:scale-[0.98] " +
            "disabled:opacity-50 disabled:cursor-not-allowed " +
            "focus-visible:ring-red-400",

        "DangerSolid" =>
            "bg-red-600 text-white font-semibold " +
            "hover:bg-red-700 hover:-translate-y-0.5 hover:shadow-[0_8px_20px_-4px_rgba(220,38,38,0.35)] " +
            "active:translate-y-0 active:scale-[0.98] " +
            "disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none disabled:shadow-none " +
            "focus-visible:ring-red-500",

        "Cancel" =>
            "text-slate-600 font-medium bg-transparent " +
            "hover:bg-slate-100 hover:text-ink " +
            "active:scale-[0.98] " +
            "disabled:opacity-50 disabled:cursor-not-allowed " +
            "focus-visible:ring-slate-300",

        "Ghost" =>
            "text-brand-500 font-medium bg-transparent " +
            "hover:text-brand-700 " +
            "focus-visible:ring-brand-400",

        _ => // Default
            "text-muted border border-slate-200 font-medium bg-white " +
            "hover:bg-slate-50 hover:border-slate-300 hover:text-ink " +
            "active:scale-[0.98] " +
            "disabled:opacity-50 disabled:cursor-not-allowed " +
            "focus-visible:ring-slate-400",
    };

    private string ComputedClass =>
        $"inline-flex items-center justify-center gap-1.5 rounded-xl {SizeClass} {VariantClass} " +
        "transition-[transform,box-shadow,background-color,border-color,color] duration-200 " +
        "[transition-timing-function:cubic-bezier(0.32,0.72,0,1)] " +
        "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-1 " +
        "cursor-pointer";

    private IReadOnlyDictionary<string, object> MergedAttributes
    {
        get
        {
            var merged = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);
            string extraClass = string.Empty;
            if (AdditionalAttributes is not null)
            {
                foreach (var kv in AdditionalAttributes)
                {
                    if (string.Equals(kv.Key, "class", StringComparison.OrdinalIgnoreCase))
                    {
                        extraClass = kv.Value?.ToString() ?? string.Empty;
                        continue;
                    }
                    merged[kv.Key] = kv.Value;
                }
            }
            merged["class"] = string.IsNullOrWhiteSpace(extraClass)
                ? ComputedClass
                : $"{ComputedClass} {extraClass}";
            return merged;
        }
    }

    private async Task HandleClick()
    {
        if (Disabled || Loading) return;
        await OnClick.InvokeAsync();
    }
}
