@namespace Bulletin.Board.Web.Client.Components.Buttons

<button
    type="@Type"
    class="@ComputedClass"
    @onclick="HandleClick"
    disabled="@(Disabled || IsLoading)"
    aria-disabled="@(Disabled || IsLoading)"
    aria-busy="@IsLoading">
    @if (IsLoading)
    {
        <svg class="w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
        </svg>
    }
    @if (!string.IsNullOrEmpty(Text))
    {
        <span>@Text</span>
    }
    @ChildContent
    @if (ShowTrailingArrow && !IsLoading)
    {
        <span class="w-6 h-6 rounded-full @TrailingArrowBubbleBg flex items-center justify-center flex-shrink-0" aria-hidden="true">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7" /><polyline points="7 7 17 7 17 17" />
            </svg>
        </span>
    }
</button>

@code {
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool IsLoading { get; set; } = false;
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool ShowTrailingArrow { get; set; } = true;
    [Parameter] public string TrailingArrowBubbleBg { get; set; } = "bg-white/20";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ComputedClass =>
        "flex items-center justify-center gap-2 bg-accent text-white font-medium px-5 py-2.5 rounded-full " +
        "transition-[transform,box-shadow] duration-200 [transition-timing-function:cubic-bezier(0.32,0.72,0,1)] " +
        "hover:-translate-y-0.5 hover:shadow-[0_12px_32px_-4px_rgba(249,115,22,0.4)] " +
        "active:translate-y-0 active:scale-[0.98] " +
        "disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none disabled:shadow-none " +
        "cursor-pointer " +
        (CssClass ?? string.Empty);

    private async Task HandleClick()
    {
        if (Disabled || IsLoading) return;
        await OnClick.InvokeAsync();
    }
}
