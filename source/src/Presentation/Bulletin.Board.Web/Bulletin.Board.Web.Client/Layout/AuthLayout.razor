@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> _localizer

@{
    var isRegister = Navigation.Uri.Contains("/register", StringComparison.OrdinalIgnoreCase);
}

<div class="grain-overlay" aria-hidden="true"></div>

<div class="auth-page" style="display:flex; min-height:100dvh; height:100dvh; overflow:hidden;">

    @if (isRegister)
    {
        <!-- REGISTER: [Formulario IZQUIERDO] | [Branding DERECHO] -->

        <!-- LEFT PANEL — form -->
        <div class="flex-1 flex items-center justify-center px-5 py-4 overflow-y-auto" style="background:#0B1628;">
            <div class="w-full" style="max-width:520px;">
                <!-- Mobile logo (only visible < lg) -->
                <div class="lg:hidden mb-4 flex items-center justify-center">
                    <img src="/images/brand/bulletin-dells-white-logo.png"
                         alt="Bulletin Dells"
                         style="height:28px; width:auto; object-fit:contain;" />
                </div>
                @Body
            </div>
        </div>

        <!-- RIGHT PANEL — branding (hidden on mobile) -->
        <div class="auth-bg relative hidden lg:flex flex-col justify-between px-10 py-8 overflow-hidden flex-shrink-0" style="width:44%;">
            <div class="auth-grid-lines" aria-hidden="true"></div>

            <!-- Ambient orbs -->
            <div class="orb-1 absolute top-1/3 -left-8 w-64 h-64 rounded-full pointer-events-none"
                 style="background:radial-gradient(circle, rgba(249,115,22,0.14) 0%, transparent 68%);"
                 aria-hidden="true"></div>
            <div class="orb-2 absolute bottom-1/4 -right-6 w-56 h-56 rounded-full pointer-events-none"
                 style="background:radial-gradient(circle, rgba(59,130,246,0.13) 0%, transparent 68%);"
                 aria-hidden="true"></div>

            <!-- Logo -->
            <div class="relative z-10 form-enter" style="animation-delay:0.05s;">
                <a href="/" aria-label="Bulletin Dells — Home">
                    <img src="/images/brand/bulletin-dells-white-logo.png"
                         alt="Bulletin Dells"
                         style="height:50px; width:auto; object-fit:contain;" />
                </a>
            </div>

            <!-- Center content -->
            <div class="relative z-10 flex-1 flex flex-col justify-center py-6 form-enter" style="animation-delay:0.15s;">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full mb-5"
                     style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1);width:fit-content;align-self:flex-start;">
                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-green-400" aria-hidden="true"></span>
                    <span class="text-white/70 text-xs font-medium uppercase tracking-widest">Wisconsin Dells, WI</span>
                </div>
                <h2 class="font-bold text-white leading-tight tracking-tight mb-4" style="font-size:3rem;">
                    @((MarkupString)_localizer["Auth_Register_HeadlineHtml"].Value)
                </h2>
                <p class="text-white/55 text-base font-light leading-relaxed mb-2" style="max-width:30ch;">
                    @_localizer["Auth_Register_Subtitle"]
                </p>
                <p class="text-white/30 text-sm mb-8">
                    @_localizer["Auth_Login_SubtitleEs"]
                </p>

                <!-- Feature list -->
                <div class="space-y-4" role="list" aria-label="Platform features">
                    <div class="flex items-start gap-3" role="listitem">
                        <div class="feature-dot flex-shrink-0" style="background:rgba(59,130,246,0.14);" aria-hidden="true">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#3B82F6" stroke-width="2.2"><polyline points="20 6 9 17 4 12"/></svg>
                        </div>
                        <div>
                            <p class="text-white/85 text-sm font-semibold">@_localizer["Auth_Feature_VerifiedProviders"]</p>
                            <p class="text-white/40 text-sm">@_localizer["Auth_Feature_VerifiedProvidersDesc"]</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3" role="listitem">
                        <div class="feature-dot flex-shrink-0" style="background:rgba(249,115,22,0.14);" aria-hidden="true">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="2.2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                        </div>
                        <div>
                            <p class="text-white/85 text-sm font-semibold">@_localizer["Auth_Feature_WhatsApp"]</p>
                            <p class="text-white/40 text-sm">@_localizer["Auth_Feature_WhatsAppDesc"]</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3" role="listitem">
                        <div class="feature-dot flex-shrink-0" style="background:rgba(74,222,128,0.11);" aria-hidden="true">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </div>
                        <div>
                            <p class="text-white/85 text-sm font-semibold">@_localizer["Auth_Feature_Bilingual"]</p>
                            <p class="text-white/40 text-sm">@_localizer["Auth_Feature_BilingualDesc"]</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bottom note -->
            <div class="relative z-10 form-enter" style="animation-delay:0.28s;">
                <p class="text-white/30 text-xs leading-relaxed">
                    @_localizer["Auth_Register_LegalFooter"]
                </p>
            </div>
        </div>
    }
    else
    {
        <!-- LOGIN: [Branding IZQUIERDO] | [Formulario DERECHO] -->

        <!-- LEFT PANEL — branding (hidden on mobile) -->
        <div class="auth-bg relative hidden lg:flex flex-col justify-between px-10 py-10 lg:px-14 lg:py-12 overflow-hidden flex-shrink-0" style="width:44%;">
            <div class="auth-grid-lines" aria-hidden="true"></div>

            <!-- Decorative orbs -->
            <div class="orb-1 absolute top-1/4 right-10 w-64 h-64 rounded-full pointer-events-none"
                 style="background:radial-gradient(circle, rgba(59,130,246,0.18) 0%, transparent 70%);"
                 aria-hidden="true"></div>
            <div class="orb-2 absolute bottom-1/3 left-0 w-80 h-80 rounded-full pointer-events-none"
                 style="background:radial-gradient(circle, rgba(249,115,22,0.12) 0%, transparent 70%);"
                 aria-hidden="true"></div>
            <div class="orb-3 absolute top-2/3 right-1/4 w-48 h-48 rounded-full pointer-events-none"
                 style="background:radial-gradient(circle, rgba(59,130,246,0.1) 0%, transparent 70%);"
                 aria-hidden="true"></div>

            <!-- Logo -->
            <div class="relative z-10 form-enter" style="animation-delay:0.05s;">
                <a href="/" aria-label="Bulletin Dells — Home">
                    <img src="/images/brand/bulletin-dells-white-logo.png"
                         alt="Bulletin Dells"
                         style="height:50px; width:auto; object-fit:contain;" />
                </a>
            </div>

            <!-- Center content -->
            <div class="relative z-10 flex-1 flex flex-col justify-center py-6 form-enter" style="animation-delay:0.15s;">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full mb-5"
                     style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1);width:fit-content;align-self:flex-start;">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-400 inline-block" aria-hidden="true"></span>
                    <span class="text-white/70 text-xs font-medium uppercase tracking-widest">Wisconsin Dells, WI</span>
                </div>
                <h1 class="font-bold text-white leading-tight tracking-tight mb-4" style="font-size:3rem;">
                    @((MarkupString)_localizer["Auth_Login_HeadlineHtml"].Value)
                </h1>
                <p class="text-white/55 text-base font-light leading-relaxed mb-2" style="max-width:30ch;">
                    @_localizer["Auth_Login_Subtitle"]
                </p>
                <p class="text-white/30 text-sm mb-8">
                    @_localizer["Auth_Login_SubtitleEs"]
                </p>

                <!-- Stats row -->
                <div class="flex gap-8" aria-label="Platform statistics">
                    <div>
                        <p class="text-white font-bold text-2xl">500+</p>
                        <p class="text-white/40 text-xs mt-0.5">@_localizer["Auth_Stat_Listings"]</p>
                    </div>
                    <div class="w-px bg-white/10" aria-hidden="true"></div>
                    <div>
                        <p class="text-white font-bold text-2xl">9</p>
                        <p class="text-white/40 text-xs mt-0.5">@_localizer["Auth_Stat_Categories"]</p>
                    </div>
                    <div class="w-px bg-white/10" aria-hidden="true"></div>
                    <div>
                        <p class="text-white font-bold text-2xl">EN/ES</p>
                        <p class="text-white/40 text-xs mt-0.5">@_localizer["Auth_Stat_Bilingual"]</p>
                    </div>
                </div>
            </div>

            <!-- Testimonial card at bottom -->
            <div class="relative z-10 hidden lg:block form-enter" style="animation-delay:0.28s;">
                <div class="testimonial-card p-4 max-w-xs">
                    <div class="flex gap-1 mb-2" role="img" aria-label="5 out of 5 stars">
                        @for (int i = 0; i < 5; i++)
                        {
                            <svg class="w-3.5 h-3.5 text-amber-400 fill-amber-400" viewBox="0 0 20 20" aria-hidden="true">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                        }
                    </div>
                    <p class="text-white/70 text-xs leading-relaxed">"@_localizer["Auth_Testimonial_Quote"]"</p>
                    <div class="flex items-center gap-2 mt-3">
                        <div class="w-6 h-6 rounded-full bg-brand-500 flex items-center justify-center text-white text-xs font-bold" aria-hidden="true">M</div>
                        <div>
                            <p class="text-white/80 text-xs font-medium">María G.</p>
                            <p class="text-white/30 text-xs">@_localizer["Auth_Testimonial_Role"]</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL — form -->
        <div class="flex-1 flex items-center justify-center px-5 py-4 overflow-y-auto" style="background:#0B1628;">
            <div class="w-full max-w-[400px]">
                <!-- Mobile logo (only visible < lg) -->
                <div class="lg:hidden mb-4 flex items-center justify-center">
                    <img src="/images/brand/bulletin-dells-white-logo.png"
                         alt="Bulletin Dells"
                         style="height:28px; width:auto; object-fit:contain;" />
                </div>
                @Body
            </div>
        </div>
    }

</div>

