@* TASK-30: Footer — variante 4 columnas (landing) y compact (resto de páginas), con tema dark/light *@

@inject IStringLocalizer<SharedResource> _localizer

<footer class="@_bgClass @_textClass @_borderTopClass @(IsCompact ? "py-4" : "pt-16 pb-8") transition-colors duration-300" role="contentinfo">
    @if (IsCompact)
    {
        <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-sm @_mutedClass">
            <span>@_localizer["Footer_Copyright"]</span>
            <nav class="flex items-center gap-4" aria-label="Footer legal links">
                <a href="/privacy" class="@_linkHoverClass transition-colors">@_localizer["Footer_Privacy"]</a>
                <a href="/terms"   class="@_linkHoverClass transition-colors">@_localizer["Footer_Terms"]</a>
            </nav>
        </div>
    }
    else
    {
        @* ── TASK-50: Footer variante 4 columnas ── *@
        <div class="max-w-6xl mx-auto px-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b @_borderClass">

                @* Col 1: Brand *@
                <div>
                    <a href="/" class="inline-flex items-center mb-3" aria-label="Bulletin Dells home">
                        <img src="@_logoSrc"
                             alt="Bulletin Dells"
                             class="h-9 w-auto" />
                    </a>
                    <p class="@_mutedClass text-sm leading-relaxed mb-4">
                        @_localizer["Footer_Tagline"]
                    </p>
                    <div class="flex items-center gap-3">
                        <a href="https://instagram.com/bulletindells" target="_blank" rel="noopener noreferrer"
                           aria-label="Instagram" class="@_socialClass transition-colors">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                                <circle cx="12" cy="12" r="4"/>
                                <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
                            </svg>
                        </a>
                        <a href="https://facebook.com/bulletindells" target="_blank" rel="noopener noreferrer"
                           aria-label="Facebook" class="@_socialClass transition-colors">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                            </svg>
                        </a>
                    </div>
                </div>

                @* Col 2: Quick Links *@
                <div>
                    <h3 class="@_headingClass font-semibold text-sm uppercase tracking-wider mb-4">
                        @_localizer["Footer_QuickLinks"]
                    </h3>
                    <ul class="space-y-2.5 text-sm @_mutedClass">
                        <li><a href="/"          class="@_linkHoverClass transition-colors">@_localizer["Nav_Home"]</a></li>
                        <li><a href="/browse"    class="@_linkHoverClass transition-colors">@_localizer["Nav_Browse"]</a></li>
                        <li><a href="/register"  class="@_linkHoverClass transition-colors">@_localizer["Footer_ListYourBusiness"]</a></li>
                        <li><a href="/about"     class="@_linkHoverClass transition-colors">@_localizer["Footer_About"]</a></li>
                    </ul>
                </div>

                @* Col 3: Categories *@
                <div>
                    <h3 class="@_headingClass font-semibold text-sm uppercase tracking-wider mb-4">
                        @_localizer["Footer_Categories"]
                    </h3>
                    <ul class="space-y-2.5 text-sm @_mutedClass">
                        <li><a href="/browse?category=car-rental"     class="@_linkHoverClass transition-colors">@_localizer["Cat_CarRental"]</a></li>
                        <li><a href="/browse?category=housing"         class="@_linkHoverClass transition-colors">@_localizer["Cat_Housing"]</a></li>
                        <li><a href="/browse?category=airport-rides"   class="@_linkHoverClass transition-colors">@_localizer["Cat_AirportRides"]</a></li>
                        <li><a href="/browse?category=mechanics"       class="@_linkHoverClass transition-colors">@_localizer["Cat_Mechanics"]</a></li>
                        <li><a href="/browse?category=beauty-wellness" class="@_linkHoverClass transition-colors">@_localizer["Cat_BeautyWellness"]</a></li>
                    </ul>
                </div>

                @* Col 4: Contact *@
                <div>
                    <h3 class="@_headingClass font-semibold text-sm uppercase tracking-wider mb-4">
                        @_localizer["Footer_Contact"]
                    </h3>
                    <ul class="space-y-3 text-sm @_mutedClass">
                        <li>
                            <a href="https://wa.me/15715550000" target="_blank" rel="noopener noreferrer"
                               class="flex items-center gap-2 @_linkHoverClass transition-colors">
                                <svg class="w-4 h-4 flex-shrink-0 text-green-500" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                                </svg>
                                WhatsApp
                            </a>
                        </li>
                        <li>
                            <a href="mailto:info@bulletindells.com"
                               class="flex items-center gap-2 @_linkHoverClass transition-colors">
                                <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                    <polyline points="22,6 12,13 2,6"/>
                                </svg>
                                info@bulletindells.com
                            </a>
                        </li>
                        <li class="flex items-start gap-2">
                            <svg class="w-4 h-4 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                <circle cx="12" cy="10" r="3"/>
                            </svg>
                            Wisconsin Dells, WI
                        </li>
                    </ul>
                </div>
            </div>

            @* Bottom bar *@
            <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm @_copyrightClass">
                <span>@_localizer["Footer_Copyright"]</span>
                <nav class="flex items-center gap-5" aria-label="Legal links">
                    <a href="/privacy" class="@_linkHoverClass transition-colors">@_localizer["Footer_Privacy"]</a>
                    <a href="/terms"   class="@_linkHoverClass transition-colors">@_localizer["Footer_Terms"]</a>
                </nav>
            </div>
        </div>
    }
</footer>

@code {
    [Parameter] public bool IsCompact { get; set; } = false;
    [Parameter] public bool IsDark    { get; set; } = true;

    private string _bgClass         => IsDark ? "bg-gray-900"          : "bg-white";
    private string _textClass       => IsDark ? "text-white"           : "text-gray-900";
    private string _mutedClass      => IsDark ? "text-gray-400"        : "text-gray-600";
    private string _headingClass    => IsDark ? "text-white"           : "text-gray-900";
    private string _borderClass     => IsDark ? "border-gray-800"      : "border-gray-200";
    private string _borderTopClass  => IsCompact && !IsDark ? "border-t border-gray-200" : string.Empty;
    private string _linkHoverClass  => IsDark ? "hover:text-white"     : "hover:text-gray-900";
    private string _socialClass     => IsDark ? "text-gray-500 hover:text-amber-400" : "text-gray-400 hover:text-amber-600";
    private string _copyrightClass  => IsDark ? "text-gray-500"        : "text-gray-500";
    private string _logoSrc         => IsDark
        ? "/images/brand/bulletin-dells-white-logo.png"
        : "/images/brand/bulletin-dells-logo.png";
}
