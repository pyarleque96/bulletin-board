@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject BulletinAuthStateProvider AuthProvider

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @* Only redirect in WASM. In the Blazor Server phase (InteractiveAuto,
                       first load with WASM not yet cached), IJSRuntime is unavailable so
                       InitializeAsync() resolves the TCS as anonymous even when the user
                       has a valid token in localStorage. Redirecting here would send the
                       user to /login before WASM can read the real token. *@
                    @if (OperatingSystem.IsBrowser())
                    {
                        <LoginRedirect />
                    }
                </NotAuthorized>
                <Authorizing>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView>
                <Bulletin.Board.Web.Client.Pages.NotFound/>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthProvider.InitializeAsync();
    }
}
