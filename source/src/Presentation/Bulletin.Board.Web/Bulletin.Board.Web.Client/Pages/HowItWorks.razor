@page "/how-it-works"

@using Bulletin.Board.Web.Client.States

@inject IStringLocalizer<SharedResource> _localizer
@inject NavBarState NavBarState
@implements IDisposable

<PageTitle>@_localizer["PageTitle_HowItWorks"]</PageTitle>

<style>
    /* ── vstep carousel ── */
    .vstep {
        transition:
            opacity 0.6s cubic-bezier(0.32,0.72,0,1),
            filter 0.6s cubic-bezier(0.32,0.72,0,1),
            transform 0.6s cubic-bezier(0.32,0.72,0,1);
        opacity: 0.35;
        filter: blur(2.5px);
        transform: scale(0.94);
        will-change: opacity, filter, transform;
    }
    .vstep.is-active { opacity:1; filter:blur(0); transform:scale(1); }
    .vstep.is-near   { opacity:0.55; filter:blur(1.5px); transform:scale(0.97); }

    .vstep-num {
        font-size: clamp(3.5rem, 6vw, 5rem);
        font-weight: 900;
        line-height: 1;
        letter-spacing: -0.04em;
        color: transparent;
        -webkit-text-stroke: 1.5px rgba(255,255,255,0.55);
        transition: -webkit-text-stroke-color 0.6s ease, color 0.6s ease, text-shadow 0.6s ease;
    }
    .vstep.is-active .vstep-num {
        color: #ffffff;
        -webkit-text-stroke-color: #ffffff;
        text-shadow: 0 0 24px rgba(249,115,22,0.55), 0 0 48px rgba(249,115,22,0.25);
    }

    .vstep-connector {
        position: absolute;
        left: 1.75rem;
        top: 5rem;
        width: 1px;
        height: calc(100% - 3rem);
        background: linear-gradient(180deg, rgba(255,255,255,0.20), rgba(255,255,255,0.04));
        pointer-events: none;
    }

    .vstep-dot {
        transition: background-color 0.4s ease, transform 0.4s ease, box-shadow 0.4s ease;
    }
    .vstep.is-active .vstep-dot {
        background-color: #F97316;
        transform: scale(1.4);
        box-shadow: 0 0 0 4px rgba(249,115,22,0.18), 0 0 16px rgba(249,115,22,0.45);
    }

    /* ── step connector (horizontal) ── */
    .step-connector { position: relative; }
    .step-connector::after {
        content: '';
        position: absolute;
        top: 24px;
        left: calc(50% + 32px);
        width: calc(100% - 64px);
        height: 1px;
        background: linear-gradient(90deg, rgba(30,41,59,0.15), rgba(30,41,59,0.06));
    }
    @@media (max-width: 767px) { .step-connector::after { display: none; } }

    .step-connector-dark::after {
        background: linear-gradient(90deg, rgba(255,255,255,0.15), rgba(255,255,255,0.06));
    }

    /* ── accordion ── */
    .accordion-body { max-height: 0; overflow: hidden; transition: max-height 0.4s cubic-bezier(0.32,0.72,0,1); }
    .accordion-item.open .accordion-body { max-height: 200px; }
    .accordion-item.open .accordion-chevron { transform: rotate(180deg); }
    .accordion-chevron { transition: transform 0.3s cubic-bezier(0.32,0.72,0,1); }

    /* ── card hover spring ── */
    .card-hover { transition: transform 0.4s cubic-bezier(0.32,0.72,0,1), box-shadow 0.4s cubic-bezier(0.32,0.72,0,1); cursor: default; }
    .card-hover:hover { transform: translateY(-4px); box-shadow: 0 24px 64px -12px rgba(30,41,59,0.14); }

    /* ── path card hover ── */
    .path-card { transition: transform 0.35s cubic-bezier(0.32,0.72,0,1), box-shadow 0.35s cubic-bezier(0.32,0.72,0,1); }
    .path-card:hover { transform: translateY(-3px); box-shadow: 0 20px 56px -12px rgba(30,41,59,0.13); }

    /* ── VIP tier highlight ── */
    .tier-vip { box-shadow: 0 0 0 2px rgba(249,115,22,0.3), 0 16px 48px -8px rgba(249,115,22,0.12); }

    /* ── section eyebrow (local override for blue default) ── */
    .hiw-section-eyebrow {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 4px 12px; border-radius: 9999px;
        background: #eff6ff; color: #2563eb;
        font-size: 10px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    }

    /* ── buttons ── */
    .hiw-btn-primary {
        transition: transform 0.2s cubic-bezier(0.32,0.72,0,1), box-shadow 0.2s cubic-bezier(0.32,0.72,0,1);
    }
    .hiw-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 32px -4px rgba(249,115,22,0.35); }
    .hiw-btn-primary:active { transform: scale(0.98); }

    .hiw-btn-secondary {
        transition: transform 0.2s cubic-bezier(0.32,0.72,0,1), box-shadow 0.2s ease;
    }
    .hiw-btn-secondary:hover { transform: translateY(-1px); box-shadow: 0 8px 24px -4px rgba(30,41,59,0.12); }
    .hiw-btn-secondary:active { transform: scale(0.98); }

    /* ── double bezel (local to avoid conflicts) ── */
    .hiw-bezel-outer {
        padding: 6px; border-radius: 2rem;
        background: rgba(30,41,59,0.02);
        box-shadow: 0 0 0 1px rgba(30,41,59,0.06);
    }
    .hiw-bezel-inner {
        border-radius: calc(2rem - 0.375rem);
        background: #ffffff;
        box-shadow: inset 0 1px 1px rgba(255,255,255,0.9);
        overflow: hidden;
    }
</style>

@* ═══════════════════════════════════════════════
   HERO — Split Dual-Path, dark navy + orange tint
   ═══════════════════════════════════════════════ *@
<section class="min-h-[100dvh] flex items-center pt-28 pb-16 px-4 relative overflow-hidden"
         style="background: linear-gradient(145deg, #071526 0%, #0D1E33 45%, #132840 80%, #1A3350 100%);"
         aria-labelledby="hero-heading">

    @* Subtle grid lines *@
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
         style="background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px); background-size: 70px 70px; z-index: 0;"></div>

    @* Orange tint blooms *@
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
         style="background: radial-gradient(ellipse at 85% 30%, rgba(249,115,22,0.10) 0%, transparent 55%), radial-gradient(ellipse at 15% 80%, rgba(249,115,22,0.05) 0%, transparent 50%);"></div>

    @* Soft white orbs *@
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
        <div class="absolute top-1/4 right-1/4 w-96 h-96 rounded-full bg-white/5 blur-3xl"></div>
        <div class="absolute bottom-1/4 left-1/3 w-64 h-64 rounded-full bg-white/[0.06] blur-2xl"></div>
    </div>

    <div class="relative z-10 w-full max-w-6xl mx-auto">
        <div class="grid md:grid-cols-12 gap-12 lg:gap-16 items-center">

            @* LEFT — eyebrow + H1 + subtitle + 2 CTAs *@
            <div class="md:col-span-7">

                <div class="fade-up mb-5">
                    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/15 text-white/90 text-[10px] uppercase tracking-[0.18em] font-semibold border border-white/20 backdrop-blur-sm">
                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                        @_localizer["HowItWorks_Hero_Eyebrow"]
                    </span>
                </div>

                <h1 id="hero-heading" class="fade-up text-5xl md:text-6xl font-black text-white leading-[1.02] tracking-tighter mb-5"
                    style="transition-delay: 80ms;">
                    @_localizer["HowItWorks_Hero_Title"]
                </h1>

                <p class="fade-up text-lg text-white/70 leading-relaxed max-w-[46ch] mb-8"
                   style="transition-delay: 160ms;">
                    @_localizer["HowItWorks_Hero_Subtitle"]
                </p>

                <div class="fade-up flex flex-col sm:flex-row gap-3" style="transition-delay: 240ms;">
                    <a href="/browse"
                       class="hiw-btn-secondary group inline-flex items-center justify-center gap-2 bg-white border border-slate-200 text-ink font-semibold text-sm px-6 py-3 rounded-full shadow-soft cursor-pointer">
                        @_localizer["HowItWorks_Hero_CtaBrowse"]
                        <span class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center group-hover:bg-blue-100 transition-colors duration-200" aria-hidden="true">
                            <svg class="w-3.5 h-3.5 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </span>
                    </a>
                    <a href="/register"
                       class="hiw-btn-primary group inline-flex items-center justify-center gap-2 bg-accent text-white font-semibold text-sm px-6 py-3 rounded-full cursor-pointer">
                        @_localizer["HowItWorks_Hero_CtaProvider"]
                        <span class="w-6 h-6 rounded-full bg-black/[0.10] flex items-center justify-center group-hover:bg-black/[0.18] transition-colors duration-200" aria-hidden="true">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
                        </span>
                    </a>
                </div>

            </div>

            @* RIGHT — vertical timeline carousel *@
            <div class="md:col-span-5 fade-up" style="transition-delay: 320ms;">
                <div class="relative" id="vstep-carousel" aria-label="Process timeline" role="region">

                    <div class="vstep-connector" aria-hidden="true"></div>

                    <ol class="relative flex flex-col gap-6" role="list">

                        <li class="vstep is-active flex items-start gap-5" data-vstep-index="0">
                            <span class="vstep-dot relative z-10 flex-shrink-0 mt-6 ml-[1.4375rem] -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-white/30" aria-hidden="true"></span>
                            <a href="#customers-heading" class="block group cursor-pointer flex-1 min-w-0">
                                <span class="vstep-num block">01</span>
                                <span class="block mt-1.5 text-sm font-bold text-white tracking-tight">@_localizer["HowItWorks_HeroCarousel_Step1_Label"]</span>
                                <span class="block text-xs text-white/60 mt-1 leading-snug max-w-[28ch]">@_localizer["HowItWorks_HeroCarousel_Step1_Hint"]</span>
                            </a>
                        </li>

                        <li class="vstep flex items-start gap-5" data-vstep-index="1">
                            <span class="vstep-dot relative z-10 flex-shrink-0 mt-6 ml-[1.4375rem] -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-white/30" aria-hidden="true"></span>
                            <a href="#providers-heading" class="block group cursor-pointer flex-1 min-w-0">
                                <span class="vstep-num block">02</span>
                                <span class="block mt-1.5 text-sm font-bold text-white tracking-tight">@_localizer["HowItWorks_HeroCarousel_Step2_Label"]</span>
                                <span class="block text-xs text-white/60 mt-1 leading-snug max-w-[28ch]">@_localizer["HowItWorks_HeroCarousel_Step2_Hint"]</span>
                            </a>
                        </li>

                        <li class="vstep flex items-start gap-5" data-vstep-index="2">
                            <span class="vstep-dot relative z-10 flex-shrink-0 mt-6 ml-[1.4375rem] -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-white/30" aria-hidden="true"></span>
                            <a href="#trust-heading" class="block group cursor-pointer flex-1 min-w-0">
                                <span class="vstep-num block">03</span>
                                <span class="block mt-1.5 text-sm font-bold text-white tracking-tight">@_localizer["HowItWorks_HeroCarousel_Step3_Label"]</span>
                                <span class="block text-xs text-white/60 mt-1 leading-snug max-w-[28ch]">@_localizer["HowItWorks_HeroCarousel_Step3_Hint"]</span>
                            </a>
                        </li>

                        <li class="vstep flex items-start gap-5" data-vstep-index="3">
                            <span class="vstep-dot relative z-10 flex-shrink-0 mt-6 ml-[1.4375rem] -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-white/30" aria-hidden="true"></span>
                            <a href="#faq-heading" class="block group cursor-pointer flex-1 min-w-0">
                                <span class="vstep-num block">04</span>
                                <span class="block mt-1.5 text-sm font-bold text-white tracking-tight">@_localizer["HowItWorks_HeroCarousel_Step4_Label"]</span>
                                <span class="block text-xs text-white/60 mt-1 leading-snug max-w-[28ch]">@_localizer["HowItWorks_HeroCarousel_Step4_Hint"]</span>
                            </a>
                        </li>

                    </ol>
                </div>
            </div>

        </div>
    </div>
</section>


@* ═══════════════════════════════════════════════
   FOR CUSTOMERS — 4 numbered steps
   ═══════════════════════════════════════════════ *@
<section class="py-24 px-4 bg-white border-y border-slate-100" aria-labelledby="customers-heading">
    <div class="max-w-6xl mx-auto">

        <div class="text-center mb-14 fade-up">
            <div class="hiw-section-eyebrow mb-4 mx-auto" style="background:#dbeafe; color:#2563eb;">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                @_localizer["HowItWorks_Customers_Eyebrow"]
            </div>
            <h2 id="customers-heading" class="text-3xl sm:text-4xl font-black text-ink tracking-tighter">@_localizer["HowItWorks_Customers_Title"]</h2>
            <p class="text-muted text-base mt-3 max-w-[44ch] mx-auto leading-relaxed">@_localizer["HowItWorks_Customers_Subtitle"]</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 fade-up" data-stagger>

            <div class="step-connector stagger-child text-center">
                <div class="w-14 h-14 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center mx-auto mb-5 shadow-soft">
                    <span class="text-blue-600 font-black text-xl" aria-hidden="true">1</span>
                </div>
                <h3 class="font-bold text-ink text-sm mb-2">@_localizer["HowItWorks_Customers_Step1_Title"]</h3>
                <p class="text-muted text-xs leading-relaxed">@_localizer["HowItWorks_Customers_Step1_Body"]</p>
            </div>

            <div class="step-connector stagger-child text-center">
                <div class="w-14 h-14 rounded-2xl bg-green-50 border border-green-100 flex items-center justify-center mx-auto mb-5 shadow-soft">
                    <span class="text-green-600 font-black text-xl" aria-hidden="true">2</span>
                </div>
                <h3 class="font-bold text-ink text-sm mb-2">@_localizer["HowItWorks_Customers_Step2_Title"]</h3>
                <p class="text-muted text-xs leading-relaxed">@_localizer["HowItWorks_Customers_Step2_Body"]</p>
            </div>

            <div class="step-connector stagger-child text-center">
                <div class="w-14 h-14 rounded-2xl bg-orange-50 border border-orange-100 flex items-center justify-center mx-auto mb-5 shadow-soft">
                    <span class="text-accent font-black text-xl" aria-hidden="true">3</span>
                </div>
                <h3 class="font-bold text-ink text-sm mb-2">@_localizer["HowItWorks_Customers_Step3_Title"]</h3>
                <p class="text-muted text-xs leading-relaxed">@_localizer["HowItWorks_Customers_Step3_Body"]</p>
            </div>

            <div class="stagger-child text-center">
                <div class="w-14 h-14 rounded-2xl bg-amber-50 border border-amber-100 flex items-center justify-center mx-auto mb-5 shadow-soft">
                    <span class="text-amber-600 font-black text-xl" aria-hidden="true">4</span>
                </div>
                <h3 class="font-bold text-ink text-sm mb-2">@_localizer["HowItWorks_Customers_Step4_Title"]</h3>
                <p class="text-muted text-xs leading-relaxed">@_localizer["HowItWorks_Customers_Step4_Body"]</p>
            </div>

        </div>
    </div>
</section>


@* ═══════════════════════════════════════════════
   FOR PROVIDERS — 5 numbered steps, dark bg
   ═══════════════════════════════════════════════ *@
