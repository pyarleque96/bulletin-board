    <div class="max-w-6xl mx-auto">

        <div class="text-center mb-14 fade-up">
            <div class="inline-flex items-center gap-2 mb-4">
                <span class="px-4 py-1.5 rounded-full bg-white/10 border border-white/[0.12] text-white/80 text-[10px] uppercase tracking-[0.18em] font-semibold flex items-center gap-2">
                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                    @_localizer["HowItWorks_Providers_Eyebrow"]
                </span>
            </div>
            <h2 id="providers-heading" class="text-3xl sm:text-4xl font-black text-white tracking-tighter">@_localizer["HowItWorks_Providers_Title"]</h2>
            <p class="text-white/55 text-base mt-3 max-w-[48ch] mx-auto leading-relaxed">@_localizer["HowItWorks_Providers_Subtitle"]</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 mb-12 fade-up" data-stagger>

            <div class="step-connector step-connector-dark stagger-child text-center">
                <div class="w-14 h-14 rounded-2xl bg-white/10 border border-white/15 flex items-center justify-center mx-auto mb-5"
                     style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.1);">
                    <span class="text-white font-black text-xl" aria-hidden="true">1</span>
                </div>
                <h3 class="text-white font-bold text-sm mb-2">@_localizer["HowItWorks_Providers_Step1_Title"]</h3>
                <p class="text-white/45 text-xs leading-relaxed">@_localizer["HowItWorks_Providers_Step1_Body"]</p>
            </div>

            <div class="step-connector step-connector-dark stagger-child text-center">
                <div class="w-14 h-14 rounded-2xl bg-white/10 border border-white/15 flex items-center justify-center mx-auto mb-5"
                     style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.1);">
                    <span class="text-white font-black text-xl" aria-hidden="true">2</span>
                </div>
                <h3 class="text-white font-bold text-sm mb-2">@_localizer["HowItWorks_Providers_Step2_Title"]</h3>
                <p class="text-white/45 text-xs leading-relaxed">@_localizer["HowItWorks_Providers_Step2_Body"]</p>
            </div>

            <div class="step-connector step-connector-dark stagger-child text-center">
                <div class="w-14 h-14 rounded-2xl bg-white/10 border border-white/15 flex items-center justify-center mx-auto mb-5"
                     style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.1);">
                    <span class="text-white font-black text-xl" aria-hidden="true">3</span>
                </div>
                <h3 class="text-white font-bold text-sm mb-2">@_localizer["HowItWorks_Providers_Step3_Title"]</h3>
                <p class="text-white/45 text-xs leading-relaxed">@_localizer["HowItWorks_Providers_Step3_Body"]</p>
            </div>

            <div class="step-connector step-connector-dark stagger-child text-center">
                <div class="w-14 h-14 rounded-2xl bg-white/10 border border-white/15 flex items-center justify-center mx-auto mb-5"
                     style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.1);">
                    <span class="text-white font-black text-xl" aria-hidden="true">4</span>
                </div>
                <h3 class="text-white font-bold text-sm mb-2">@_localizer["HowItWorks_Providers_Step4_Title"]</h3>
                <p class="text-white/45 text-xs leading-relaxed">@_localizer["HowItWorks_Providers_Step4_Body"]</p>
            </div>

            <div class="stagger-child text-center">
                <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-5"
                     style="background: rgba(249,115,22,0.20); border: 1px solid rgba(249,115,22,0.35); box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);">
                    <span class="text-accent font-black text-xl" aria-hidden="true">5</span>
                </div>
                <h3 class="text-white font-bold text-sm mb-2">@_localizer["HowItWorks_Providers_Step5_Title"]</h3>
                <p class="text-white/45 text-xs leading-relaxed">@_localizer["HowItWorks_Providers_Step5_Body"]</p>
            </div>

        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 fade-up">
            <a href="/register"
               class="hiw-btn-primary group flex items-center gap-3 bg-accent text-white font-bold px-7 py-3.5 rounded-full cursor-pointer text-sm">
                @_localizer["HowItWorks_Providers_CtaPrimary"]
                <span class="w-8 h-8 rounded-full bg-black/[0.12] flex items-center justify-center group-hover:bg-black/[0.20] transition-colors duration-200" aria-hidden="true">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
                </span>
            </a>
            <a href="/browse"
               class="flex items-center gap-2 text-white/55 hover:text-white text-sm font-medium transition-colors duration-200 cursor-pointer">
                @_localizer["HowItWorks_Providers_CtaSecondary"]
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
        </div>

    </div>
</section>


@* ═══════════════════════════════════════════════
   TRUST & SAFETY — 4 rule cards
   ═══════════════════════════════════════════════ *@
<section class="py-24 px-4 bg-surface" aria-labelledby="trust-heading">
    <div class="max-w-6xl mx-auto">

        <div class="text-center mb-14 fade-up">
            <div class="hiw-section-eyebrow mb-4 mx-auto" style="background:#dcfce7; color:#16a34a;">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
