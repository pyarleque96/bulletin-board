@* ── IntersectionObserver for fade-up and stagger-child reveals ── *@
<script>
(function () {
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // fade-up observer
    var fadeObs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
            if (e.isIntersecting) {
                e.target.classList.add('visible');
                fadeObs.unobserve(e.target);
            }
        });
    }, { threshold: 0.08, rootMargin: '0px 0px -48px 0px' });

    if (!reduced) {
        document.querySelectorAll('.fade-up').forEach(function (el) { fadeObs.observe(el); });
    } else {
        document.querySelectorAll('.fade-up').forEach(function (el) { el.classList.add('visible'); });
    }

    // stagger-child observer
    var staggerObs = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
            if (entry.isIntersecting) {
                var children = entry.target.querySelectorAll('.stagger-child');
                children.forEach(function (child, i) {
                    if (reduced) {
                        child.classList.add('visible');
                    } else {
                        setTimeout(function () { child.classList.add('visible'); }, i * 90);
                    }
                });
                staggerObs.unobserve(entry.target);
            }
        });
    }, { threshold: 0.1 });
    document.querySelectorAll('[data-stagger]').forEach(function (el) { staggerObs.observe(el); });
})();
</script>

@* ── Vertical timeline carousel ── *@
<script>
(function () {
    var steps = Array.from(document.querySelectorAll('#vstep-carousel .vstep'));
    if (!steps.length) return;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) return;

    var active = 0;
    var setActive = function (idx) {
        steps.forEach(function (el, i) {
            el.classList.remove('is-active', 'is-near');
            if (i === idx) { el.classList.add('is-active'); }
            else if (Math.abs(i - idx) === 1) { el.classList.add('is-near'); }
        });
    };
    setActive(active);

    var timer = setInterval(function () {
        active = (active + 1) % steps.length;
        setActive(active);
    }, 3200);

    var carousel = document.getElementById('vstep-carousel');
    var pause = function () { clearInterval(timer); timer = null; };
    var resume = function () {
        if (timer) return;
        timer = setInterval(function () {
            active = (active + 1) % steps.length;
            setActive(active);
        }, 3200);
    };

    carousel.addEventListener('mouseenter', pause);
    carousel.addEventListener('mouseleave', resume);
    carousel.addEventListener('focusin',    pause);
    carousel.addEventListener('focusout',   resume);

    steps.forEach(function (el) {
        el.addEventListener('click', function () {
            var idx = parseInt(el.dataset.vstepIndex, 10);
            if (!Number.isNaN(idx)) {
                active = idx;
                setActive(active);
                pause();
                setTimeout(resume, 4000);
            }
        });
    });
})();
</script>

@* ── Accordion ── *@
<script>
(function () {
    document.querySelectorAll('.accordion-trigger').forEach(function (trigger) {
        trigger.addEventListener('click', function () {
            var item   = trigger.closest('.accordion-item');
            var isOpen = item.classList.contains('open');

            document.querySelectorAll('.accordion-item.open').forEach(function (openItem) {
                openItem.classList.remove('open');
                openItem.querySelector('.accordion-trigger').setAttribute('aria-expanded', 'false');
            });

            if (!isOpen) {
                item.classList.add('open');
                trigger.setAttribute('aria-expanded', 'true');
            }
        });
    });
})();
</script>

