@page "/manage"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Bulletin.Board.Web.Client.States
@using Bulletin.Board.Web.Client.Services.Http
@using Bulletin.Board.Web.Client.Services.Common
@using Bulletin.Board.Web.Client.Components.Buttons

@inject NavigationManager Navigation
@inject NavBarState NavBarState
@inject FooterState FooterState
@inject IStringLocalizer<SharedResource> _localizer
@inject IListingService ListingService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>My Listings | Bulletin Dells</PageTitle>

<style>
    /* status-* y tier-* en componentes Badges/*.razor.css */
    /* tier-regular: sin badge visible */
    .tier-regular  { background:#f1f5f9; color:#475569; border:1px solid #cbd5e1; }

    .manage-card {
        transition: box-shadow 0.3s cubic-bezier(0.32,0.72,0,1);
        box-shadow: 0 1px 2px rgba(30,41,59,0.06),
                    0 2px 8px -2px rgba(30,41,59,0.08);
    }
    .manage-card:hover {
        box-shadow: 0 0 12px 0 rgba(30,41,59,0.12),
                    0 0 40px 0 rgba(30,41,59,0.18);
    }

    /* VIP — shadow naranja llamativo (mismo tono que el home) + borde naranja.
       Solo sombra, sin transform. Offset vertical reducido en reposo. */
    .manage-card-vip {
        box-shadow: 0 1px 2px rgba(249,115,22,0.08),
                    2px 3px 12px -4px rgba(249,115,22,0.18),
                    1px 2px 32px -16px rgba(249,115,22,0.18);
    }
    .manage-card-vip:hover {
        box-shadow: 0 0 2px 0 rgba(249,115,22,0.10),
                    0 0 24px 0 rgba(249,115,22,0.28),
                    0 0 56px 0 rgba(249,115,22,0.22);
    }

    /* Listing pausado — la card entera se atenúa, salvo el action bar (para que
       el usuario pueda reanudar/borrar sin pelearse con el contraste). */
    .manage-card-paused .card-body-dim { opacity: 0.35; transition: opacity 0.25s ease; }

    @@keyframes pulse-dot { 0%,100%{opacity:1} 50%{opacity:.4} }
    .pulse-dot { animation:pulse-dot 2s ease-in-out infinite; }

    [data-tooltip] { position:relative; }
    [data-tooltip]::after {
        content:attr(data-tooltip); position:absolute; bottom:calc(100% + 8px);
        left:50%; transform:translateX(-50%); white-space:nowrap;
        background:#1e293b; color:#fff; font-size:11px; padding:5px 9px;
        border-radius:8px; pointer-events:none; opacity:0;
        transition:opacity 0.15s ease; z-index:50;
    }
    [data-tooltip]:hover::after { opacity:1; }
</style>

@* ── BANDA HEADER (sticky con filtros) ── *@
<div class="bg-white/95 border-b border-slate-100 px-4 pt-24 pb-0 sticky top-0 z-30 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-4">

        <nav class="flex items-center gap-1.5 text-xs text-muted mb-4" aria-label="Breadcrumb">
            <span class="text-ink font-medium" aria-current="page">@_localizer["Nav_Manage"]</span>
        </nav>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-5">
            <div>
                <h1 class="text-2xl font-bold text-ink tracking-tight">
                    My Listings
                    @* ES: Mis Anuncios *@
                </h1>
                <p class="text-sm text-muted mt-0.5" aria-live="polite">
                    @if (_total.HasValue)
                    {
                        <span class="font-medium text-ink tabular-nums">
                            @string.Format(_localizer["Manage_Index_ShowingXofY"], _items.Count, _total.Value)
                        </span>
                    }
                    else
                    {
                        <span class="inline-block align-[-2px] h-3.5 w-10 bg-slate-100 rounded animate-pulse"></span>
                    }
                    <span>&nbsp;·&nbsp;@_localizer["Banner_EditingReturnsPending"]</span>
                </p>
            </div>

            <ManageLinkButton Href="/manage/new"
                              Variant="Primary"
                              Size="Small"
                              aria-label="Create a new listing / Crear un nuevo anuncio"
                              class="flex-shrink-0">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                New Listing
                @* ES: Nuevo Anuncio *@
            </ManageLinkButton>
        </div>

        @* Filters *@
        <div class="flex flex-col sm:flex-row sm:items-center gap-3 pb-4">

            <div class="relative">
                <label for="filter-status" class="sr-only">Filter by status / Filtrar por estado</label>
                <select id="filter-status"
                        @bind="_filterStatus"
                        @bind:after="ApplyFilters"
                        class="appearance-none pl-3 pr-9 py-2 text-xs text-ink bg-white border border-slate-200 rounded-xl hover:border-slate-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 transition-colors cursor-pointer">
                    <option value="">All statuses</option>
                    <option value="Pending">Pending</option>
                    <option value="Approved">Approved</option>
                    <option value="Rejected">Rejected</option>
                    <option value="NeedsChanges">Needs Changes</option>
                </select>
                <svg class="w-3.5 h-3.5 text-muted absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </div>

            <div class="relative">
                <label for="filter-type" class="sr-only">Filter by type / Filtrar por tipo</label>
                <select id="filter-type"
                        @bind="_filterCategory"
                        @bind:after="ApplyFilters"
                        class="appearance-none pl-3 pr-9 py-2 text-xs text-ink bg-white border border-slate-200 rounded-xl hover:border-slate-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 transition-colors cursor-pointer">
                    <option value="">All types</option>
                    <option value="car-rental">Car rental</option>
                    <option value="housing">Housing</option>
                    <option value="jobs">Jobs</option>
                    <option value="beauty">Beauty</option>
                    <option value="mechanic">Mechanic</option>
                    <option value="transport">Transport</option>
                </select>
                <svg class="w-3.5 h-3.5 text-muted absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </div>

            <div class="relative flex-1 min-w-[180px]">
                <label for="search-listings" class="sr-only">Search listings / Buscar anuncios</label>
                <svg class="w-3.5 h-3.5 text-muted absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input id="search-listings" type="search" placeholder="Search listings…"
                       @bind="_searchQuery"
                       @bind:after="ApplyFilters"
                       class="w-full pl-8 pr-3 py-2 text-xs text-ink bg-white border border-slate-200 rounded-xl placeholder-muted hover:border-slate-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 transition-colors" />
            </div>
        </div>
    </div>
</div>

@* ── MAIN CONTENT ── *@
<main class="max-w-6xl mx-auto px-4 py-8 w-full" id="listings-main" aria-label="My listings / Mis anuncios">

    @* Error banner *@
    @if (_errorKey is not null)
    {
        <ApiErrorBanner MessageKey="@_errorKey" RawDetail="@_errorDetail" />
    }

    @* Loading skeletons — primera carga *@
    @if (_state == LoadState.InitialLoading)
    {
        <ul class="space-y-4" aria-busy="true" aria-label="@_localizer["Manage_Index_LoadingInitial"]">
            @for (int i = 0; i < 4; i++)
            {
                <SkeletonListingCard />
            }
        </ul>
    }

    @* Empty state *@
    @if (_state == LoadState.Ready && _items.Count == 0)
    {
        <ManageEmptyState Title="@_localizer["Manage_Index_EmptyTitle"]"
                          Description="@_localizer["Manage_Index_EmptyDescription"]">
            <Cta>
                <ManageLinkButton Href="/manage/new" Variant="Primary" Size="Medium">
                    + @_localizer["Manage_NewListing"]
                </ManageLinkButton>
            </Cta>
        </ManageEmptyState>
    }

    @* Lista *@
    @if (_state == LoadState.Ready && _items.Count > 0)
    {
        <ul class="space-y-4" role="list">
            @foreach (var listing in _items)
            {
                <li>
                <article class="manage-card @CardExtraClass(listing) bg-white rounded-2xl border @BorderClass(listing)"
                         aria-label="@listing.TitleEn">

                    @* Status banner for non-approved listings *@
                    @if (listing.Status == "Pending")
                    {
                        <div class="flex items-center gap-2 px-4 py-2 bg-amber-50 border-b border-amber-100 rounded-t-2xl">
                            <span class="pulse-dot w-1.5 h-1.5 rounded-full bg-amber-500 inline-block" aria-hidden="true"></span>
                            <span class="text-[11px] font-semibold text-amber-800 uppercase tracking-wide">
                                Awaiting GM approval — not visible to the public
                                @* ES: En espera de aprobación del GM — no visible al público *@
                            </span>
                        </div>
                    }
                    else if (listing.Status == "Rejected")
                    {
                        <div class="flex items-center gap-2 px-4 py-2 bg-red-50 border-b border-red-100 rounded-t-2xl">
                            <svg class="w-3.5 h-3.5 text-red-500 flex-shrink-0" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                            </svg>
                            <span class="text-[11px] font-semibold text-red-800 uppercase tracking-wide">
                                Rejected by GM — see feedback below
                                @* ES: Rechazado por el GM — ver comentarios abajo *@
                            </span>
                        </div>
                    }
                    else if (listing.Status == "NeedsChanges")
                    {
                        <div class="flex items-center gap-2 px-4 py-2 bg-orange-50 border-b border-orange-100 rounded-t-2xl">
                            <span class="text-[11px] font-semibold text-orange-800 uppercase tracking-wide">
                                Needs Changes — review GM feedback
                                @* ES: Requiere cambios — revisar comentarios del GM *@
                            </span>
                        </div>
                    }

                    <div class="p-5">
                        <div class="card-body-dim flex flex-col sm:flex-row sm:items-start gap-4">

                            <div class="w-full sm:w-20 h-16 sm:h-20 rounded-xl overflow-hidden flex-shrink-0 bg-slate-100">
                                <div class="w-full h-full bg-slate-200 flex items-center justify-center" aria-hidden="true">
                                    <svg class="w-8 h-8 text-slate-300" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                                        <circle cx="8.5" cy="8.5" r="1.5"/>
                                        <polyline points="21 15 16 10 5 21"/>
                                    </svg>
                                </div>
                            </div>

                            <div class="flex-1 min-w-0">
                                <div class="flex flex-wrap items-center gap-2 mb-1">
                                    @* Category badge — emoji + color por categoría *@
                                    <CategoryBadge Slug="@listing.CategorySlug" />

                                    @* Status badge — componentes canónicos de manage/index.html *@
                                    @if (listing.Status == "Approved")
                                    {
                                        <ApprovedBadge />
                                    }
                                    else if (listing.Status == "Pending")
                                    {
                                        <PendingBadge />
                                    }
                                    else if (listing.Status == "Rejected")
                                    {
                                        <RejectedBadge />
                                    }
                                    else if (listing.Status == "NeedsChanges")
                                    {
                                        <NeedsChangesBadge />
                                    }

                                    @* Verified no se muestra en /manage — es atributo del provider, no del listing *@
                                    @if (listing.Tier == "VIP")
                                    {
                                        <VipBadge />
                                    }
                                </div>
                                <h2 class="text-base font-semibold text-ink leading-snug truncate">@listing.TitleEn</h2>
                                <p class="text-xs text-muted mt-0.5 italic truncate">@listing.TitleEs</p>
                            </div>
                        </div>

                        @* Action bar *@
                        <div class="border-t border-slate-100 mt-4 pt-4">
                            <div class="flex flex-wrap items-center gap-2">
                                <ManageLinkButton Href="@($"/manage/{listing.Id}")"
                                                  Variant="Primary"
                                                  Size="Compact"
                                                  aria-label="Manage this listing / Gestionar este anuncio">
                                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                                    </svg>
                                    Manage
                                </ManageLinkButton>

                                <ManageLinkButton Href="@($"/manage/{listing.Id}")"
                                                  Variant="Default"
                                                  Size="Compact"
                                                  data-tooltip="Editing sends listing back to Pending review"
                                                  aria-label="Edit listing info / Editar información del anuncio">
                                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                    </svg>
                                    Edit
                                </ManageLinkButton>

                                @if (listing.IsPausedByOwner)
                                {
                                    <ManageActionButton Variant="Default"
                                                        Size="Compact"
                                                        OnClick="() => ResumeListingAsync(listing.Id)"
                                                        Disabled="@_busyIds.Contains(listing.Id)"
                                                        class="text-green-700 border-green-200 hover:bg-green-50 hover:border-green-300 hover:text-green-800"
                                                        aria-label="Resume this listing / Reanudar este anuncio">
                                        <svg class="w-3.5 h-3.5 text-green-600" viewBox="0 0 24 24" fill="currentColor"
                                             stroke="currentColor" stroke-width="1" stroke-linejoin="round" aria-hidden="true">
                                            <polygon points="6 4 20 12 6 20 6 4"/>
                                        </svg>
                                        Resume
                                    </ManageActionButton>
                                }
                                else
                                {
                                    <ManageActionButton Variant="Default"
                                                        Size="Compact"
                                                        OnClick="() => PauseListingAsync(listing.Id)"
                                                        Disabled="@_busyIds.Contains(listing.Id)"
                                                        aria-label="Pause this listing / Pausar este anuncio">
                                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>
                                        </svg>
                                        Pause
                                    </ManageActionButton>
                                }

                                @if (listing.Status == "Approved" && !string.IsNullOrEmpty(listing.Slug))
                                {
                                    <ManageLinkButton Href="@($"/listing/{listing.Slug}")"
                                                      Variant="Default"
                                                      Size="Compact"
                                                      target="_blank"
                                                      rel="noopener"
                                                      aria-label="View public listing / Ver anuncio público">
                                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                                            <polyline points="15 3 21 3 21 9"/>
                                            <line x1="10" y1="14" x2="21" y2="3"/>
                                        </svg>
                                        Public view
                                    </ManageLinkButton>
                                }

                                <ManageActionButton Variant="Danger"
                                                    Size="Compact"
                                                    OnClick="() => DeleteListingAsync(listing.Id)"
                                                    Disabled="@_busyIds.Contains(listing.Id)"
                                                    aria-label="Delete this listing / Eliminar este anuncio"
                                                    class="ml-auto">
                                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <polyline points="3 6 5 6 21 6"/>
                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                        <path d="M10 11v6"/><path d="M14 11v6"/>
                                        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                                    </svg>
                                    @(_busyIds.Contains(listing.Id) ? "Deleting…" : "Delete")
                                </ManageActionButton>
                            </div>
                        </div>
                    </div>
                </article>
                </li>
            }
        </ul>

        @* Skeletons al cargar siguiente página *@
        @if (_loadingMore)
        {
            <ul class="space-y-4 mt-4" aria-busy="true" aria-label="@_localizer["Manage_Index_LoadingMore"]">
                @for (int i = 0; i < 4; i++)
                {
                    <SkeletonListingCard />
                }
            </ul>
        }

        @* Sentinel para IntersectionObserver + fallback botón Load more *@
        @if (_hasMore)
        {
            <div @ref="_sentinel" class="h-4" aria-hidden="true"></div>
            <div class="mt-6 text-center">
                <button type="button"
                        class="px-6 py-2.5 rounded-xl border border-slate-200 hover:border-slate-300 text-ink text-sm font-medium cursor-pointer transition-colors disabled:opacity-50"
                        @onclick="LoadMoreAsync"
                        disabled="@_loadingMore">
                    @if (_loadingMore)
                    {
                        @_localizer["Manage_Index_Loading"]
                    }
                    else
                    {
                        @_localizer["Manage_Index_LoadMore"]
                    }
                </button>
            </div>
        }
        else if (_total.HasValue && _total.Value > 0)
        {
            <div class="mt-10 text-center" role="status" aria-live="polite">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-100 text-muted text-xs">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    @string.Format(_localizer["Manage_Index_EndOfList"], _total.Value)
                </div>
            </div>
        }
    }

</main>

@* Pending review warning dialog *@
<PendingReviewWarningDialog @ref="_pendingDialog" />

@code {
    private enum LoadState { InitialLoading, Ready, Error }

    private LoadState                _state     = LoadState.InitialLoading;
    private readonly List<MyListingDto> _items   = new();
    private int?                     _total;
    private bool                     _hasMore;
    private bool                     _loadingMore;
    private string?                  _errorKey;
    private string?                  _errorDetail;
    private int                      _page      = 0;
    private const int                PageSize   = 20;

    private string _filterStatus   = "";
    private string _filterCategory = "";
    private string _searchQuery    = "";

    private readonly HashSet<Guid> _busyIds = new();

    private PendingReviewWarningDialog? _pendingDialog;

    // Infinity scroll
    private ElementReference         _sentinel;
    private IJSObjectReference?      _jsModule;
    private IJSObjectReference?      _jsHandle;
    private DotNetObjectReference<Manage>? _selfRef;
    private bool                     _ioBound;

    protected override void OnInitialized()
    {
        NavBarState.IsDark    = false;
        FooterState.IsDark    = false;
        FooterState.IsCompact = true;
    }

    protected override async Task OnInitializedAsync()
    {
        await ResetAndLoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Atamos el observer una sola vez, cuando hay sentinel renderizado.
        if (!_ioBound && _hasMore && _state == LoadState.Ready)
        {
            await BindObserverAsync();
        }
    }

    private async Task BindObserverAsync()
    {
        try
        {
            _jsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/manage-infinity-scroll.js");
            _selfRef  ??= DotNetObjectReference.Create(this);
            _jsHandle  = await _jsModule.InvokeAsync<IJSObjectReference>("init", _sentinel, _selfRef);
            _ioBound = true;
        }
        catch
        {
            // Sin JS o módulo no disponible — el botón "Load more" actúa como fallback.
            _ioBound = false;
        }
    }

    private async Task DisposeObserverAsync()
    {
        if (_jsHandle is not null)
        {
            try { await _jsHandle.InvokeVoidAsync("dispose"); } catch { }
            try { await _jsHandle.DisposeAsync(); } catch { }
            _jsHandle = null;
        }
        _ioBound = false;
    }

    private async Task ApplyFilters()
    {
        await ResetAndLoadAsync();
    }

    private async Task ResetAndLoadAsync()
    {
        await DisposeObserverAsync();
        _items.Clear();
        _total = null;
        _hasMore = false;
        _page = 0;
        _errorKey = null;
        _errorDetail = null;
        _state = LoadState.InitialLoading;
        StateHasChanged();
        await FetchPageAsync(1);
    }

    /// <summary>Invocado por el módulo JS al disparar el IntersectionObserver.</summary>
    [JSInvokable]
    public async Task LoadMoreAsync()
    {
        if (_loadingMore || !_hasMore) return;
        await FetchPageAsync(_page + 1);
    }

    private async Task FetchPageAsync(int page)
    {
        if (page == 1) { /* initial load handled by caller */ }
        else { _loadingMore = true; StateHasChanged(); }

        var result = await ListingService.GetMyListingsAsync(
            page:     page,
            pageSize: PageSize,
            status:   string.IsNullOrEmpty(_filterStatus)   ? null : _filterStatus,
            category: string.IsNullOrEmpty(_filterCategory) ? null : _filterCategory,
            search:   string.IsNullOrEmpty(_searchQuery)    ? null : _searchQuery);

        switch (result)
        {
            case ApiResult<PagedResultDto<MyListingDto>>.Success s:
                _items.AddRange(s.Data.Items);
                _total   = s.Data.TotalItems;
                _hasMore = s.Data.HasNext;
                _page    = page;
                _state   = LoadState.Ready;
                _errorKey = null;
                _errorDetail = null;
                break;
            case ApiResult<PagedResultDto<MyListingDto>>.Error e:
                _errorKey    = e.MessageKey;
                _errorDetail = e.RawDetail;
                _state       = LoadState.Error;
                _hasMore     = false;
                break;
        }

        _loadingMore = false;
        StateHasChanged();

        // Si ya no hay más, desbindea el observer para liberar recursos.
        if (!_hasMore && _ioBound)
            await DisposeObserverAsync();
    }

    private async Task PauseListingAsync(Guid id)    => await ToggleActiveAsync(id, active: false);
    private async Task ResumeListingAsync(Guid id)   => await ToggleActiveAsync(id, active: true);

    private async Task ToggleActiveAsync(Guid id, bool active)
    {
        _busyIds.Add(id);
        StateHasChanged();

        var result = await ListingService.SetActiveAsync(id, active);

        _busyIds.Remove(id);

        if (result.IsSuccess)
        {
            // Update local state in-place; no flicker.
            for (int i = 0; i < _items.Count; i++)
            {
                if (_items[i].Id == id)
                {
                    _items[i] = _items[i] with { IsPausedByOwner = !active };
                    break;
                }
            }
        }
        else if (result is ApiResult<bool>.Error e)
        {
            _errorKey    = e.MessageKey;
            _errorDetail = e.RawDetail;
            _state       = LoadState.Error;
        }
        StateHasChanged();
    }

    private async Task DeleteListingAsync(Guid id)
    {
        if (_pendingDialog is null) return;
        var confirmed = await _pendingDialog.ShowAsync();
        if (!confirmed) return;

        _busyIds.Add(id);
        StateHasChanged();

        var result = await ListingService.DeleteAsync(id);

        _busyIds.Remove(id);

        if (result.IsSuccess)
        {
            _items.RemoveAll(l => l.Id == id);
            if (_total.HasValue) _total = Math.Max(0, _total.Value - 1);
        }
        else if (result is ApiResult<bool>.Error e)
        {
            _errorKey    = e.MessageKey;
            _errorDetail = e.RawDetail;
            _state       = LoadState.Error;
        }
        StateHasChanged();
    }

    // ── CSS helpers ────────────────────────────────────────────────────────────

    private static string BorderClass(MyListingDto l)
    {
        // Estado tiene prioridad cuando hay alerta (Rejected/Pending/NeedsChanges).
        // VIP aprobado usa el mismo borde naranja que la card VIP del home.
        var byStatus = l.Status switch
        {
            "Rejected"     => "border-red-200",
            "Pending"      => "border-amber-200",
            "NeedsChanges" => "border-orange-200",
            _              => null,
        };
        if (byStatus is not null) return byStatus;
        return l.Tier == "VIP" ? "border-orange-200" : "border-slate-300";
    }

    private static string CardExtraClass(MyListingDto l)
    {
        var cls = "";
        if (l.Tier == "VIP")        cls += " manage-card-vip";
        if (l.IsPausedByOwner)      cls += " manage-card-paused";
        return cls.Trim();
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeObserverAsync();
        if (_jsModule is not null)
        {
            try { await _jsModule.DisposeAsync(); } catch { }
            _jsModule = null;
        }
        _selfRef?.Dispose();
        _selfRef = null;
    }
}
