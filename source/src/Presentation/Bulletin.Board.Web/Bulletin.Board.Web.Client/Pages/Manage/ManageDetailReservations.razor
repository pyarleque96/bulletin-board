@page "/manage/{ListingId}/reservations"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Bulletin.Board.Web.Client.States
@using Bulletin.Board.Web.Client.Components.Shared
@using Bulletin.Board.Web.Client.Components.Buttons
@using Bulletin.Board.Web.Client.Services.Http
@using Bulletin.Board.Web.Client.Services.State
@using Bulletin.Board.Web.Client.Services.Common
@using Bulletin.Board.Web.Client.Components.Manage
@using Bulletin.Board.Web.Client.Models

@inject NavBarState NavBarState
@inject FooterState FooterState
@inject IReservationService ReservationService
@inject IContactLogService ContactLog
@inject ManageStateService StateService
@inject IManageLayoutResolver _manageResolver
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Reservations — @ListingId | Bulletin Dells</PageTitle>

<style>
    .res-pending   { background:#fef9c3; color:#854d0e; }
    .res-confirmed { background:#dcfce7; color:#15803d; }
    .res-completed { background:#f1f5f9; color:#475569; }
    .res-cancelled { background:#fee2e2; color:#b91c1c; }

    .res-card {
        transition: transform 0.3s cubic-bezier(0.32,0.72,0,1),
                    box-shadow 0.3s cubic-bezier(0.32,0.72,0,1);
    }
    .res-card:hover { transform:translateY(-2px); box-shadow:0 12px 40px -8px rgba(30,41,59,0.12); }
    .res-card.is-pending { border-color:#fbbf24; }

    @@keyframes pulse-dot { 0%,100%{opacity:1} 50%{opacity:.4} }
    .pulse-dot { animation:pulse-dot 2s ease-in-out infinite; }

    .fade-up { opacity:0; transform:translateY(12px);
               transition:opacity 0.45s ease, transform 0.45s cubic-bezier(0.32,0.72,0,1); }
    .fade-up.visible { opacity:1; transform:translateY(0); }

    @@media (prefers-reduced-motion:reduce) {
        *, *::before, *::after { animation-duration:0.01ms!important; transition-duration:0.01ms!important; }
        .fade-up { opacity:1; transform:none; }
    }
</style>

@* Non-car-rental categories defer to the category-specific manage layout
   (the reservations tab content is rendered inside that container). *@
@if (StateService.CurrentListing is { } _disp && !IsCarRental(_disp))
{
    var _layoutType = _manageResolver.Resolve(_disp.CategorySlug, _disp.Tier);
    <DynamicComponent Type="_layoutType"
                      Parameters="@(new Dictionary<string, object> { ["Listing"] = _disp, ["ActiveTab"] = "reservations" })" />
}
else
{

@* ── Sticky header + tabs ── *@
<ManageDetailHeader ListingId="@ListingId"
                    ListingTitle="@(_listingTitle)"
                    CategorySlug="@(_categorySlug)"
                    ActiveTab="reservations"
                    Status="@(_listingStatus)"
                    TierBadge="@(_listingTier)"
                    CategoryLabel="@(_categorySlug)"
                    Since=""
                    PublicUrl="@($"/listing/{ListingId}")"
                    VehicleCount="0"
                    PendingReservations="@((int?)_pendingCount)"
                    PhotoCount="0" />

@* ── PANEL: RESERVATIONS ── *@
<main class="max-w-6xl mx-auto px-4 py-8 w-full"
      id="panel-reservations" role="tabpanel" aria-labelledby="tab-reservations" tabindex="0">

    @* Error banner *@
    @if (_errorKey is not null)
    {
        <ApiErrorBanner MessageKey="@_errorKey" RawDetail="@_errorDetail" />
    }

    @* Sub-header + filters *@
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6 fade-up">
        <div>
            <h2 class="text-base font-semibold text-ink">Reservations</h2>
            <p class="text-sm text-muted mt-0.5" aria-live="polite">
                @if (_paged is not null)
                {
                    <span class="font-medium text-ink">@_paged.TotalItems</span>
                }
                else
                {
                    <span class="inline-block align-[-2px] h-3.5 w-8 bg-slate-100 rounded animate-pulse"></span>
                }
                <span>&nbsp;total</span>
                @if (_paged is not null && _pendingCount > 0)
                {
                    <span>&nbsp;·&nbsp;</span>
                    <span class="font-medium text-amber-700">@_pendingCount pending response</span>
                }
            </p>
        </div>

        @* Status filter pills — dimensiones del mockup detail-reservations.html v1:
           padding:5px 12px; font-size:11px; font-weight:600.
           Visibilidad gobernada por HasAnyUnfiltered (viene en el response del endpoint):
           - false → no hay NINGUNA reserva en el listing → ocultos
           - true  → hay al menos una (aunque el filtro vigente devuelva 0) → visibles *@
        @if (_paged?.HasAnyUnfiltered == true)
        {
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter reservations by status">
            <FilterPillButton Text="All"
                              IsActive="@(_filterStatus == "")"
                              OnClick='() => SetFilter("")'
                              CssClass="filter-pill filter-pill--compact"
                              aria-pressed="@(_filterStatus == "")" />
            <FilterPillButton IsActive="@(_filterStatus == "Pending")"
                              OnClick='() => SetFilter("Pending")'
                              CssClass="filter-pill filter-pill--compact"
                              aria-pressed="@(_filterStatus == "Pending")">
                Pending
                @if (_pendingCount > 0)
                {
                    <span class="ml-1 bg-amber-100 text-amber-800 text-[10px] font-bold px-1.5 py-0.5 rounded-full">@_pendingCount</span>
                }
            </FilterPillButton>
            <FilterPillButton Text="Confirmed"
                              IsActive="@(_filterStatus == "Confirmed")"
                              OnClick='() => SetFilter("Confirmed")'
                              CssClass="filter-pill filter-pill--compact"
                              aria-pressed="@(_filterStatus == "Confirmed")" />
            <FilterPillButton Text="Completed"
                              IsActive="@(_filterStatus == "Completed")"
                              OnClick='() => SetFilter("Completed")'
                              CssClass="filter-pill filter-pill--compact"
                              aria-pressed="@(_filterStatus == "Completed")" />
            <FilterPillButton Text="Cancelled"
                              IsActive="@(_filterStatus == "Cancelled")"
                              OnClick='() => SetFilter("Cancelled")'
                              CssClass="filter-pill filter-pill--compact"
                              aria-pressed="@(_filterStatus == "Cancelled")" />
        </div>
        }
    </div>

    @* Loading skeletons *@
    @if (_loading)
    {
        <div class="space-y-4">
            @for (int i = 0; i < 3; i++)
            {
                <div class="bg-white rounded-2xl border border-slate-200 shadow-soft p-5 animate-pulse">
                    <div class="flex gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-slate-100 flex-shrink-0"></div>
                        <div class="flex-1 space-y-2">
                            <div class="h-3 bg-slate-100 rounded w-1/3"></div>
                            <div class="h-3 bg-slate-100 rounded w-1/4"></div>
                            <div class="flex gap-2 mt-3">
                                <div class="h-8 w-28 bg-slate-100 rounded-2xl"></div>
                                <div class="h-8 w-20 bg-slate-100 rounded-2xl"></div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* Success state *@
    @if (!_loading && _paged is not null)
    {
        @if (_paged.Items.Count == 0)
        {
            <div class="text-center py-16 bg-white rounded-2xl border border-dashed border-slate-200">
                <svg class="w-10 h-10 text-slate-200 mx-auto mb-3" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                <h3 class="text-sm font-semibold text-ink mb-1">No reservations found</h3>
                <p class="text-xs text-muted">Reservations will appear here once customers request them.</p>
            </div>
        }
        else
        {
            <ul class="space-y-4" role="list" aria-label="Reservations list / Lista de reservas">
                @foreach (var r in _paged.Items)
                {
                    <li class="res-card @(r.Status == "Pending" ? "is-pending" : "") bg-white rounded-2xl border shadow-soft overflow-hidden fade-up"
                        aria-label="Reservation from @r.RequesterName">

                        @* Pending alert banner *@
                        @if (r.Status == "Pending")
                        {
                            <div class="flex items-center gap-2 px-4 py-2 bg-amber-50 border-b border-amber-100">
                                <span class="pulse-dot w-1.5 h-1.5 rounded-full bg-amber-500 inline-block" aria-hidden="true"></span>
                                <span class="text-[11px] font-semibold text-amber-800 uppercase tracking-wide">
                                    Response required — client is waiting
                                </span>
                                <span class="ml-auto text-[10px] text-amber-600 font-medium">
                                    @TimeAgo(r.CreatedAt)
                                </span>
                            </div>
                        }

                        <div class="p-5">
                            <div class="flex flex-col sm:flex-row sm:items-start gap-4">

                                @* Avatar initials *@
                                <div class="w-12 h-12 rounded-2xl @AvatarBg(r.Status) flex items-center justify-center flex-shrink-0 text-base font-bold text-slate-600"
                                     aria-hidden="true">
                                    @Initials(r.RequesterName)
                                </div>

                                <div class="flex-1 min-w-0">
                                    <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
                                        <div>
                                            <h3 class="text-sm font-semibold text-ink">@r.RequesterName</h3>
                                            <p class="text-xs text-muted mt-0.5 flex items-center gap-1">
                                                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v9a2 2 0 0 1-2 2h-3"/>
                                                    <circle cx="7.5" cy="17.5" r="2.5"/>
                                                    <circle cx="17.5" cy="17.5" r="2.5"/>
                                                </svg>
                                                @r.VehicleName
                                            </p>
                                        </div>
                                        <span class="@StatusBadge(r.Status) text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full flex-shrink-0">
                                            @r.Status
                                        </span>
                                    </div>

                                    @* Dates *@
                                    <div class="flex flex-wrap items-center gap-3 mb-3">
                                        <div class="flex items-center gap-1.5 text-xs text-ink font-medium">
                                            <svg class="w-3.5 h-3.5 text-muted" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="1.75" stroke-linecap="round"
                                                 stroke-linejoin="round" aria-hidden="true">
                                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                                <line x1="16" y1="2" x2="16" y2="6"/>
                                                <line x1="8" y1="2" x2="8" y2="6"/>
                                                <line x1="3" y1="10" x2="21" y2="10"/>
                                            </svg>
                                            @r.StartDate.ToString("MMM d") — @r.EndDate.ToString("MMM d, yyyy")
                                        </div>
                                        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-muted">
                                            @DayCount(r.StartDate, r.EndDate) days
                                        </span>
                                    </div>

                                    @* Client comment *@
                                    @if (!string.IsNullOrEmpty(r.Comment))
                                    {
                                        <div class="flex items-start gap-2 mb-4 px-3 py-2.5 rounded-xl bg-slate-50 border border-slate-100">
                                            <svg class="w-3.5 h-3.5 text-muted flex-shrink-0 mt-0.5" viewBox="0 0 24 24"
                                                 fill="none" stroke="currentColor" stroke-width="1.75"
                                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                                            </svg>
                                            <p class="text-xs text-slate-600 italic">"@r.Comment"</p>
                                        </div>
                                    }

                                    @* Action CTAs depending on status *@
                                    <div class="flex flex-wrap items-center gap-2">

                                        @* WhatsApp — siempre mostrar cuando hay teléfono disponible *@
                                        @if (!string.IsNullOrEmpty(r.RequesterPhone))
                                        {
                                            var waLink = $"https://wa.me/{r.RequesterPhone.Replace("+", "").Replace(" ", "").Replace("-", "")}";
                                            <WhatsAppButton Size="compact"
                                                            Text="WhatsApp"
                                                            AriaLabel="Contact via WhatsApp / Contactar por WhatsApp"
                                                            OnClick="@(async () => { ContactLog.LogContact(r.Id); await Js.InvokeVoidAsync("open", waLink, "_blank"); })" />
                                        }

                                        @* Pending → Confirm / Reject *@
                                        @* Nota paleta: "Confirm" en verde no tiene token en la paleta — se usa Default con hover-green
                                           como la opción más cercana a btn-secondary pero con semántica positiva. *@
                                        @if (r.Status == "Pending")
                                        {
                                            <ManageActionButton Variant="Default"
                                                                Size="Small"
                                                                OnClick="() => AcceptReservationAsync(r.Id)"
                                                                Disabled="@_busyIds.Contains(r.Id)"
                                                                aria-label="Confirm reservation / Confirmar reserva"
                                                                class="hover:bg-green-50 hover:border-green-200 hover:text-green-700">
                                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <polyline points="20 6 9 17 4 12"/>
                                                </svg>
                                                @(_busyIds.Contains(r.Id) ? "…" : "Confirm")
                                            </ManageActionButton>
                                            <ManageActionButton Variant="Danger"
                                                                Size="Small"
                                                                OnClick="() => RejectReservationAsync(r.Id)"
                                                                Disabled="@_busyIds.Contains(r.Id)"
                                                                aria-label="Reject reservation / Rechazar reserva">
                                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <line x1="18" y1="6" x2="6" y2="18"/>
                                                    <line x1="6" y1="6" x2="18" y2="18"/>
                                                </svg>
                                                @(_busyIds.Contains(r.Id) ? "…" : "Reject")
                                            </ManageActionButton>
                                        }

                                        @* Confirmed → Mark returned / Cancel *@
                                        @if (r.Status == "Confirmed")
                                        {
                                            <ManageActionButton Variant="Default"
                                                                Size="Small"
                                                                OnClick="() => CompleteReservationAsync(r.Id)"
                                                                Disabled="@_busyIds.Contains(r.Id)"
                                                                aria-label="Mark as returned / completed">
                                                @(_busyIds.Contains(r.Id) ? "…" : "Mark as returned")
                                            </ManageActionButton>
                                            <ManageActionButton Variant="Danger"
                                                                Size="Small"
                                                                OnClick="() => CancelReservationAsync(r.Id)"
                                                                Disabled="@_busyIds.Contains(r.Id)"
                                                                aria-label="Cancel reservation">
                                                @(_busyIds.Contains(r.Id) ? "…" : "Cancel")
                                            </ManageActionButton>
                                        }
                                    </div>

                                    @* GM notification note *@
                                    @if (r.Status == "Pending")
                                    {
                                        <p class="text-[10px] text-muted mt-2 flex items-center gap-1">
                                            <svg class="w-3 h-3 flex-shrink-0" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="1.75" stroke-linecap="round"
                                                 stroke-linejoin="round" aria-hidden="true">
                                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                                <polyline points="22,6 12,13 2,6"/>
                                            </svg>
                                            The GM is notified by email of all client interactions.
                                        </p>
                                    }
                                </div>
                            </div>
                        </div>
                    </li>
                }
            </ul>

            @* Pager *@
            <Pager Page="@_page"
                   TotalPages="@(_paged?.TotalPages ?? 1)"
                   HasNext="@(_paged?.HasNext ?? false)"
                   HasPrevious="@(_paged?.HasPrevious ?? false)"
                   OnPageChanged="LoadPageAsync" />
        }
    }

</main>

} @* end else (car-rental branch) *@

<script>
    (function () {
        const obs = new IntersectionObserver((entries) => {
            entries.forEach((entry, i) => {
                if (entry.isIntersecting) {
                    setTimeout(() => entry.target.classList.add('visible'), i * 80);
                    obs.unobserve(entry.target);
                }
            });
        }, { threshold: 0.04 });
        document.querySelectorAll('.fade-up').forEach(el => obs.observe(el));
    })();
</script>

@code {
    [Parameter] public string ListingId { get; set; } = "";

    // ── Listing meta ────────────────────────────────────────────────────────────
    private string _listingTitle  = "…";
    private string _categorySlug  = "";
    private string _listingStatus = "";
    private string _listingTier   = "";

    // ── Reservations state ─────────────────────────────────────────────────────
    private PagedResultDto<ReservationDto>? _paged;
    private bool    _loading       = true;
    private int     _page          = 1;
    private const int PageSize     = 20;
    private string  _filterStatus  = "";
    private int     _pendingCount  = 0;
    private string? _errorKey;
    private string? _errorDetail;

    private readonly HashSet<Guid> _busyIds = new();

    private static bool IsCarRental(ListingDetailDto l) =>
        string.Equals(l.CategorySlug, "car-rental", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        NavBarState.IsDark    = false;
        FooterState.IsDark    = false;
        FooterState.IsCompact = true;
        StateService.OnStateChanged += OnStateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Guid.TryParse(ListingId, out var id)) return;

        // Load listing meta
        await StateService.LoadListingAsync(id);
        if (StateService.CurrentListing is { } l)
        {
            _listingTitle  = l.TitleEn;
            _categorySlug  = l.CategorySlug;
            _listingStatus = l.Status;
            _listingTier   = l.Tier;
        }

        // Load pending count (unfiltered probe for pending badge only)
        await LoadPendingCountAsync(id);
        await LoadPageAsync(1);
    }

    private async Task LoadPendingCountAsync(Guid id)
    {
        var result = await ReservationService.GetByListingAsync(id, status: "Pending", page: 1, pageSize: 1);
        if (result is ApiResult<PagedResultDto<ReservationDto>>.Success s)
            _pendingCount = s.Data.TotalItems;
        StateHasChanged();
    }

    private async Task LoadPageAsync(int page)
    {
        if (!Guid.TryParse(ListingId, out var id)) return;

        _page     = page;
        _loading  = true;
        _errorKey = null;
        StateHasChanged();

        var result = await ReservationService.GetByListingAsync(
            id,
            status:   string.IsNullOrEmpty(_filterStatus) ? null : _filterStatus,
            page:     _page,
            pageSize: PageSize);

        switch (result)
        {
            case ApiResult<PagedResultDto<ReservationDto>>.Success s:
                _paged = s.Data;
                break;
            case ApiResult<PagedResultDto<ReservationDto>>.Error e:
                _errorKey    = e.MessageKey;
                _errorDetail = e.RawDetail;
                break;
        }
        _loading = false;
        StateHasChanged();
    }

    private async Task SetFilter(string status)
    {
        _filterStatus = status;
        _page = 1;
        await LoadPageAsync(1);
    }

    // ── Reservation mutations ──────────────────────────────────────────────────

    private async Task AcceptReservationAsync(Guid id)
    {
        await MutateAsync(id, () => ReservationService.AcceptAsync(id));
    }

    private async Task RejectReservationAsync(Guid id)
    {
        await MutateAsync(id, () => ReservationService.RejectAsync(id));
    }

    private async Task CancelReservationAsync(Guid id)
    {
        await MutateAsync(id, () => ReservationService.CancelAsync(id));
    }

    private async Task CompleteReservationAsync(Guid id)
    {
        await MutateAsync(id, () => ReservationService.MarkCompletedAsync(id));
    }

    private async Task MutateAsync(Guid id, Func<Task<ApiResult<bool>>> action)
    {
        _busyIds.Add(id);
        StateHasChanged();

        var result = await action();
        _busyIds.Remove(id);

        if (result.IsSuccess)
        {
            if (Guid.TryParse(ListingId, out var listingId))
                await LoadPendingCountAsync(listingId);
            await LoadPageAsync(_page);
        }
        else if (result is ApiResult<bool>.Error e)
        {
            _errorKey    = e.MessageKey;
            _errorDetail = e.RawDetail;
        }
        StateHasChanged();
    }

    // ── Helpers ────────────────────────────────────────────────────────────────

    private static string Initials(string name)
    {
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : (parts.Length == 1 ? parts[0][..Math.Min(2, parts[0].Length)].ToUpper() : "?");
    }

    private static string AvatarBg(string status) => status switch
    {
        "Pending"   => "bg-amber-100",
        "Confirmed" => "bg-green-100",
        "Completed" => "bg-slate-100",
        "Cancelled" => "bg-red-100",
        _           => "bg-slate-100",
    };

    private static string StatusBadge(string status) => status switch
    {
        "Pending"   => "res-pending",
        "Confirmed" => "res-confirmed",
        "Completed" => "res-completed",
        "Cancelled" => "res-cancelled",
        _           => "res-completed",
    };

    private static int DayCount(DateOnly start, DateOnly end)
        => (end.ToDateTime(TimeOnly.MinValue) - start.ToDateTime(TimeOnly.MinValue)).Days;

    private static string TimeAgo(DateTimeOffset dt)
    {
        var diff = DateTimeOffset.UtcNow - dt;
        if (diff.TotalMinutes < 60)  return $"Received {(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours   < 24)  return $"Received {(int)diff.TotalHours}h ago";
        return $"Received {(int)diff.TotalDays}d ago";
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        StateService.OnStateChanged -= OnStateChanged;
    }
}
