@page "/admin"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using Bulletin.Board.Web.Client.States

@inject IAdminService AdminService
@inject AdminNavigationState AdminNav

<PageTitle>Dashboard — Bulletin Dells Admin</PageTitle>

@if (!_isLoading || !AdminNav.IsNavigating)
{
<div class="flex-1 p-5 space-y-6">

    @* Good Morning Banner *@
    @if (_showBanner)
    {
        <div class="rounded-2xl overflow-hidden relative"
             style="background: linear-gradient(135deg, #395c89 0%, #0d274ff7 60%, #15315c 100%); border:1px solid rgba(37,99,235,0.14); box-shadow:0 2px 12px rgba(37,99,235,0.07); transition:opacity 300ms ease, transform 300ms ease;">
            <div style="position:absolute;top:0;right:0;bottom:0;width:180px;background:radial-gradient(ellipse at 110% 50%, rgba(249,115,22,0.08) 0%, transparent 70%);pointer-events:none;"></div>

            <button @onclick="DismissBanner"
                    aria-label="Dismiss welcome banner"
                    class="rounded-lg p-1.5 transition-colors cursor-pointer"
                    style="position:absolute; top:10px; right:12px; z-index:10; color:#94a3b8; background:transparent;">
                <svg width="10" height="10" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
                </svg>
            </button>

            <div class="flex items-center w-full px-5 py-4">
                <div class="min-w-0">
                    <p class="text-xs font-medium tracking-wide uppercase mb-0.5 text-white" style="letter-spacing:0.06em;">Good morning, GM</p>
                    <h2 class="text-lg font-bold leading-tight text-white">Bulletin Dells Admin</h2>
                    <p class="text-xs mt-0.5" style="color:#93c5fd;">@DateTime.Now.ToString("dddd, MMMM d, yyyy") &middot; Wisconsin Dells, WI</p>
                </div>

                <div class="hidden md:flex items-center gap-2 ml-auto mr-8">
                    @if (_isLoading)
                    {
                        <div class="rounded-lg px-3 py-2 text-center animate-pulse" style="background:rgb(255 255 255 / 92%); border:1px solid rgba(37,99,235,0.12);">
                            <div class="w-6 h-5 bg-blue-200 rounded mx-auto"></div>
                            <p class="text-[10px] font-medium mt-0.5" style="color:#3b82f6;">Pending</p>
                        </div>
                        <div class="rounded-lg px-3 py-2 text-center animate-pulse" style="background:rgb(255 255 255 / 92%); border:1px solid rgba(37,99,235,0.12);">
                            <div class="w-6 h-5 bg-blue-200 rounded mx-auto"></div>
                            <p class="text-[10px] font-medium mt-0.5" style="color:#3b82f6;">Contacts</p>
                        </div>
                        <div class="rounded-lg px-3 py-2 text-center animate-pulse" style="background:rgb(255 255 255 / 92%); border:1px solid rgba(249,115,22,0.20);">
                            <div class="w-6 h-5 bg-orange-200 rounded mx-auto"></div>
                            <p class="text-[10px] font-medium mt-0.5" style="color:#ea580c;">Reviews</p>
                        </div>
                    }
                    else
                    {
                        <div class="rounded-lg px-3 py-2 text-center" style="background:rgb(255 255 255 / 92%); border:1px solid rgba(37,99,235,0.12);">
                            <p class="text-xl font-bold leading-none" style="color:#1d4ed8;">@(_stats?.PendingListings ?? 0)</p>
                            <p class="text-[10px] font-medium mt-0.5" style="color:#3b82f6;">Pending</p>
                        </div>
                        <div class="rounded-lg px-3 py-2 text-center" style="background:rgb(255 255 255 / 92%); border:1px solid rgba(37,99,235,0.12);">
                            <p class="text-xl font-bold leading-none" style="color:#1d4ed8;">@(_stats?.ContactsToday ?? 0)</p>
                            <p class="text-[10px] font-medium mt-0.5" style="color:#3b82f6;">Contacts</p>
                        </div>
                        <div class="rounded-lg px-3 py-2 text-center" style="background:rgb(255 255 255 / 92%); border:1px solid rgba(249,115,22,0.20);">
                            <p class="text-xl font-bold leading-none" style="color:#c2410c;">@(_stats?.PendingReviews ?? 0)</p>
                            <p class="text-[10px] font-medium mt-0.5" style="color:#ea580c;">Reviews</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @* KPI Cards *@
    <section>
        <h2 class="text-xs font-semibold text-muted uppercase tracking-widest mb-3">Today at a Glance</h2>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">

            <a href="/admin/listings-queue"
               class="kpi-card bg-white rounded-xl border border-slate-200 p-5 block cursor-pointer transition-all hover:shadow-lg hover:border-yellow-300"
               style="box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                <div class="flex items-start justify-between mb-4">
                    <div class="w-9 h-9 bg-yellow-50 rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4 text-yellow-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <span class="text-[10px] font-semibold text-yellow-600 bg-yellow-50 px-2 py-0.5 rounded-full">Urgent</span>
                </div>
                @if (_isLoading)
                {
                    <div class="h-8 w-12 bg-slate-200 rounded animate-pulse mb-1"></div>
                }
                else
                {
                    <p class="text-3xl font-bold text-ink">@(_stats?.PendingListings ?? 0)</p>
                }
                <p class="text-xs text-muted mt-1">Pending Listings</p>
                <p class="text-xs text-yellow-600 mt-2 font-medium">@(_stats?.UrgentListings ?? 0) waiting 48+ hrs</p>
            </a>

            <a href="/admin/providers"
               class="kpi-card bg-white rounded-xl border border-slate-200 p-5 block cursor-pointer transition-all hover:shadow-lg hover:border-blue-300"
               style="box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                <div class="flex items-start justify-between mb-4">
                    <div class="w-9 h-9 bg-blue-50 rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                        </svg>
                    </div>
                    <span class="text-[10px] font-semibold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full">+3 today</span>
                </div>
                @if (_isLoading)
                {
                    <div class="h-8 w-12 bg-slate-200 rounded animate-pulse mb-1"></div>
                }
                else
                {
                    <p class="text-3xl font-bold text-ink">@(_stats?.TotalProviders ?? 0)</p>
                }
                <p class="text-xs text-muted mt-1">Total Providers</p>
                <p class="text-xs text-blue-600 mt-2 font-medium">@(_stats?.VipProviders ?? 0) VIP &middot; @(_stats?.VerifiedProviders ?? 0) Verified</p>
            </a>

            <div class="kpi-card bg-white rounded-xl border border-slate-200 p-5 cursor-default transition-all hover:shadow-lg hover:border-green-300"
                 style="box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                <div class="flex items-start justify-between mb-4">
                    <div class="w-9 h-9 bg-green-50 rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                        </svg>
                    </div>
                    <span class="text-[10px] font-semibold text-green-600 bg-green-50 px-2 py-0.5 rounded-full">Live</span>
                </div>
                @if (_isLoading)
                {
                    <div class="h-8 w-12 bg-slate-200 rounded animate-pulse mb-1"></div>
                }
                else
                {
                    <p class="text-3xl font-bold text-ink">@(_stats?.ContactsToday ?? 0)</p>
                }
                <p class="text-xs text-muted mt-1">Contacts Today</p>
                <p class="text-xs text-green-600 mt-2 font-medium">All via WhatsApp</p>
            </div>

            <a href="/admin/reviews-queue"
               class="kpi-card bg-white rounded-xl border border-slate-200 p-5 block cursor-pointer transition-all hover:shadow-lg hover:border-orange-300"
               style="box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                <div class="flex items-start justify-between mb-4">
                    <div class="w-9 h-9 bg-orange-50 rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                        </svg>
                    </div>
                    <span class="text-[10px] font-semibold text-orange-600 bg-orange-50 px-2 py-0.5 rounded-full">Review</span>
                </div>
                @if (_isLoading)
                {
                    <div class="h-8 w-12 bg-slate-200 rounded animate-pulse mb-1"></div>
                }
                else
                {
                    <p class="text-3xl font-bold text-ink">@(_stats?.PendingReviews ?? 0)</p>
                }
                <p class="text-xs text-muted mt-1">Pending Reviews</p>
                <p class="text-xs text-orange-600 mt-2 font-medium">Awaiting GM approval</p>
            </a>

        </div>
    </section>

    @* Activity Feed + Right Column *@
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch">

        @* Activity Feed — 2 cols *@
        <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 flex flex-col" style="box-shadow:0 4px 16px rgba(0,0,0,0.10);">
            <div class="flex items-center justify-between px-6 pt-5 pb-3">
                <h2 class="text-sm font-semibold text-ink">Activity Feed</h2>
                <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
                    <span class="text-xs text-green-600 font-medium">Live</span>
                </div>
            </div>

            <div class="flex-1 px-6 divide-y divide-slate-100">
                @foreach (var item in _activityFeed)
                {
                    <div class="flex items-center gap-3 py-2">
                        <div class="w-7 h-7 @item.IconBg rounded-lg flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 @item.IconColor" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                @((MarkupString)item.IconPath)
                            </svg>
                        </div>
                        <p class="text-sm text-ink flex-1 min-w-0 truncate">
                            <span class="font-medium">@item.Action</span> @item.Detail
                        </p>
                        <span class="text-xs text-muted flex-shrink-0">@item.Time</span>
                    </div>
                }
            </div>

            <div class="flex justify-end px-6 py-3 border-t border-slate-100">
                <a href="/admin/listings-queue"
                   class="flex items-center gap-1.5 text-xs text-blue-600 hover:text-blue-700 font-medium cursor-pointer transition-colors">
                    View more
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
            </div>
        </div>

        @* Right column *@
        <div class="flex flex-col gap-4">

            @* Provider Tiers *@
            <div class="bg-white rounded-2xl border border-slate-200 p-5" style="box-shadow:0 4px 16px rgba(0,0,0,0.10);">
                <h3 class="text-sm font-semibold text-ink mb-4">Provider Tiers</h3>
                @if (_isLoading)
                {
                    <div class="space-y-3">
                        @for (int i = 0; i < 3; i++)
                        {
                            <div class="animate-pulse">
                                <div class="flex justify-between mb-1">
                                    <div class="h-3 w-16 bg-slate-200 rounded"></div>
                                    <div class="h-3 w-6 bg-slate-200 rounded"></div>
                                </div>
                                <div class="h-1.5 bg-slate-100 rounded-full"></div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    var total = Math.Max(1, _stats?.TotalProviders ?? 1);
                    var vipPct = (int)((_stats?.VipProviders ?? 0) * 100.0 / total);
                    var verPct = (int)((_stats?.VerifiedProviders ?? 0) * 100.0 / total);
                    var regPct = (int)((_stats?.RegularProviders ?? 0) * 100.0 / total);

                    <div class="space-y-3">
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <div class="flex items-center gap-2">
                                    <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
                                    <span class="text-xs font-medium text-ink">VIP</span>
                                </div>
                                <span class="text-xs font-bold text-amber-600">@(_stats?.VipProviders ?? 0)</span>
                            </div>
                            <div class="h-1.5 bg-amber-100 rounded-full">
                                <div class="h-full bg-amber-400 rounded-full" style="width:@(vipPct)%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <div class="flex items-center gap-2">
                                    <span class="w-2.5 h-2.5 rounded-full bg-blue-400"></span>
                                    <span class="text-xs font-medium text-ink">Verified</span>
                                </div>
                                <span class="text-xs font-bold text-blue-600">@(_stats?.VerifiedProviders ?? 0)</span>
                            </div>
                            <div class="h-1.5 bg-blue-100 rounded-full">
                                <div class="h-full bg-blue-400 rounded-full" style="width:@(verPct)%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <div class="flex items-center gap-2">
                                    <span class="w-2.5 h-2.5 rounded-full bg-slate-300"></span>
                                    <span class="text-xs font-medium text-ink">Regular</span>
                                </div>
                                <span class="text-xs font-bold text-slate-500">@(_stats?.RegularProviders ?? 0)</span>
                            </div>
                            <div class="h-1.5 bg-slate-100 rounded-full">
                                <div class="h-full bg-slate-300 rounded-full" style="width:@(regPct)%"></div>
                            </div>
                        </div>
                    </div>
                    <p class="text-[11px] text-muted mt-3">@(_stats?.TotalProviders ?? 0) total providers</p>
                }
            </div>

            @* Quick Actions *@
            <div class="flex-1 bg-white rounded-2xl border border-slate-200 p-5 flex flex-col" style="box-shadow:0 4px 16px rgba(0,0,0,0.10);">
                <h3 class="text-sm font-semibold text-ink mb-3">Quick Actions</h3>
                <div class="flex flex-col gap-2 flex-1">
                    <a href="/admin/listings-queue"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-xl bg-slate-50 hover:bg-blue-50 cursor-pointer transition-colors group">
                        <div class="w-7 h-7 bg-yellow-100 rounded-lg flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                            </svg>
                        </div>
                        <span class="text-sm text-ink group-hover:text-blue-700 transition-colors font-medium flex-1">Review Listings</span>
                        <span class="text-xs text-yellow-600 font-bold bg-yellow-100 px-1.5 py-0.5 rounded-full">@(_stats?.PendingListings ?? 0)</span>
                    </a>
                    <a href="/admin/reviews-queue"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-xl bg-slate-50 hover:bg-orange-50 cursor-pointer transition-colors group">
                        <div class="w-7 h-7 bg-orange-100 rounded-lg flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                            </svg>
                        </div>
                        <span class="text-sm text-ink group-hover:text-orange-700 transition-colors font-medium flex-1">Approve Reviews</span>
                        <span class="text-xs text-orange-600 font-bold bg-orange-100 px-1.5 py-0.5 rounded-full">@(_stats?.PendingReviews ?? 0)</span>
                    </a>
                    <a href="/admin/providers"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-xl bg-slate-50 hover:bg-blue-50 cursor-pointer transition-colors group">
                        <div class="w-7 h-7 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </div>
                        <span class="text-sm text-ink group-hover:text-blue-700 transition-colors font-medium">Manage Providers</span>
                    </a>
                    <a href="/admin/categories"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-xl bg-slate-50 hover:bg-blue-50 cursor-pointer transition-colors group">
                        <div class="w-7 h-7 bg-slate-100 rounded-lg flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-5 5a2 2 0 01-2.828 0l-7-7A2 2 0 013 9V4a1 1 0 011-1z" />
                            </svg>
                        </div>
                        <span class="text-sm text-ink group-hover:text-blue-700 transition-colors font-medium">Edit Categories</span>
                    </a>
                </div>
            </div>

        </div>
    </div>

</div>
}

@code {
    private bool _showBanner = true;
    private bool _isLoading = true;
    private AdminStatsDto? _stats;

    // Auth comes from a same-origin HttpOnly cookie that the browser attaches to every
    // BFF call automatically. No JS interop, no localStorage — the data load runs
    // identically in SSR, Server-interactive, and WASM, so OnInitializedAsync is safe.
    protected override async Task OnInitializedAsync()
    {
        _stats = await AdminService.GetStatsAsync();
        _isLoading = false;
        AdminNav.MarkNavigationDone();
    }

    private void DismissBanner() => _showBanner = false;

    private record ActivityItem(string Action, string Detail, string Time, string IconBg, string IconColor, string IconPath);

    private readonly ActivityItem[] _activityFeed =
    [
        new("Approved", "\"Maria's Beauty Salon\" — Beauty · VIP", "2m ago", "bg-green-100", "text-green-600",
            "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 13l4 4L19 7\"/>"),
        new("Promoted", "\"Carlos Auto Repair\" to VIP · Hierarchy 850", "18m ago", "bg-amber-100", "text-amber-600",
            "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 7h8m0 0v8m0-8l-8 8-4-4-6 6\"/>"),
        new("Rejected", "\"Dells Taxi Co.\" — missing contact info", "34m ago", "bg-red-100", "text-red-500",
            "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\"/>"),
        new("New contact", "via WhatsApp — Alejandro Torres → Housing", "1h ago", "bg-blue-100", "text-blue-600",
            "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z\"/>"),
        new("Verified", "Luisa Rental Cars — Phone + ID confirmed", "2h ago", "bg-purple-100", "text-purple-600",
