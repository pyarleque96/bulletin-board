@page "/admin/reviews-queue"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using Bulletin.Board.Web.Client.States

@inject IAdminService AdminService
@inject AdminNavigationState AdminNav

<PageTitle>Reviews Queue — Bulletin Dells Admin</PageTitle>

@if (!_isLoading || !AdminNav.IsNavigating)
{
<div class="flex-1 p-5 space-y-6">

    @* Policy banner *@
    <div class="bg-orange-50 border border-orange-200 rounded-xl p-4 flex items-start gap-3">
        <svg class="w-5 h-5 text-orange-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <div>
            <p class="text-sm font-semibold text-orange-800">Anti-manipulation policy</p>
            <p class="text-xs text-orange-700 mt-0.5">Only users who contacted the provider via Bulletin Dells can submit reviews. Each review must be approved by the GM before appearing publicly.</p>
        </div>
    </div>

    @* Loading skeletons *@
    @if (_isLoading)
    {
        @for (int s = 0; s < 3; s++)
        {
            <div class="bg-white rounded-xl border border-slate-200 p-6 animate-pulse" style="box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                <div class="flex gap-4">
                    <div class="w-12 h-12 rounded-full bg-slate-200 flex-shrink-0"></div>
                    <div class="flex-1 space-y-3">
                        <div class="h-4 bg-slate-200 rounded w-1/4"></div>
                        <div class="h-4 bg-slate-200 rounded w-1/3"></div>
                        <div class="h-16 bg-slate-100 rounded-lg"></div>
                        <div class="h-8 bg-green-50 rounded-lg"></div>
                        <div class="flex gap-3">
                            <div class="h-8 w-32 bg-slate-200 rounded-lg"></div>
                            <div class="h-8 w-28 bg-slate-200 rounded-lg"></div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else if (_hasError)
    {
        <div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center">
            <p class="text-sm font-semibold text-red-700">Failed to load reviews</p>
            <button @onclick="LoadRatingsAsync" class="mt-3 text-xs text-red-700 border border-red-300 px-4 py-2 rounded-lg cursor-pointer hover:bg-red-100 transition-colors">Retry</button>
        </div>
    }
    else if (_ratings is not null && _ratings.Items.Length == 0)
    {
        <div class="bg-white rounded-xl border border-slate-200 p-10 text-center" style="box-shadow:0 2px 8px rgba(0,0,0,0.06);">
            <p class="text-sm font-semibold text-ink">No reviews found</p>
            <p class="text-xs text-muted mt-1">All reviews have been moderated.</p>
        </div>
    }
    else if (_ratings is not null)
    {
        <div class="space-y-4">
            @foreach (var rating in _ratings.Items)
            {
                var isSuspicious = rating.Stars <= 2 && string.IsNullOrWhiteSpace(rating.Comment);

                <div class="bg-white rounded-xl @(isSuspicious ? "border-2 border-red-200" : "border border-slate-200") p-6"
                     style="box-shadow:0 2px 8px rgba(0,0,0,0.06);">

                    @if (isSuspicious)
                    {
                        <div class="bg-red-50 rounded-lg px-4 py-2 mb-4 flex items-center gap-2">
                            <svg class="w-4 h-4 text-red-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            <span class="text-xs font-semibold text-red-700">Potential issue — Low rating without explanation. Review carefully.</span>
                        </div>
                    }

                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 rounded-full bg-slate-200 flex items-center justify-center flex-shrink-0 border-2 @(isSuspicious ? "border-red-200" : "border-slate-200") text-sm font-bold text-slate-500">
                            @(rating.ReviewerName.Length > 0 ? rating.ReviewerName[0].ToString().ToUpper() : "?")
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <div class="flex items-center gap-2 mb-1">
                                        <div class="flex items-center gap-0.5" aria-label="@rating.Stars out of 5 stars">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <svg class="w-4 h-4 @(i <= rating.Stars ? "text-amber-400" : "text-slate-200")" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                                                </svg>
                                            }
                                        </div>
                                        <span class="text-sm font-bold text-ink">@rating.Stars.ToString("F1")</span>
                                    </div>
                                    <p class="text-sm font-semibold text-ink">@rating.ReviewerName</p>
                                    <p class="text-xs text-muted mt-0.5">Reviewing: <span class="font-medium text-ink">@rating.ListingTitleEn</span></p>
                                </div>
                                <div class="text-right flex-shrink-0">
                                    <span class="inline-flex items-center gap-1 bg-orange-100 text-orange-700 text-xs font-semibold px-2.5 py-1 rounded-full">Pending Approval</span>
                                    <p class="text-xs text-muted mt-1.5">Submitted @rating.CreatedAt.ToString("MMM d, yyyy")</p>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(rating.Comment))
                            {
                                <p class="text-sm text-ink leading-relaxed mt-3 bg-slate-50 rounded-lg p-3 border border-slate-100">
                                    "@rating.Comment"
                                </p>
                            }
                            else
                            {
                                <p class="text-sm text-slate-400 italic mt-3 bg-slate-50 rounded-lg p-3 border border-slate-100">
                                    No comment provided.
                                </p>
                            }

                            <div class="mt-3 flex items-center gap-2 text-xs text-green-700 bg-green-50 border border-green-100 rounded-lg px-3 py-2">
                                <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                </svg>
                                @if (rating.ContactDate.HasValue)
                                {
                                    <span>Verified contact — contacted provider on @rating.ContactDate.Value.ToString("MMMM d, yyyy")</span>
                                }
                                else
                                {
                                    <span>Verified contact — contact date not recorded</span>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(_actionError) && _actionTarget?.Id == rating.Id)
                            {
                                <p class="text-xs text-red-600 mt-2">@_actionError</p>
                            }

                            <div class="mt-4 flex items-center gap-3">
                                <button @onclick="() => ApproveRating(rating)"
                                        disabled="@_isBusy"
                                        class="flex items-center gap-2 bg-green-600 text-white text-xs font-semibold px-4 py-2 rounded-lg cursor-pointer hover:bg-green-700 transition-colors active:scale-95 disabled:opacity-50">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                    </svg>
                                    Approve Review
                                </button>
                                <button @onclick="() => RejectRating(rating)"
                                        disabled="@_isBusy"
                                        class="flex items-center gap-2 @(isSuspicious ? "bg-red-600 text-white hover:bg-red-700" : "border border-red-200 text-red-600 hover:bg-red-50") text-xs font-semibold px-4 py-2 rounded-lg cursor-pointer transition-colors active:scale-95 disabled:opacity-50">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                    Reject Review
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Pagination *@
        @if (_ratings.TotalPages > 1)
        {
            <div class="flex items-center justify-between bg-white rounded-xl border border-slate-200 px-5 py-3" style="box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                <p class="text-sm text-muted">Showing @(_ratings.Items.Length) of @_ratings.TotalCount reviews</p>
                <div class="flex items-center gap-1">
                    <button @onclick="PrevPage" disabled="@(!_ratings.HasPreviousPage)"
                            class="w-8 h-8 flex items-center justify-center rounded-lg text-muted hover:bg-slate-100 cursor-pointer transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                        </svg>
                    </button>
                    @for (int p = 1; p <= _ratings.TotalPages; p++)
                    {
                        var pageNum = p;
                        <button @onclick="() => GoToPage(pageNum)"
                                class="w-8 h-8 flex items-center justify-center rounded-lg @(pageNum == _currentPage ? "bg-blue-600 text-white font-semibold" : "text-muted hover:bg-slate-100") cursor-pointer text-sm transition-colors">
                            @pageNum
                        </button>
                    }
                    <button @onclick="NextPage" disabled="@(!_ratings.HasNextPage)"
                            class="w-8 h-8 flex items-center justify-center rounded-lg text-muted hover:bg-slate-100 cursor-pointer transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                    </button>
                </div>
            </div>
        }
    }

</div>
}

@code {
    private int _currentPage = 1;
    private const int PageSize = 10;

    private PagedResult<AdminRatingDto>? _ratings;
    private bool _isLoading = true;
    private bool _hasError = false;
    private bool _isBusy = false;
    private string _actionError = string.Empty;
    private AdminRatingDto? _actionTarget;

    // BFF cookie auth — works the same in SSR, Server-interactive, and WASM.
    protected override async Task OnInitializedAsync()
    {
        await LoadRatingsAsync();
        AdminNav.MarkNavigationDone();
    }

    private async Task LoadRatingsAsync()
    {
        _isLoading = true;
        _hasError = false;
        try
        {
            _ratings = await AdminService.GetRatingsAsync("Pending", _currentPage, PageSize);
        }
        catch
        {
            _hasError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task GoToPage(int page)
    {
        _currentPage = page;
        await LoadRatingsAsync();
    }

    private async Task PrevPage()
    {
        if (_currentPage > 1) { _currentPage--; await LoadRatingsAsync(); }
    }

    private async Task NextPage()
    {
        _currentPage++;
        await LoadRatingsAsync();
    }

    private async Task ApproveRating(AdminRatingDto rating)
    {
        _isBusy = true;
        _actionTarget = rating;
        _actionError = string.Empty;
        try
        {
            await AdminService.ApproveRatingAsync(rating.Id);
            await LoadRatingsAsync();
        }
        catch
        {
            _actionError = "Failed to approve review. Please try again.";
        }
        finally
        {
            _isBusy = false;
            _actionTarget = null;
        }
    }

    private async Task RejectRating(AdminRatingDto rating)
    {
        _isBusy = true;
        _actionTarget = rating;
        _actionError = string.Empty;
        try
        {
            await AdminService.RejectRatingAsync(rating.Id);
            await LoadRatingsAsync();
        }
        catch
        {
            _actionError = "Failed to reject review. Please try again.";
        }
        finally
        {
            _isBusy = false;
            _actionTarget = null;
        }
    }
}
