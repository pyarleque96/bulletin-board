@page "/admin/listings-queue"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using Bulletin.Board.Web.Client.States

@inject IAdminService AdminService
@inject ICategoriesService CategoriesService
@inject AdminNavigationState AdminNav

<PageTitle>Listings Queue — Bulletin Dells Admin</PageTitle>

@if (!_isLoading || !AdminNav.IsNavigating)
{
<div class="flex-1 p-5 space-y-6">

    @* Filters bar *@
    <div class="bg-white rounded-xl border border-slate-200 p-4" style="box-shadow:0 2px 8px rgba(0,0,0,0.06);">
        <div class="flex flex-wrap items-center gap-3">
            <div class="flex items-center gap-2">
                <label class="text-xs font-medium text-muted" for="filter-status">Status</label>
                <select id="filter-status"
                        value="@_filterStatus"
                        @onchange="OnStatusChanged"
                        class="text-xs border border-slate-200 rounded-lg px-3 py-2 text-ink bg-white cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">All statuses</option>
                    <option value="Pending">Pending</option>
                    <option value="Approved">Approved</option>
                    <option value="Rejected">Rejected</option>
                    <option value="NeedsChanges">Needs Changes</option>
                </select>
            </div>
            <div class="flex items-center gap-2">
                <label class="text-xs font-medium text-muted" for="filter-category">Category</label>
                <select id="filter-category"
                        value="@_filterCategoryId"
                        @onchange="OnCategoryChanged"
                        class="text-xs border border-slate-200 rounded-lg px-3 py-2 text-ink bg-white cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">All categories</option>
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id">@cat.NameEn</option>
                    }
                </select>
            </div>
            <div class="flex items-center gap-2">
                <label class="text-xs font-medium text-muted" for="filter-tier">Provider Tier</label>
                <select id="filter-tier"
                        value="@_filterTier"
                        @onchange="OnTierChanged"
                        class="text-xs border border-slate-200 rounded-lg px-3 py-2 text-ink bg-white cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">All tiers</option>
                    <option value="Regular">Regular</option>
                    <option value="Verified">Verified</option>
                    <option value="VIP">VIP</option>
                </select>
            </div>
        </div>
    </div>

    @* Loading skeletons *@
    @if (_isLoading)
    {
        @for (int s = 0; s < 3; s++)
        {
            <div class="bg-white rounded-xl border border-slate-200 p-5 animate-pulse" style="box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                <div class="flex gap-5">
                    <div class="w-28 h-20 bg-slate-200 rounded-lg flex-shrink-0"></div>
                    <div class="flex-1 space-y-3">
                        <div class="h-4 bg-slate-200 rounded w-1/3"></div>
                        <div class="h-4 bg-slate-200 rounded w-2/3"></div>
                        <div class="h-3 bg-slate-100 rounded w-1/2"></div>
                    </div>
                    <div class="flex flex-col gap-2 w-24">
                        <div class="h-8 bg-slate-200 rounded-lg"></div>
                        <div class="h-8 bg-slate-200 rounded-lg"></div>
                        <div class="h-8 bg-slate-200 rounded-lg"></div>
                    </div>
                </div>
            </div>
        }
    }
    else if (_hasError)
    {
        <div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center">
            <p class="text-sm font-semibold text-red-700">Failed to load listings</p>
            <p class="text-xs text-red-600 mt-1">Please try again.</p>
            <button @onclick="() => LoadListingsAsync()" class="mt-3 text-xs text-red-700 border border-red-300 px-4 py-2 rounded-lg cursor-pointer hover:bg-red-100 transition-colors">Retry</button>
        </div>
    }
    else if (_listings is not null && _listings.Items.Length == 0)
    {
        <div class="bg-white rounded-xl border border-slate-200 p-10 text-center" style="box-shadow:0 2px 8px rgba(0,0,0,0.06);">
            <p class="text-sm font-semibold text-ink">No listings found</p>
            <p class="text-xs text-muted mt-1">Try adjusting your filters.</p>
        </div>
    }
    else if (_listings is not null)
    {
        @* Listings list *@
        <div class="space-y-4">
            @foreach (var listing in _listings.Items)
            {
                var hoursWaiting = (DateTimeOffset.UtcNow - listing.CreatedAt).TotalHours;
                var isUrgent = listing.Status == "Pending" && hoursWaiting >= 48;
                var isNeedsChanges = listing.Status == "NeedsChanges";
                var isRejected = listing.Status == "Rejected";

                <div class="bg-white rounded-xl @(isUrgent ? "border-2 border-yellow-300" : isNeedsChanges ? "border border-orange-200" : isRejected ? "border border-red-200" : "border border-slate-200") overflow-hidden @(isRejected ? "opacity-60" : "") @(isNeedsChanges ? "opacity-75" : "")"
                     style="box-shadow:0 2px 8px rgba(0,0,0,0.06);">

                    @* Status banner *@
                    @if (isUrgent)
                    {
                        <div class="bg-yellow-50 px-5 py-2 border-b border-yellow-200 flex items-center gap-2">
                            <svg class="w-3.5 h-3.5 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            <span class="text-xs font-semibold text-yellow-700">Waiting @((int)hoursWaiting) hours — urgent review needed</span>
                        </div>
                    }
                    else if (isNeedsChanges)
                    {
                        <div class="bg-orange-50 px-5 py-2 border-b border-orange-100 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <svg class="w-3.5 h-3.5 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                                <span class="text-xs font-semibold text-orange-700">Needs Changes — awaiting provider update</span>
                            </div>
                        </div>
                    }
                    else if (isRejected)
                    {
                        <div class="bg-red-50 px-5 py-2 border-b border-red-100 flex items-center gap-2">
                            <svg class="w-3.5 h-3.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                            <span class="text-xs font-semibold text-red-700">Rejected — provider notified</span>
                        </div>
                    }

                    <div class="p-5 flex gap-5">
                        <div class="w-28 h-20 rounded-lg object-cover flex-shrink-0 bg-slate-100 flex items-center justify-center @(isRejected ? "grayscale" : "")">
                            <svg class="w-8 h-8 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="text-[10px] font-semibold uppercase tracking-wider text-muted bg-slate-100 px-2 py-0.5 rounded">@listing.CategoryName</span>
                                        <TierBadge Tier="@listing.ProviderTier" />
                                    </div>
                                    <h3 class="text-base font-semibold @(isRejected ? "text-slate-400" : "text-ink")">@listing.TitleEn</h3>
                                    <p class="text-sm text-muted mt-0.5">@listing.TitleEs</p>
                                </div>
                                <div class="text-right flex-shrink-0">
                                    <ListingStatusBadge Status="@listing.Status" />
                                    <p class="text-xs text-muted mt-1.5">Submitted @listing.CreatedAt.ToString("MMM d, yyyy")</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-4 mt-3 text-xs text-muted">
                                <span class="flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                    </svg>
                                    @listing.ProviderName
                                </span>
                                @if (!string.IsNullOrEmpty(listing.ProviderPhone))
                                {
                                    <span class="flex items-center gap-1">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                        </svg>
                                        @listing.ProviderPhone
                                    </span>
                                }
                                <span>@listing.PhotoCount photo@(listing.PhotoCount != 1 ? "s" : "") uploaded</span>
                            </div>
                        </div>
                        <div class="flex flex-col gap-2 flex-shrink-0 justify-center">
                            @if (listing.Status == "Pending")
                            {
                                <button @onclick="() => ApproveListing(listing)"
                                        disabled="@_isBusy"
                                        class="text-xs font-semibold bg-green-600 text-white px-4 py-2 rounded-lg cursor-pointer hover:bg-green-700 transition-colors active:scale-95 disabled:opacity-50">
                                    Approve
                                </button>
                                <button @onclick="() => OpenNeedsChangesModal(listing)"
                                        disabled="@_isBusy"
                                        class="text-xs font-semibold bg-orange-500 text-white px-4 py-2 rounded-lg cursor-pointer hover:bg-orange-600 transition-colors active:scale-95 disabled:opacity-50">
                                    Needs Changes
                                </button>
                                <button @onclick="() => OpenRejectModal(listing)"
                                        disabled="@_isBusy"
                                        class="text-xs font-semibold text-red-600 border border-red-200 px-4 py-2 rounded-lg cursor-pointer hover:bg-red-50 transition-colors active:scale-95 disabled:opacity-50">
                                    Reject
                                </button>
                            }
                            else if (isNeedsChanges)
                            {
                                <span class="text-xs text-center text-orange-700 bg-orange-100 px-4 py-2 rounded-lg font-medium">Needs Changes</span>
                            }
                            else if (isRejected)
                            {
                                <span class="text-xs text-center text-red-700 bg-red-100 px-4 py-2 rounded-lg font-medium">Rejected</span>
                            }
                            else if (listing.Status == "Approved")
                            {
                                <span class="text-xs text-center text-green-700 bg-green-100 px-4 py-2 rounded-lg font-medium">Approved</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Pagination *@
        <div class="flex items-center justify-between bg-white rounded-xl border border-slate-200 px-5 py-3" style="box-shadow:0 2px 8px rgba(0,0,0,0.06);">
            <p class="text-sm text-muted">Showing @(_listings.Items.Length) of @_listings.TotalCount listings</p>
            <div class="flex items-center gap-1">
                <button @onclick="PrevPage"
                        disabled="@(!_listings.HasPreviousPage)"
                        class="w-8 h-8 flex items-center justify-center rounded-lg text-muted hover:bg-slate-100 cursor-pointer transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
                @for (int p = 1; p <= _listings.TotalPages; p++)
                {
                    var pageNum = p;
                    <button @onclick="() => GoToPage(pageNum)"
                            class="w-8 h-8 flex items-center justify-center rounded-lg @(pageNum == _currentPage ? "bg-blue-600 text-white font-semibold" : "text-muted hover:bg-slate-100") cursor-pointer text-sm transition-colors">
                        @pageNum
                    </button>
                }
                <button @onclick="NextPage"
                        disabled="@(!_listings.HasNextPage)"
                        class="w-8 h-8 flex items-center justify-center rounded-lg text-muted hover:bg-slate-100 cursor-pointer transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>
        </div>
    }

</div>
}

@* Reject Modal *@
@if (_showRejectModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4"
         role="dialog" aria-modal="true" aria-labelledby="reject-modal-title">
        <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" @onclick="CloseRejectModal" aria-hidden="true"></div>
        <div class="relative bg-white rounded-2xl p-6 w-full max-w-md mx-4" style="box-shadow:0 8px 32px rgba(0,0,0,0.14);">
            <h3 id="reject-modal-title" class="text-base font-semibold text-ink mb-1">Reject Listing</h3>
            <p class="text-sm text-muted mb-4">Provide a reason for rejection. The provider will be notified via email and WhatsApp.</p>
            <label class="text-xs font-medium text-ink mb-1.5 block" for="reject-note">GM Note (required)</label>
            <textarea id="reject-note"
                      @bind="_rejectNote"
                      rows="3"
                      placeholder="Explain what is missing or why the listing cannot be approved..."
                      class="w-full border border-slate-200 rounded-lg px-3 py-2.5 text-sm text-ink placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-red-400 resize-none"></textarea>
            @if (!string.IsNullOrEmpty(_actionError))
            {
                <p class="text-xs text-red-600 mt-2">@_actionError</p>
            }
            <div class="flex gap-3 mt-4">
                <button @onclick="CloseRejectModal"
                        class="flex-1 border border-slate-200 text-sm font-medium text-ink py-2.5 rounded-lg cursor-pointer hover:bg-slate-50 transition-colors">
                    Cancel
                </button>
                <button @onclick="ConfirmReject"
                        disabled="@(string.IsNullOrWhiteSpace(_rejectNote) || _isBusy)"
                        class="flex-1 bg-red-600 text-white text-sm font-semibold py-2.5 rounded-lg cursor-pointer hover:bg-red-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                    @if (_isBusy) { <span>Rejecting...</span> } else { <span>Confirm Rejection</span> }
                </button>
            </div>
        </div>
    </div>
}

@* Needs Changes Modal *@
@if (_showNeedsChangesModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4"
         role="dialog" aria-modal="true" aria-labelledby="changes-modal-title">
        <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" @onclick="CloseNeedsChangesModal" aria-hidden="true"></div>
        <div class="relative bg-white rounded-2xl p-6 w-full max-w-md mx-4" style="box-shadow:0 8px 32px rgba(0,0,0,0.14);">
            <h3 id="changes-modal-title" class="text-base font-semibold text-ink mb-1">Request Changes</h3>
            <p class="text-sm text-muted mb-4">Describe what the provider needs to fix. They will be notified via email and WhatsApp.</p>
            <label class="text-xs font-medium text-ink mb-1.5 block" for="changes-note">Feedback (required)</label>
            <textarea id="changes-note"
                      @bind="_changesNote"
                      rows="3"
                      placeholder="E.g.: Please add monthly price and utility costs clearly..."
                      class="w-full border border-slate-200 rounded-lg px-3 py-2.5 text-sm text-ink placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-orange-400 resize-none"></textarea>
            @if (!string.IsNullOrEmpty(_actionError))
            {
                <p class="text-xs text-red-600 mt-2">@_actionError</p>
            }
            <div class="flex gap-3 mt-4">
                <button @onclick="CloseNeedsChangesModal"
                        class="flex-1 border border-slate-200 text-sm font-medium text-ink py-2.5 rounded-lg cursor-pointer hover:bg-slate-50 transition-colors">
                    Cancel
                </button>
                <button @onclick="ConfirmNeedsChanges"
                        disabled="@(string.IsNullOrWhiteSpace(_changesNote) || _isBusy)"
                        class="flex-1 bg-orange-500 text-white text-sm font-semibold py-2.5 rounded-lg cursor-pointer hover:bg-orange-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                    @if (_isBusy) { <span>Sending...</span> } else { <span>Send Feedback</span> }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string _filterStatus = "Pending";
    private string _filterTier = "";
    private string _filterCategoryId = "";
    private int _currentPage = 1;
    private const int PageSize = 10;

    private PagedResult<AdminListingDto>? _listings;
    private CategoryDto[] _categories = [];
    private bool _isLoading = true;
    private bool _hasError = false;
    private bool _isBusy = false;
    private string _actionError = string.Empty;

    private AdminListingDto? _actionTarget;
    private bool _showRejectModal = false;
    private bool _showNeedsChangesModal = false;
    private string _rejectNote = string.Empty;
    private string _changesNote = string.Empty;

    // BFF cookie auth — works the same in SSR, Server-interactive, and WASM.
    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadListingsAsync(), LoadCategoriesAsync());
        AdminNav.MarkNavigationDone();
    }

    private async Task LoadCategoriesAsync()
    {
        _categories = await CategoriesService.GetAllAsync();
    }

    private async Task LoadListingsAsync()
    {
        _isLoading = true;
        _hasError = false;
        try
        {
            Guid? catId = Guid.TryParse(_filterCategoryId, out var g) ? g : null;
            _listings = await AdminService.GetListingsAsync(
                string.IsNullOrEmpty(_filterStatus) ? null : _filterStatus,
                string.IsNullOrEmpty(_filterTier) ? null : _filterTier,
                catId,
                _currentPage,
                PageSize);
        }
        catch
        {
            _hasError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        _filterStatus = e.Value?.ToString() ?? "";
        _currentPage = 1;
        await LoadListingsAsync();
    }

    private async Task OnTierChanged(ChangeEventArgs e)
    {
        _filterTier = e.Value?.ToString() ?? "";
        _currentPage = 1;
        await LoadListingsAsync();
    }

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        _filterCategoryId = e.Value?.ToString() ?? "";
        _currentPage = 1;
        await LoadListingsAsync();
    }

    private async Task GoToPage(int page)
    {
        _currentPage = page;
        await LoadListingsAsync();
    }

    private async Task PrevPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            await LoadListingsAsync();
        }
    }

    private async Task NextPage()
    {
        _currentPage++;
        await LoadListingsAsync();
    }

    private async Task ApproveListing(AdminListingDto listing)
    {
        _isBusy = true;
        _actionError = string.Empty;
        try
        {
            await AdminService.ApproveListingAsync(listing.Id);
            await LoadListingsAsync();
        }
        catch
        {
            _actionError = "Failed to approve listing. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OpenRejectModal(AdminListingDto listing)
    {
        _actionTarget = listing;
        _rejectNote = string.Empty;
        _actionError = string.Empty;
        _showRejectModal = true;
    }

    private void CloseRejectModal()
    {
        _showRejectModal = false;
        _actionTarget = null;
        _rejectNote = string.Empty;
        _actionError = string.Empty;
    }

    private async Task ConfirmReject()
    {
        if (_actionTarget is null || string.IsNullOrWhiteSpace(_rejectNote)) return;
        _isBusy = true;
        _actionError = string.Empty;
        try
        {
            await AdminService.RejectListingAsync(_actionTarget.Id, _rejectNote);
            CloseRejectModal();
            await LoadListingsAsync();
        }
        catch
        {
            _actionError = "Failed to reject listing. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OpenNeedsChangesModal(AdminListingDto listing)
    {
        _actionTarget = listing;
        _changesNote = string.Empty;
        _actionError = string.Empty;
        _showNeedsChangesModal = true;
    }

    private void CloseNeedsChangesModal()
    {
        _showNeedsChangesModal = false;
        _actionTarget = null;
        _changesNote = string.Empty;
        _actionError = string.Empty;
    }

    private async Task ConfirmNeedsChanges()
    {
        if (_actionTarget is null || string.IsNullOrWhiteSpace(_changesNote)) return;
        _isBusy = true;
        _actionError = string.Empty;
        try
        {
            await AdminService.RequestChangesAsync(_actionTarget.Id, _changesNote);
            CloseNeedsChangesModal();
            await LoadListingsAsync();
        }
        catch
        {
            _actionError = "Failed to send feedback. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

}
