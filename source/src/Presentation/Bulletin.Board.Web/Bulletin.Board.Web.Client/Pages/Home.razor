@code {
    [Inject] private ICategoriesService CategoriesService { get; set; } = default!;
    [Inject] private IListingsService   ListingsService   { get; set; } = default!;

    private CategoryDto[]?     _categories;
    private string             _searchQuery = string.Empty;
    private TopPick[]          _topPicks    = Array.Empty<TopPick>();

    protected override async Task OnInitializedAsync()
    {
        NavBarState.IsDark = true;
        FooterState.IsDark = true;
        FooterState.IsCompact = false;

        try
        {
            _categories = await CategoriesService.GetAllAsync(includeCount: true);
        }
        catch
        {
            _categories = Array.Empty<CategoryDto>();
        }

        // Top picks for the carousel: top 10 listings by canonical ranking
        // (Hierarchy DESC, Tier DESC, AvgRating DESC, CreatedAt DESC, Id DESC).
        try
        {
            var top = await ListingsService.GetTopAsync(count: 10);
            if (top is not null && top.Count > 0)
            {
                _topPicks = top.Take(5).Select(MapToTopPick).ToArray();
            }
        }
        catch
        {
            _topPicks = Array.Empty<TopPick>();
        }
    }

    private TopPick MapToTopPick(ListingCardDto l)
    {
        var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        var title   = culture == "es" ? l.TitleEs : l.TitleEn;
        var catLabel = PrettifySlug(l.CategorySlug);

        // Cover photo: API URL if set; otherwise fall back to the category hero image
        // already shipped under wwwroot/images/categories/.
        var imageUrl = !string.IsNullOrWhiteSpace(l.CoverPhotoUrl)
            ? l.CoverPhotoUrl!
            : $"/images/categories/{l.CategorySlug}-hero.jpg";

        // Deterministic avatar per listing (pravatar has 70 portraits indexed 1..70).
        var avatarIdx = (Math.Abs(l.Id.GetHashCode()) % 70) + 1;
        var avatarUrl = $"https://i.pravatar.cc/80?img={avatarIdx}";

        var isVip      = string.Equals(l.Tier, "VIP", StringComparison.OrdinalIgnoreCase);
        var isVerified = isVip
                         || string.Equals(l.Tier, "Verified", StringComparison.OrdinalIgnoreCase)
                         || (l.PhoneVerified && l.IdVerified && l.SocialVerified);

        return new TopPick(
            Href:          $"/listing/{l.Id}",
            CategoryLabel: catLabel,
            OwnerName:     l.Location,
            Title:         title,
            Rating:        l.Rating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture),
            ReviewCount:   l.ReviewCount,
            ImageUrl:      imageUrl,
            AvatarUrl:     avatarUrl,
            IsVip:         isVip,
            IsVerified:    isVerified,
            IsGmApproved:  l.ProviderHierarchy > 0);
    }

    private void NavigateToSearch()
    {
        var q = _searchQuery?.Trim();
        if (!string.IsNullOrWhiteSpace(q))
            Navigation.NavigateTo($"/browse?q={Uri.EscapeDataString(q)}");
        else
            Navigation.NavigateTo("/browse");
    }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") NavigateToSearch();
    }

    private string GetCategoryName(CategoryDto cat)
    {
        var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        return culture == "es" ? cat.NameEs : cat.NameEn;
    }

    private static string PrettifySlug(string slug) =>
        string.Join(' ', slug.Split('-').Select(w => w.Length == 0 ? w : char.ToUpper(w[0]) + w[1..]));

    public void Dispose() { }

    /// <summary>Top-picks carousel card (parity with mockup demo data).</summary>
    private sealed record TopPick(
        string Href,
        string CategoryLabel,
        string OwnerName,
        string Title,
        string Rating,
        int    ReviewCount,
        string ImageUrl,
        string AvatarUrl,
        bool   IsVip,
        bool   IsVerified,
        bool   IsGmApproved);
}

