@page "/"

@using Bulletin.Board.Web.Client.Models
@using Bulletin.Board.Web.Client.States

@inject FooterState FooterState
@inject NavBarState NavBarState
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Navigation

@implements IDisposable

<PageTitle>@L["PageTitle_Home"]</PageTitle>

@*
   Dell-landing — Dark OLED Home implementation of:
   design/mockups/v5/landings/v2/landing-05-dark-general-v3.html
   All CSS is scoped under .dell-landing (see app.css).
   The mockup's navbar/footer are INTENTIONALLY omitted — site-wide
   <NavBar /> + <Footer /> are rendered by MainLayout.razor.
*@
<div class="dell-landing">

    @* ── 1 · HERO ─────────────────────────────────────────────────────── *@
    <section class="relative overflow-hidden min-h-[100dvh] flex flex-col items-center justify-center pt-28 pb-20 px-4"
             aria-labelledby="hero-headline">
        <div class="page-ambient" aria-hidden="true"></div>
        <div class="grid-lines" aria-hidden="true"></div>

        <div class="relative z-10 max-w-3xl w-full mx-auto flex flex-col items-center text-center space-y-8">

            @* Eyebrow *@
            <div class="fade-up">
                <span class="eyebrow glass text-white/85">
                    <span class="w-1.5 h-1.5 rounded-full pulse-dot" style="background:#F59E0B;" aria-hidden="true"></span>
                    @L["Hero_Location"]
                </span>
            </div>

            @* Headline *@
            <div class="fade-up space-y-4" style="transition-delay:80ms;">
                <h1 id="hero-headline" class="text-5xl sm:text-6xl md:text-7xl font-black text-white leading-[1.0] tracking-tighter">
                    <span class="block">@L["Hero_HeadlinePart1"]</span>
                    <span class="block">
                        <span class="relative inline-block brand-text">
                            Dells
                            <svg class="absolute -bottom-2 left-0 w-full"
                                 viewBox="0 0 120 10"
                                 preserveAspectRatio="none"
                                 aria-hidden="true"
                                 style="height:6px;">
                                <path d="M2,6 Q30,1 60,6 Q90,11 118,5"
                                      stroke="#F97316" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                            </svg>
                        </span> @L["Hero_HeadlinePart2Suffix"]
                    </span>
                </h1>
                <p class="text-lg md:text-xl text-white/65 leading-relaxed max-w-[58ch] mx-auto">
                    @L["Hero_Subtitle"]
                </p>
            </div>

            @* Search bar (double-bezel) *@
            <div class="fade-up w-full max-w-3xl"
                 style="transition-delay:160ms;"
                 role="search"
                 aria-label="@L["Hero_SearchLabel"]">
                <div class="bezel-outer">
                    <div class="bezel-inner">
                        <div class="flex items-center">
                            <div class="pl-5 pr-2 flex-shrink-0" aria-hidden="true">
                                <svg class="w-5 h-5 text-white/50" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="11" cy="11" r="8"/>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                                </svg>
                            </div>
                            <label for="hero-search" class="sr-only">@L["Hero_SearchLabel"]</label>
                            <input id="hero-search"
                                   type="search"
                                   placeholder="@L["Hero_SearchPlaceholder"]"
                                   class="flex-1 py-4 px-3 text-white placeholder-white/40 bg-transparent border-none outline-none text-base"
                                   autocomplete="off"
                                   @bind="_searchQuery"
                                   @bind:event="oninput"
                                   @onkeydown="OnSearchKeyDown" />
                            <button type="button"
                                    @onclick="NavigateToSearch"
                                    class="btn-primary m-2 inline-flex items-center gap-2.5 text-white text-sm font-bold pl-4 pr-2 py-2.5 rounded-full">
                                @L["Hero_SearchSubmit"]
                                <span class="btn-arrow w-7 h-7 rounded-full bg-black/15 flex items-center justify-center" aria-hidden="true">
                                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="5" y1="12" x2="19" y2="12"/>
                                        <polyline points="12 5 19 12 12 19"/>
                                    </svg>
                                </span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @* Quick category pills (driven by real backend categories) *@
            <div class="fade-up flex flex-wrap items-center justify-center gap-2"
                 style="transition-delay:240ms;"
                 aria-label="Quick category filters"
                 role="group">
                <span class="text-white/40 text-xs self-center">@L["Hero_QuickLabel"]</span>
                @foreach (var cat in (_categories ?? []).Take(5))
                {
                    <a href="/browse?category=@cat.Slug"
                       class="px-3.5 py-1.5 rounded-full glass text-white/85 text-xs font-medium hover:bg-white/15 transition-colors duration-200">
                        @GetCategoryName(cat)
                    </a>
                }
            </div>

            @* Trust signals row *@
            <div class="fade-up flex flex-wrap items-center justify-center gap-x-6 gap-y-3 pt-2"
                 style="transition-delay:320ms;"
                 aria-label="Trust indicators">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-green-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                        <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                    <span class="text-white/70 text-xs">@L["Hero_TrustGmVerified"]</span>
                </div>
                <span class="hidden sm:block w-px h-3 bg-white/20" aria-hidden="true"></span>
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-sky-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                    <span class="text-white/70 text-xs">@L["Hero_TrustProviders"]</span>
                </div>
                <span class="hidden sm:block w-px h-3 bg-white/20" aria-hidden="true"></span>
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-green-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 5.55 5.55l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16.92z"/>
                    </svg>
                    <span class="text-white/70 text-xs">@L["Hero_TrustWhatsApp"]</span>
                </div>
            </div>
        </div>
    </section>

    @* ── 2 · MARQUEE (neutral brand strip) ───────────────────────────── *@
    <section class="py-10 px-0 border-y border-white/5" aria-hidden="true">
        <div class="marquee">
            <div class="marquee-track text-white/30">
                @* Repeat sequence twice for seamless infinite loop *@
                @for (int i = 0; i < 2; i++)
                {
                    <span class="font-serif italic text-2xl">@L["Home_Marquee_Bilingual"]</span><span class="text-white/15">·</span>
                    <span class="font-serif italic text-2xl">@L["Home_Marquee_Trusted"]</span><span class="text-white/15">·</span>
                    <span class="font-serif italic text-2xl">@L["Home_Marquee_Location"]</span><span class="text-white/15">·</span>
                    <span class="font-serif italic text-2xl">@L["Home_Marquee_Established"]</span><span class="text-white/15">·</span>
                }
            </div>
        </div>
    </section>

    @* ── 3 · CATEGORIES — dark bento grid ────────────────────────────── *@
    <section id="categories" class="py-24 px-4" aria-labelledby="cat-heading">
        <div class="max-w-7xl mx-auto">
            <div class="fade-up flex flex-col sm:flex-row items-end justify-between gap-4 mb-10">
                <div>
                    <span class="eyebrow glass text-white/85">@L["Home_Categories_Eyebrow"]</span>
                    <h2 id="cat-heading" class="text-3xl sm:text-5xl font-black text-white tracking-tighter mt-3">
                        @L["Home_Categories_Heading"]
                    </h2>
                    <p class="text-white/45 text-sm italic mt-2">@L["Home_Categories_Sub"]</p>
                </div>
                <a href="/browse" class="text-sm font-bold text-white hover:text-orange-400 transition-colors inline-flex items-center gap-1">
                    @L["Home_Categories_ViewAll"]
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                        <polyline points="12 5 19 12 12 19"/>
                    </svg>
                </a>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 fade-up">
                @{
                    var bento = (_categories ?? []).ToDictionary(c => c.Slug, c => c);
                    CategoryDto? Cat(string slug) => bento.GetValueOrDefault(slug);
                }

                @* Housing — big col-span-2 row-span-2 *@
                @{ var c = Cat("housing"); }
                <a href="/browse?category=housing"
                   class="hover-lift relative col-span-2 md:row-span-2 rounded-3xl overflow-hidden bg-white/5 min-h-[280px] group block">
                    <img src="/images/categories/housing-hero.jpg"
                         alt="@(c is null ? "Housing" : GetCategoryName(c))"
                         loading="lazy"
                         class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-80 group-hover:scale-105 transition-all duration-500"/>
                    <div class="absolute inset-0" style="background: linear-gradient(to top, #050B14 0%, rgba(5,11,20,0.4) 50%, transparent 100%);"></div>
                    <div class="absolute bottom-5 left-5 right-5">
                        <span class="eyebrow glass text-white/85 mb-3">
                            @(c?.ListingCount ?? 0) @L["Home_ListingsSuffix"]
                        </span>
                        <h3 class="text-white text-3xl font-black tracking-tight">@(c is null ? "Housing" : GetCategoryName(c))</h3>
                        <p class="text-white/65 text-sm mt-1">@L["Home_Cat_Housing_Tagline"]</p>
                    </div>
                </a>

                @* Small cards — order as in mockup *@
                @{
                    var smallSlugs = new[] { "car-rental", "airport-rides", "mechanics", "beauty-wellness" };
                }
                @foreach (var slug in smallSlugs)
                {
                    var sc = Cat(slug);
                    var name = sc is null ? PrettifySlug(slug) : GetCategoryName(sc);
                    var count = sc?.ListingCount ?? 0;
                    <a href="/browse?category=@slug"
                       class="hover-lift relative rounded-3xl overflow-hidden bg-white/5 min-h-[135px] group block">
                        <img src="/images/categories/@(slug)-hero.jpg" alt="@name" loading="lazy"
                             class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:opacity-70 transition"/>
                        <div class="absolute inset-0" style="background: linear-gradient(to top, #050B14 0%, transparent 100%);"></div>
                        <div class="absolute bottom-3 left-3">
                            <h3 class="text-white text-lg font-bold">@name</h3>
                            <p class="text-white/55 text-xs">@count</p>
                        </div>
                    </a>
                }

                @* Entertainment — col-span-2 wide card *@
                @{ var ent = Cat("entertainment"); }
                <a href="/browse?category=entertainment"
                   class="hover-lift relative col-span-2 rounded-3xl overflow-hidden bg-white/5 min-h-[135px] group block">
                    <img src="/images/categories/entertainment-hero.jpg" alt="@(ent is null ? "Entertainment" : GetCategoryName(ent))" loading="lazy"
                         class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:opacity-70 transition"/>
                    <div class="absolute inset-0" style="background: linear-gradient(to top, #050B14 0%, rgba(5,11,20,0.4) 50%, transparent 100%);"></div>
                    <div class="absolute bottom-3 left-3">
                        <h3 class="text-white text-xl font-bold">@(ent is null ? "Entertainment" : GetCategoryName(ent))</h3>
                        <p class="text-white/55 text-xs">@(ent?.ListingCount ?? 0) @L["Home_ListingsSuffix"]</p>
                    </div>
                </a>

                @* Last small row — jobs, restaurants *@
                @foreach (var slug in new[] { "jobs", "restaurants" })
                {
                    var sc = Cat(slug);
                    var name = sc is null ? PrettifySlug(slug) : GetCategoryName(sc);
                    var count = sc?.ListingCount ?? 0;
                    <a href="/browse?category=@slug"
                       class="hover-lift relative rounded-3xl overflow-hidden bg-white/5 min-h-[135px] group block">
                        <img src="/images/categories/@(slug)-hero.jpg" alt="@name" loading="lazy"
                             class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:opacity-70 transition"/>
                        <div class="absolute inset-0" style="background: linear-gradient(to top, #050B14 0%, transparent 100%);"></div>
                        <div class="absolute bottom-3 left-3">
                            <h3 class="text-white text-lg font-bold">@name</h3>
                            <p class="text-white/55 text-xs">@count</p>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>

    @* ── 4 · TOP PICKS — Auto-rotating carousel (only if there are listings) ─ *@
    @if (_topPicks.Length > 0)
    {
    <section id="top" class="py-16 relative" aria-labelledby="feat-heading">
        <div class="max-w-7xl mx-auto px-4 relative z-10">
            <div class="fade-up flex items-end justify-between gap-4 mb-6">
                <div>
                    <span class="eyebrow glass text-white/85">@L["Home_TopPicks_Eyebrow"]</span>
                    <h2 id="feat-heading" class="text-2xl sm:text-3xl font-black text-white tracking-tight mt-2">
                        @L["Home_TopPicks_Heading"]
                    </h2>
                </div>
                <a href="/browse" class="text-xs sm:text-sm font-bold text-white/70 hover:text-white transition-colors inline-flex items-center gap-1 pb-1">
                    @L["Home_TopPicks_ViewAll"]
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                        <polyline points="12 5 19 12 12 19"/>
                    </svg>
                </a>
            </div>
        </div>

        <div class="carousel-viewport fade-up" aria-label="@L["Home_TopPicks_CarouselLabel"]">
            <div class="carousel-track">
                @* Render original + duplicate pass (seamless loop) *@
                @for (int pass = 0; pass < 2; pass++)
                {
                    bool isDup = pass == 1;
                    @foreach (var pick in _topPicks)
                    {
                        <a href="@pick.Href"
                           class="@(pick.IsVip ? "vip-card" : "hover-lift") carousel-card group glass rounded-2xl overflow-hidden block relative"
                           aria-hidden="@(isDup ? "true" : null)"
                           tabindex="@(isDup ? "-1" : null)">
                            <div class="relative aspect-[4/5] overflow-hidden">
                                <img src="@pick.ImageUrl" alt="@(isDup ? "" : pick.Title)" loading="lazy"
                                     class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"/>
                                <div class="absolute inset-0" style="background: linear-gradient(to top, #050B14 0%, rgba(5,11,20,0.4) 50%, transparent 100%);"></div>

                                @if (pick.IsVip)
                                {
                                    <span class="absolute top-2 left-2 inline-flex items-center gap-1 px-2 py-1 rounded-md text-white text-[10px] font-black uppercase tracking-wider"
                                          style="background: linear-gradient(135deg,#F59E0B,#F97316); box-shadow: 0 4px 14px rgba(249,115,22,0.55);">
                                        <svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                                        </svg>
                                        VIP
                                    </span>
                                }

                                <div class="absolute top-2 right-2 flex flex-col gap-1 items-end">
                                    @if (pick.IsVerified)
                                    {
                                        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-green-300 bg-green-500/40 border border-green-400/60 backdrop-blur-sm"
                                              title="Verified" aria-label="Verified provider">
                                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <circle cx="12" cy="12" r="10"/>
                                                <path d="m9 12 2 2 4-4"/>
                                            </svg>
                                        </span>
                                    }
                                    @if (pick.IsGmApproved)
                                    {
                                        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-sky-200 bg-sky-500/40 border border-sky-400/60 backdrop-blur-sm"
                                              title="GM Approved" aria-label="GM Approved">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                                <polyline points="9 12 11 14 15 10"/>
                                            </svg>
                                        </span>
                                    }
                                </div>

                                <div class="absolute bottom-2.5 left-2.5 right-2.5 flex items-end gap-2.5">
                                    <div class="w-11 h-11 rounded-full overflow-hidden border-2 border-white/40 flex-shrink-0 shadow-xl"
                                         style="--tw-ring-color: rgba(5,11,20,0.6); box-shadow: 0 0 0 2px rgba(5,11,20,0.6), 0 10px 24px -4px rgba(0,0,0,0.5);">
                                        <img src="@pick.AvatarUrl" alt="@(isDup ? "" : pick.OwnerName)" class="w-full h-full object-cover" loading="lazy"/>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-[9px] font-bold uppercase tracking-wider text-white/55">@pick.CategoryLabel · @pick.OwnerName</p>
                                        <h3 class="font-black text-white text-sm leading-tight truncate">@pick.Title</h3>
                                        <div class="flex items-center gap-1 text-[10px] mt-0.5">
                                            <span class="star text-xs">★</span>
                                            <span class="font-bold text-white">@pick.Rating</span>
                                            <span class="text-white/55">(@pick.ReviewCount)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>
    </section>

    }

    @* ── 5 · TRUST PROMISE — 6 glass cards ───────────────────────────── *@
    <section class="py-24 px-4 relative" aria-labelledby="trust-heading">
        <div class="max-w-6xl mx-auto relative z-10">
            <div class="text-center mb-14 fade-up">
                <span class="eyebrow glass text-white/85">@L["Home_Trust_Eyebrow"]</span>
                <h2 id="trust-heading" class="text-3xl sm:text-5xl font-black text-white tracking-tighter mt-4">
                    @L["Home_Trust_Heading"]
                </h2>
                <p class="text-white/55 italic text-base mt-2">@L["Home_Trust_Sub"]</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 fade-up">
                @* Card 1 — green (GM approves) *@
                <div class="glass rounded-2xl p-6 trust-card">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-3"
                         style="background:rgba(74,222,128,0.15); border:1px solid rgba(74,222,128,0.30);">
                        <svg class="w-5 h-5 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                            <polyline points="22 4 12 14.01 9 11.01"/>
                        </svg>
                    </div>
                    <h3 class="font-bold text-white text-sm mb-1.5">@L["Home_Trust_Card1_Title"]</h3>
                    <p class="text-white/55 text-xs leading-relaxed">@L["Home_Trust_Card1_Desc"]</p>
                </div>

                @* Card 2 — sky blue (Verification = shield = phone + ID + social) *@
                <div class="glass rounded-2xl p-6 trust-card">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-3"
                         style="background:rgba(56,189,248,0.15); border:1px solid rgba(56,189,248,0.30);">
                        <svg class="w-5 h-5 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                    </div>
                    <h3 class="font-bold text-white text-sm mb-1.5">@L["Home_Trust_Card2_Title"]</h3>
                    <p class="text-white/55 text-xs leading-relaxed">@L["Home_Trust_Card2_Desc"]</p>
                </div>

                @* Card 3 — gold *@
                <div class="glass rounded-2xl p-6 trust-card">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-3"
                         style="background:rgba(245,158,11,0.15); border:1px solid rgba(245,158,11,0.25);">
                        <svg class="w-5 h-5" style="color:#F59E0B;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                        </svg>
                    </div>
                    <h3 class="font-bold text-white text-sm mb-1.5">@L["Home_Trust_Card3_Title"]</h3>
                    <p class="text-white/55 text-xs leading-relaxed">@L["Home_Trust_Card3_Desc"]</p>
                </div>

                @* Card 4 — strong green WhatsApp *@
                <div class="glass rounded-2xl p-6 trust-card">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-3"
                         style="background:rgba(34,197,94,0.15); border:1px solid rgba(34,197,94,0.25);">
                        <svg class="w-5 h-5 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                        </svg>
                    </div>
                    <h3 class="font-bold text-white text-sm mb-1.5">@L["Home_Trust_Card4_Title"]</h3>
                    <p class="text-white/55 text-xs leading-relaxed">@L["Home_Trust_Card4_Desc"]</p>
                </div>

                @* Card 5 — violet *@
                <div class="glass rounded-2xl p-6 trust-card">
