@page "/account/listings/{ListingId:guid}/reservations"
@attribute [Authorize]

@using Bulletin.Board.Web.Client.Models
@using Microsoft.AspNetCore.Authorization

@inject IListingsService _listings

<PageTitle>Reservations | Bulletin Dells</PageTitle>

<section class="max-w-5xl mx-auto px-4 pt-24 pb-16">

    <header class="flex items-center justify-between flex-wrap gap-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-ink tracking-tight">Reservation requests</h1>
            <p class="text-muted text-sm mt-1">
                Accepting a request automatically blocks the dates on the vehicle's calendar.
            </p>
        </div>
        <div class="flex items-center gap-1 flex-wrap">
            @foreach (var s in _statuses)
            {
                <button type="button" @onclick="() => SetFilterAsync(s)"
                        class="@($"px-3 py-1.5 rounded-full text-xs font-medium transition-colors {(_filter == s ? "bg-ink text-white" : "bg-slate-100 hover:bg-slate-200 text-ink")}")">
                    @(s ?? "All")
                </button>
            }
        </div>
    </header>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="mb-4 px-4 py-3 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-sm">
            @_errorMessage
        </div>
    }

    @if (_loading)
    {
        <p class="text-muted text-sm">Loading…</p>
    }
    else if (_items is null || _items.Count == 0)
    {
        <div class="bg-white rounded-3xl border border-dashed border-slate-200 p-10 text-center">
            <p class="text-muted text-sm">No reservations match the current filter.</p>
        </div>
    }
    else
    {
        <ul class="space-y-3">
            @foreach (var r in _items)
            {
                <li class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5">
                    <div class="flex items-start justify-between gap-4 flex-wrap">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 class="font-semibold text-ink">@r.RequesterName</h3>
                                <span class="@StatusBadgeClass(r.Status)">@r.Status</span>
                                <span class="text-[11px] text-muted">submitted @r.CreatedAt.LocalDateTime.ToString("MMM d, HH:mm")</span>
                            </div>
                            <p class="text-muted text-xs mt-1">
                                @r.RequesterEmail
                                @if (!string.IsNullOrWhiteSpace(r.RequesterPhone)) { <text> · @r.RequesterPhone</text> }
                            </p>
                            <p class="text-sm text-ink mt-2">
                                <strong>@r.VehicleName</strong>
                                <span class="text-muted">·</span>
                                @r.StartDate.ToString("MMM d") → @r.EndDate.ToString("MMM d, yyyy")
                            </p>
                            @if (!string.IsNullOrWhiteSpace(r.Comment))
                            {
                                <p class="text-muted text-sm mt-2 leading-relaxed">@r.Comment</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(r.ResponseNote))
                            {
                                <p class="text-[11px] text-muted mt-2 italic">Note: @r.ResponseNote</p>
                            }
                        </div>

                        @if (r.Status == "Pending")
                        {
                            <div class="flex items-center gap-1 flex-wrap">
                                <button type="button" @onclick="() => OpenDecision(r, true)" disabled="@_busy"
                                        class="px-3 py-1.5 rounded-xl bg-green-500 hover:bg-green-600 text-white text-xs font-semibold disabled:opacity-50">
                                    Accept
                                </button>
                                <button type="button" @onclick="() => OpenDecision(r, false)" disabled="@_busy"
                                        class="px-3 py-1.5 rounded-xl bg-red-50 hover:bg-red-100 text-red-700 text-xs font-semibold disabled:opacity-50">
                                    Reject
                                </button>
                            </div>
                        }
                        else if (r.Status == "Accepted")
                        {
                            <button type="button" @onclick="() => CancelAsync(r)" disabled="@_busy"
                                    class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-ink text-xs disabled:opacity-50">
                                Cancel
                            </button>
                        }
                    </div>

                    @if (_decision is not null && _decision.Reservation.Id == r.Id)
                    {
                        <div class="mt-4 pt-4 border-t border-slate-100 flex items-center gap-2 flex-wrap">
                            <input @bind="_decision.Note" placeholder="Optional note for the requester"
                                   class="flex-1 min-w-[12rem] rounded-xl border border-slate-200 px-3 py-2 text-sm" />
                            <button type="button" @onclick="ConfirmDecisionAsync" disabled="@_busy"
                                    class="@($"px-3 py-2 rounded-xl text-white text-xs font-semibold disabled:opacity-50 {(_decision.Accept ? "bg-green-500 hover:bg-green-600" : "bg-red-500 hover:bg-red-600")}")">
                                Confirm @(_decision.Accept ? "accept" : "reject")
                            </button>
                            <button type="button" @onclick="() => _decision = null" disabled="@_busy"
                                    class="px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-ink text-xs">
                                Back
                            </button>
                        </div>
                    }
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter] public Guid ListingId { get; set; }

    private readonly string?[] _statuses = [null, "Pending", "Accepted", "Rejected", "Cancelled"];
    private string? _filter;
    private bool _loading = true;
    private bool _busy;
    private string? _errorMessage;
    private IReadOnlyList<ReservationRequestDto>? _items;
    private DecisionState? _decision;

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _errorMessage = null;
        try { _items = await _listings.GetListingReservationsAsync(ListingId, _filter); }
        catch (Exception ex) { _errorMessage = $"Failed to load: {ex.Message}"; }
        finally { _loading = false; }
    }

    private async Task SetFilterAsync(string? status)
    {
        _filter = status;
        await ReloadAsync();
    }

    private void OpenDecision(ReservationRequestDto r, bool accept)
        => _decision = new DecisionState { Reservation = r, Accept = accept };

    private async Task ConfirmDecisionAsync()
    {
        if (_decision is null) return;
        _busy = true;
        _errorMessage = null;
        try
        {
            var ok = _decision.Accept
                ? await _listings.AcceptReservationAsync(_decision.Reservation.Id, _decision.Note)
                : await _listings.RejectReservationAsync(_decision.Reservation.Id, _decision.Note);

            if (!ok)
                _errorMessage = "Action failed. The dates may now conflict with another reservation.";

            _decision = null;
            await ReloadAsync();
        }
        catch (Exception ex) { _errorMessage = ex.Message; }
        finally { _busy = false; }
    }

    private async Task CancelAsync(ReservationRequestDto r)
    {
        _busy = true;
        _errorMessage = null;
        try
        {
            await _listings.CancelReservationAsync(r.Id, note: null);
            await ReloadAsync();
        }
        catch (Exception ex) { _errorMessage = $"Cancel failed: {ex.Message}"; }
        finally { _busy = false; }
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Pending"   => "text-[10px] uppercase tracking-wider bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full",
        "Accepted"  => "text-[10px] uppercase tracking-wider bg-green-100 text-green-700 px-2 py-0.5 rounded-full",
        "Rejected"  => "text-[10px] uppercase tracking-wider bg-red-100 text-red-700 px-2 py-0.5 rounded-full",
        "Cancelled" => "text-[10px] uppercase tracking-wider bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full",
        _           => "text-[10px] uppercase tracking-wider bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full"
    };

    private sealed class DecisionState
    {
        public ReservationRequestDto Reservation { get; set; } = default!;
        public bool Accept { get; set; }
        public string? Note { get; set; }
    }
}
