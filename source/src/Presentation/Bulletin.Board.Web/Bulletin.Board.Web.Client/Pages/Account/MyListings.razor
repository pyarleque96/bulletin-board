@page "/account/listings"
@attribute [Authorize]

@using Bulletin.Board.Web.Client.Models
@using Microsoft.AspNetCore.Authorization

@inject IListingsService _listings

<PageTitle>My listings | Bulletin Dells</PageTitle>

<section class="max-w-5xl mx-auto px-4 pt-24 pb-16">

    <header class="mb-6">
        <h1 class="text-2xl font-bold text-ink tracking-tight">My listings</h1>
        <p class="text-muted text-sm mt-1">
            Listings you publish on Bulletin Dells. Click one to manage its vehicles or reservations.
        </p>
    </header>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="mb-4 px-4 py-3 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-sm">
            @_errorMessage
        </div>
    }

    @if (_loading)
    {
        <p class="text-muted text-sm">Loading…</p>
    }
    else if (_items is null || _items.Count == 0)
    {
        <div class="bg-white rounded-3xl border border-dashed border-slate-200 p-10 text-center">
            <p class="text-muted text-sm">You don't have any listings yet.</p>
        </div>
    }
    else
    {
        <ul class="space-y-3">
            @foreach (var l in _items)
            {
                <li class="bg-white rounded-3xl border border-slate-100 shadow-soft p-5">
                    <div class="flex items-start justify-between gap-4 flex-wrap">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 class="font-semibold text-ink">@l.TitleEn</h3>
                                <span class="@StatusBadgeClass(l.Status)">@l.Status</span>
                                @if (l.Tier == "VIP")
                                {
                                    <span class="text-[10px] uppercase tracking-wider bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full">VIP</span>
                                }
                                @if (l.Status == "Pending" && l.HasPublishedSnapshot)
                                {
                                    <span class="text-[10px] uppercase tracking-wider bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full"
                                          title="Pending edits awaiting GM review; previously approved version still public">
                                        public ↻
                                    </span>
                                }
                            </div>
                            <p class="text-muted text-xs mt-0.5">
                                Category: @l.CategorySlug · Updated @l.UpdatedAt.LocalDateTime.ToString("MMM d, HH:mm")
                            </p>
                        </div>
                        <div class="flex items-center gap-1 flex-wrap">
                            <a href="/listing/detail/@l.Slug"
                               class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-ink text-xs font-medium">
                                Public view
                            </a>
                            @if (l.CategorySlug == "car-rental")
                            {
                                <a href="/account/listings/@l.Id/vehicles"
                                   class="px-3 py-1.5 rounded-xl bg-brand-500 hover:bg-brand-600 text-white text-xs font-medium">
                                    Manage vehicles
                                </a>
                                <a href="/account/listings/@l.Id/reservations"
                                   class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-ink text-xs font-medium">
                                    Reservations
                                </a>
                            }
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
</section>

@code {
    private bool _loading = true;
    private string? _errorMessage;
    private IReadOnlyList<MyListingDto>? _items;

    protected override async Task OnInitializedAsync()
    {
        try { _items = await _listings.GetMyListingsAsync(); }
        catch (Exception ex) { _errorMessage = $"Failed to load: {ex.Message}"; }
        finally { _loading = false; }
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Approved"     => "text-[10px] uppercase tracking-wider bg-green-100 text-green-700 px-2 py-0.5 rounded-full",
        "Pending"      => "text-[10px] uppercase tracking-wider bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full",
        "Rejected"     => "text-[10px] uppercase tracking-wider bg-red-100 text-red-700 px-2 py-0.5 rounded-full",
        "NeedsChanges" => "text-[10px] uppercase tracking-wider bg-orange-100 text-orange-800 px-2 py-0.5 rounded-full",
        _              => "text-[10px] uppercase tracking-wider bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full"
    };
}
