@namespace Bulletin.Board.Web.Client.Shared

@*
    PasswordStrengthIndicator — 4 barras de color que reflejan la fortaleza de la contraseña.
    Las clases .strength-bar, .weak, .fair, .good, .strong están definidas en AuthLayout.razor.
    Score: 0 = sin valor, 1 = débil, 2 = regular, 3 = buena, 4 = fuerte.
*@

<div class="flex gap-1.5 @CssClass" aria-label="Password strength">
    <div class="strength-bar @BarClass(1)"></div>
    <div class="strength-bar @BarClass(2)"></div>
    <div class="strength-bar @BarClass(3)"></div>
    <div class="strength-bar @BarClass(4)"></div>
</div>
<p class="mt-0.5 @LabelClass" style="font-size:0.625rem; line-height:1rem;">@Label</p>

@code {
    /// <summary>Puntuación de fortaleza: 0-4.</summary>
    [Parameter] public int Score { get; set; }

    /// <summary>Texto descriptivo de la fortaleza ("Weak", "Fair", "Good", "Strong").</summary>
    [Parameter] public string Label { get; set; } = "";

    /// <summary>Clase de color para el texto del label. Por defecto atenuado.</summary>
    [Parameter] public string LabelClass { get; set; } = "text-white/20";

    /// <summary>Clases CSS extra para el contenedor de barras.</summary>
    [Parameter] public string CssClass { get; set; } = "";

    private string BarClass(int bar) =>
        Score < bar ? "" : Score switch { 1 => "weak", 2 => "fair", 3 => "good", _ => "strong" };
}
