@* TASK-33: LoadingSkeleton — shimmer placeholder para cards (variante Card / Row) *@

@for (int i = 0; i < Count; i++)
{
    @if (Variant == SkeletonVariant.Card)
    {
        <div class="rounded-2xl overflow-hidden bg-white border border-gray-100 shadow-sm" aria-busy="true" aria-label="Loading...">
            <div class="skeleton h-40 w-full"></div>
            <div class="p-4 space-y-3">
                <div class="skeleton h-4 w-3/4 rounded-full"></div>
                <div class="skeleton h-3 w-1/2 rounded-full"></div>
                <div class="skeleton h-3 w-5/6 rounded-full"></div>
            </div>
        </div>
    }
    else
    {
        <div class="flex items-center gap-4 p-4 bg-white rounded-2xl border border-gray-100 shadow-sm" aria-busy="true" aria-label="Loading...">
            <div class="skeleton h-20 w-20 rounded-xl flex-shrink-0"></div>
            <div class="flex-1 space-y-2.5">
                <div class="skeleton h-4 w-2/3 rounded-full"></div>
                <div class="skeleton h-3 w-1/3 rounded-full"></div>
                <div class="skeleton h-3 w-1/2 rounded-full"></div>
            </div>
        </div>
    }
}

@code {
    public enum SkeletonVariant { Card, Row }

    [Parameter] public SkeletonVariant Variant { get; set; } = SkeletonVariant.Card;
    [Parameter] public int             Count   { get; set; } = 1;
}

