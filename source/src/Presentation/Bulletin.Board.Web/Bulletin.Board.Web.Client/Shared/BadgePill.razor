@* TASK-31: BadgePill — tier (VIP, Verified, Regular) y status (Pending, Approved, Rejected, NeedsChanges) *@

@inject IStringLocalizer<SharedResource> _localizer

<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold leading-tight @GetClasses()"
      role="img" aria-label="@GetAriaLabel()">
    @if (!string.IsNullOrEmpty(GetIcon()))
    {
        <span aria-hidden="true">@GetIcon()</span>
    }
    @GetLabel()
    @if (ShowVerificationWarning)
    {
        <span class="w-1.5 h-1.5 rounded-full bg-orange-400 flex-shrink-0" aria-hidden="true" title="Verification pending"></span>
    }
</span>

@code {
    [Parameter] public string Tier   { get; set; } = "";
    [Parameter] public string Status { get; set; } = "";
    [Parameter] public bool   ShowVerificationWarning { get; set; } = false;

    private string GetClasses() => (Tier.ToUpperInvariant(), Status.ToUpperInvariant()) switch
    {
        ("VIP", _)                    => "bg-amber-500 text-white",
        ("VERIFIED", _)               => "bg-emerald-500 text-white",
        (_, "APPROVED")               => "bg-emerald-100 text-emerald-800",
        (_, "PENDING")                => "bg-gray-200 text-gray-700",
        (_, "NEEDSCHANGES")           => "bg-yellow-100 text-yellow-800",
        (_, "REJECTED")               => "bg-red-100 text-red-700",
        _                             => "bg-gray-100 text-gray-600"
    };

    private string GetIcon() => (Tier.ToUpperInvariant(), Status.ToUpperInvariant()) switch
    {
        ("VIP", _)                    => "⭐",
        ("VERIFIED", _)               => "✓",
        (_, "APPROVED")               => "✓",
        (_, "PENDING")                => "",
        (_, "NEEDSCHANGES")           => "⚠",
        (_, "REJECTED")               => "✕",
        _                             => ""
    };

    private string GetLabel()
    {
        if (!string.IsNullOrEmpty(Tier))
        {
            return Tier.ToUpperInvariant() switch
            {
                "VIP"      => _localizer["Badge_VIP"],
                "VERIFIED" => _localizer["Badge_Verified"],
                "REGULAR"  => _localizer["Badge_Regular"],
                _          => Tier
            };
        }

        return Status.ToUpperInvariant() switch
        {
            "APPROVED"     => _localizer["Badge_Approved"],
            "PENDING"      => _localizer["Badge_Pending"],
            "NEEDSCHANGES" => _localizer["Badge_NeedsChanges"],
            "REJECTED"     => _localizer["Badge_Rejected"],
            _              => Status
        };
    }

    private string GetAriaLabel() => $"Status: {GetLabel()}";
}
