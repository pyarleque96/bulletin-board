@* TASK-34: EmptyState — ícono configurable + título + subtítulo + slot CTA *@

<div class="flex flex-col items-center justify-center text-center py-16 px-4">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <div class="text-5xl mb-5 select-none" aria-hidden="true">@Icon</div>
    }
    <h2 class="text-lg font-semibold text-gray-800 mb-2">@Title</h2>
    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <p class="text-sm text-gray-500 max-w-sm leading-relaxed mb-6">@Subtitle</p>
    }
    @if (ActionButton is not null)
    {
        <div class="mt-2">
            @ActionButton
        </div>
    }
</div>

@code {
    [Parameter] public string          Icon         { get; set; } = "🔍";
    [Parameter] public string          Title        { get; set; } = "No results found";
    [Parameter] public string          Subtitle     { get; set; } = "";
    [Parameter] public RenderFragment? ActionButton { get; set; }
}
